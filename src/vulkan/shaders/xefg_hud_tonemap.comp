#elif TM_PASS == 6
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main() {
    uvec2 p = gl_GlobalInvocationID.xy * STRIDE;
    if (p.x >= width || p.y >= height) return;

    vec3 x = safeSaturateRgb(texelFetch(hudlessTex, ivec2(p), 0).rgb);
    vec3 y = safeSaturateRgb(texelFetch(backBufferTex, ivec2(p), 0).rgb);
    uint cx = min(p.x / cell, cellsX - 1u);
    uint cy = min(p.y / cell, cellsY - 1u);
    uint cellIdx = cy * cellsX + cx;

    float z = clamp(luma709(x), 0.0, 1.0) * float(bins - 1u);
    uint b0 = min(uint(floor(z)), bins - 1u);
    uint b1 = min(b0 + 1u, bins - 1u);
    float fz = clamp(z - float(b0), 0.0, 1.0);

    if (b0 == b1) {
        accumBin(cellIdx, b0, 1.0, x, y);
    } else {
        accumBin(cellIdx, b0, 1.0 - fz, x, y);
        accumBin(cellIdx, b1, fz, x, y);
    }
}

#elif TM_PASS == 7
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
void main() {
    uint totalCells = cellsX * cellsY * bins;
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= totalCells) return;

    uint b = gid % bins;
    uint xy = gid / bins;
    int cx = int(xy % cellsX);
    int cy = int(xy / cellsX);

    float s[22];
    for (uint k = 0u; k < 22u; ++k) s[k] = 0.0;

    for (int dy = -1; dy <= 1; ++dy) {
        int ny = cy + dy;
        if (ny < 0 || ny >= int(cellsY)) continue;
        for (int dx = -1; dx <= 1; ++dx) {
            int nx = cx + dx;
            if (nx < 0 || nx >= int(cellsX)) continue;
            float w = float((2 - abs(dx)) * (2 - abs(dy)));
            uint nBase = ((uint(ny) * cellsX + uint(nx)) * bins + b) * 22u;
            for (uint m = 0u; m < 22u; ++m) {
                s[m] += w * (float(hist[nBase + m]) * B_INV_SCALE);
            }
        }
    }

    vec4 row0 = vec4(1.0, 0.0, 0.0, 0.0);
    vec4 row1 = vec4(0.0, 1.0, 0.0, 0.0);
    vec4 row2 = vec4(0.0, 0.0, 1.0, 0.0);

    float n = s[0];
    if (n >= 8.0) {
        float invN = 1.0 / n;
        vec3 mx = vec3(s[1], s[2], s[3]) * invN;
        vec3 my = vec3(s[19], s[20], s[21]) * invN;

        // Explicit row vectors (row-major, matching HLSL float3x3 bit-for-bit)
        vec3 cxx0 = vec3(s[4], s[5], s[6]) * invN - mx.x * mx + vec3(lambda, 0.0, 0.0);
        vec3 cxx1 = vec3(s[5], s[7], s[8]) * invN - mx.y * mx + vec3(0.0, lambda, 0.0);
        vec3 cxx2 = vec3(s[6], s[8], s[9]) * invN - mx.z * mx + vec3(0.0, 0.0, lambda);

        vec3 cxy0 = vec3(s[10], s[11], s[12]) * invN - mx.x * my + vec3(lambda, 0.0, 0.0);
        vec3 cxy1 = vec3(s[13], s[14], s[15]) * invN - mx.y * my + vec3(0.0, lambda, 0.0);
        vec3 cxy2 = vec3(s[16], s[17], s[18]) * invN - mx.z * my + vec3(0.0, 0.0, lambda);

        vec3 k0 = cross(cxx1, cxx2);
        vec3 k1 = cross(cxx2, cxx0);
        vec3 k2 = cross(cxx0, cxx1);
        float det = dot(cxx0, k0);
        if (isFiniteFloat(det) && abs(det) > 1e-9) {
            float invDet = 1.0 / det;
            vec3 inv0 = vec3(k0.x, k1.x, k2.x) * invDet;
            vec3 inv1 = vec3(k0.y, k1.y, k2.y) * invDet;
            vec3 inv2 = vec3(k0.z, k1.z, k2.z) * invDet;

            vec3 colY0 = vec3(cxy0.x, cxy1.x, cxy2.x);
            vec3 colY1 = vec3(cxy0.y, cxy1.y, cxy2.y);
            vec3 colY2 = vec3(cxy0.z, cxy1.z, cxy2.z);

            vec3 w0 = vec3(dot(inv0, colY0), dot(inv1, colY0), dot(inv2, colY0));
            vec3 w1 = vec3(dot(inv0, colY1), dot(inv1, colY1), dot(inv2, colY1));
            vec3 w2 = vec3(dot(inv0, colY2), dot(inv1, colY2), dot(inv2, colY2));

            vec4 cand0 = vec4(w0, my.x - dot(mx, w0));
            vec4 cand1 = vec4(w1, my.y - dot(mx, w1));
            vec4 cand2 = vec4(w2, my.z - dot(mx, w2));

            bool ok = isFiniteFloat(cand0.x) && isFiniteFloat(cand0.y) && isFiniteFloat(cand0.z) && isFiniteFloat(cand0.w)
                   && isFiniteFloat(cand1.x) && isFiniteFloat(cand1.y) && isFiniteFloat(cand1.z) && isFiniteFloat(cand1.w)
                   && isFiniteFloat(cand2.x) && isFiniteFloat(cand2.y) && isFiniteFloat(cand2.z) && isFiniteFloat(cand2.w);
            if (ok) {
                row0 = cand0;
                row1 = cand1;
                row2 = cand2;
            }
        }
    }

    uint mBase = gid * 12u;
    lut[mBase + 0u] = row0.x; lut[mBase + 1u] = row0.y; lut[mBase + 2u] = row0.z; lut[mBase + 3u] = row0.w;
    lut[mBase + 4u] = row1.x; lut[mBase + 5u] = row1.y; lut[mBase + 6u] = row1.z; lut[mBase + 7u] = row1.w;
    lut[mBase + 8u] = row2.x; lut[mBase + 9u] = row2.y; lut[mBase + 10u] = row2.z; lut[mBase + 11u] = row2.w;
}

#elif TM_PASS == 8
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= width || id.y >= height) return;

    vec3 h = safeSaturateRgb(texelFetch(hudlessTex, ivec2(id), 0).rgb);

    float gx = (float(id.x) + 0.5) / float(cell) - 0.5;
    float gy = (float(id.y) + 0.5) / float(cell) - 0.5;
    float gz = clamp(luma709(h), 0.0, 1.0) * float(bins - 1u);

    int x0 = clamp(int(floor(gx)), 0, int(cellsX) - 1);
    int y0 = clamp(int(floor(gy)), 0, int(cellsY) - 1);
    int x1 = min(x0 + 1, int(cellsX) - 1);
    int y1 = min(y0 + 1, int(cellsY) - 1);
    uint z0 = min(uint(floor(gz)), bins - 1u);
    uint z1 = min(z0 + 1u, bins - 1u);

    float fx = clamp(gx - floor(gx), 0.0, 1.0);
    float fy = clamp(gy - floor(gy), 0.0, 1.0);
    float fz = clamp(gz - float(z0), 0.0, 1.0);

    vec4 m0 = vec4(0.0);
    vec4 m1 = vec4(0.0);
    vec4 m2 = vec4(0.0);

    for (uint corner = 0u; corner < 8u; ++corner) {
        bool bx = (corner & 1u) != 0u;
        bool by = (corner & 2u) != 0u;
        bool bz = (corner & 4u) != 0u;
        float w = (bx ? fx : (1.0 - fx)) * (by ? fy : (1.0 - fy)) * (bz ? fz : (1.0 - fz));
        uint cx = uint(bx ? x1 : x0);
        uint cy = uint(by ? y1 : y0);
        uint cz = bz ? z1 : z0;
        uint mBase = ((cy * cellsX + cx) * bins + cz) * 12u;
        m0 += w * vec4(lut[mBase + 0u], lut[mBase + 1u], lut[mBase + 2u], lut[mBase + 3u]);
        m1 += w * vec4(lut[mBase + 4u], lut[mBase + 5u], lut[mBase + 6u], lut[mBase + 7u]);
        m2 += w * vec4(lut[mBase + 8u], lut[mBase + 9u], lut[mBase + 10u], lut[mBase + 11u]);
    }

    vec3 o = vec3(
        dot(m0.xyz, h) + m0.w,
        dot(m1.xyz, h) + m1.w,
        dot(m2.xyz, h) + m2.w);
    imageStore(outColor, ivec2(id), vec4(safeSaturateRgb(o), 1.0));
}
#endif
