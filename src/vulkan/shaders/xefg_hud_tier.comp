#version 450
// 3-Tier Adaptive HUD Protection compute shaders for native Vulkan (VulkanRuntime.cpp).
// Uses explicit storage-image format qualifiers (COLOR_FMT = rgba8 or rgb10_a2, r8ui for StaticCount)
// so it requires only shaderStorageImageExtendedFormats (no StorageImageRead/WriteWithoutFormat needed).
// Compiled by tools/GenerateXeFgCoopMat.py into coopmat/hud/*.spv.
//
// Modes (compile-time -DHUD_MODE=...):
//   0 = Tier 1 Guard (1/16 sampled |Real - Hudless| > Tolerance counter)
//   1 = Tier 2 Diff Composite (3x3 dilated |Real - Hudless| > Tolerance -> OutColor + optional 1/16 counter)
//   2 = Tier 3 Static HUD Update (compare CurrReal vs PrevReal -> update r8ui StaticCount + 1/16 counter)
//   3 = Tier 3 Static HUD Composite (copy CurrReal where StaticCount >= 4 -> OutColor)
//   4 = Tier 3 Hybrid Fused Composite (3x3 dilated |Real - Hudless| > Tolerance OR StaticCount >= 4 -> OutColor in 1 pass)

#ifndef HUD_MODE
#define HUD_MODE 0
#endif

#ifndef COLOR_FMT
#define COLOR_FMT rgba8
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint Width;
    uint Height;
    float Tolerance;
    uint Flags;
};

layout(set = 0, binding = 0, COLOR_FMT) uniform readonly image2D TexA;

#if HUD_MODE == 3
layout(set = 0, binding = 1, r8ui) uniform readonly uimage2D StaticCountIn;
#else
layout(set = 0, binding = 1, COLOR_FMT) uniform readonly image2D TexB;
#endif

#if HUD_MODE == 2
layout(set = 0, binding = 2, r8ui) uniform uimage2D StaticCountOut;
#else
layout(set = 0, binding = 2, COLOR_FMT) uniform writeonly image2D OutColor;
#endif

layout(set = 0, binding = 3, std430) buffer CounterBuf {
    uint Counts[4]; // [0] = diffCount (1/16 sample), [1] = staticCount (1/16 sample)
};

#if HUD_MODE == 4
layout(set = 0, binding = 4, r8ui) uniform readonly uimage2D StaticCountHybrid;
#endif

#if HUD_MODE == 0
void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= Width || id.y >= Height) return;
    if ((id.x & 3u) != 0u || (id.y & 3u) != 0u) return;

    ivec2 p = ivec2(id);
    vec3 d = abs(imageLoad(TexA, p).rgb - imageLoad(TexB, p).rgb);
    if (max(d.r, max(d.g, d.b)) > Tolerance) {
        atomicAdd(Counts[0], 1u);
    }
}
#elif HUD_MODE == 1
// 10x10 shared tile for 8x8 workgroup + 1-pixel halo (200 vs 1152 texture loads per workgroup = 5.76x fewer VRAM reads)
shared uint sDiff[100];

bool isHudDiff(ivec2 p) {
    vec3 d = abs(imageLoad(TexA, p).rgb - imageLoad(TexB, p).rgb);
    return max(d.r, max(d.g, d.b)) > Tolerance;
}

void main() {
    ivec2 maxCoord = ivec2(int(Width) - 1, int(Height) - 1);
    ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy * 8u) - ivec2(1, 1);

    // Cooperative halo load (all 64 threads participate before barrier for uniform control flow)
    for (uint idx = gl_LocalInvocationIndex; idx < 100u; idx += 64u) {
        int tx = int(idx % 10u);
        int ty = int(idx / 10u);
        ivec2 q = clamp(tileOrigin + ivec2(tx, ty), ivec2(0), maxCoord);
        sDiff[idx] = isHudDiff(q) ? 1u : 0u;
    }
    memoryBarrierShared();
    barrier();

    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= Width || id.y >= Height) return;

    uint base = gl_LocalInvocationID.y * 10u + gl_LocalInvocationID.x;
    uint mask = sDiff[base + 0u]  | sDiff[base + 1u]  | sDiff[base + 2u]
              | sDiff[base + 10u] | sDiff[base + 11u] | sDiff[base + 12u]
              | sDiff[base + 20u] | sDiff[base + 21u] | sDiff[base + 22u];
    bool hud = (mask != 0u);

    if ((Flags & 1u) != 0u && hud && (id.x & 3u) == 0u && (id.y & 3u) == 0u) {
        atomicAdd(Counts[0], 1u);
    }

    if (hud) {
        ivec2 p = ivec2(id);
        if ((Flags & 2u) != 0u)
            imageStore(OutColor, p, vec4(1.0, 0.0, 1.0, 1.0));
        else
            imageStore(OutColor, p, imageLoad(TexA, p));
    }
}
#elif HUD_MODE == 2
void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= Width || id.y >= Height) return;

    ivec2 p = ivec2(id);
    uint count = 0u;
    if ((Flags & 1u) == 0u) {
        vec3 d = abs(imageLoad(TexA, p).rgb - imageLoad(TexB, p).rgb);
        bool unchanged = max(d.r, max(d.g, d.b)) <= Tolerance;
        uint prev = imageLoad(StaticCountOut, p).r;
        count = unchanged ? min(prev + 1u, 8u) : 0u;
    }

    imageStore(StaticCountOut, p, uvec4(count, 0u, 0u, 0u));

    if (count >= 4u && (id.x & 3u) == 0u && (id.y & 3u) == 0u) {
        atomicAdd(Counts[1], 1u);
    }
}
#elif HUD_MODE == 3
void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= Width || id.y >= Height) return;

    ivec2 p = ivec2(id);
    if (imageLoad(StaticCountIn, p).r >= 4u) {
        if ((Flags & 2u) != 0u)
            imageStore(OutColor, p, vec4(1.0, 0.0, 1.0, 1.0));
        else
            imageStore(OutColor, p, imageLoad(TexA, p));
    }
}
#elif HUD_MODE == 4
// 10x10 shared tile for 8x8 workgroup + 1-pixel halo (5.76x fewer TexA/TexB VRAM reads)
shared uint sDiffHybrid[100];

bool isHudDiffHybrid(ivec2 p) {
    vec3 d = abs(imageLoad(TexA, p).rgb - imageLoad(TexB, p).rgb);
    return max(d.r, max(d.g, d.b)) > Tolerance;
}

void main() {
    ivec2 maxCoord = ivec2(int(Width) - 1, int(Height) - 1);
    ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy * 8u) - ivec2(1, 1);

    for (uint idx = gl_LocalInvocationIndex; idx < 100u; idx += 64u) {
        int tx = int(idx % 10u);
        int ty = int(idx / 10u);
        ivec2 q = clamp(tileOrigin + ivec2(tx, ty), ivec2(0), maxCoord);
        sDiffHybrid[idx] = isHudDiffHybrid(q) ? 1u : 0u;
    }
    memoryBarrierShared();
    barrier();

    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= Width || id.y >= Height) return;

    uint base = gl_LocalInvocationID.y * 10u + gl_LocalInvocationID.x;
    uint mask = sDiffHybrid[base + 0u]  | sDiffHybrid[base + 1u]  | sDiffHybrid[base + 2u]
              | sDiffHybrid[base + 10u] | sDiffHybrid[base + 11u] | sDiffHybrid[base + 12u]
              | sDiffHybrid[base + 20u] | sDiffHybrid[base + 21u] | sDiffHybrid[base + 22u];
    bool hudDiff = (mask != 0u);

    if ((Flags & 1u) != 0u && hudDiff && (id.x & 3u) == 0u && (id.y & 3u) == 0u) {
        atomicAdd(Counts[0], 1u);
    }

    ivec2 p = ivec2(id);
    bool isStatic = imageLoad(StaticCountHybrid, p).r >= 4u;
    if (hudDiff || isStatic) {
        if ((Flags & 2u) != 0u)
            imageStore(OutColor, p, vec4(1.0, 0.0, 1.0, 1.0));
        else
            imageStore(OutColor, p, imageLoad(TexA, p));
    }
}
#endif
