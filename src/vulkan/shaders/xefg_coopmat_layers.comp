layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(local_size_x_id = 4) in;

// Descriptor bindings matching third_party/xefg_mfg_programs/vulkan/programs.tsv and xvk_coopmat.cpp:
//   binding 0  : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE (utexture2DArray t0)
//   binding 1  : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER (uWeights t1)
//   binding 2  : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER (uScale t2: float scale for Pool/Decoder, int32 bias for Flow)
//   binding 3  : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER (uBias t3: float bias for Pool/Decoder, int32 negMul for Flow)
//   binding 4  : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE (utexture2DArray t4, Decoder LAYER_FAMILY == 1 only)
//   binding 64 : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE (uimage2DArray u0: rg32ui for 8-ch Flow, rgba32ui otherwise)
layout(set = 0, binding = 0) uniform utexture2DArray uInput;
layout(set = 0, binding = 1, std430) readonly buffer WeightBuf { uvec4 data[]; } uWeights;
layout(set = 0, binding = 2, std430) readonly buffer ScaleBuf  { uvec4 data[]; } uScale;
layout(set = 0, binding = 3, std430) readonly buffer BiasBuf   { uvec4 data[]; } uBias;
#if LAYER_FAMILY == 1
layout(set = 0, binding = 4) uniform utexture2DArray uSkip;
#endif
#if LAYER_FAMILY == 2 && LAYER_OUT == 8
layout(set = 0, binding = 64, rg32ui) uniform writeonly uimage2DArray uDst;
#else
layout(set = 0, binding = 64, rgba32ui) uniform writeonly uimage2DArray uDst;
#endif

#if LAYER_FAMILY == 2
layout(push_constant) uniform PushConstants
{
	uvec4 words[3];
} pc;
#else
layout(push_constant) uniform PushConstants
{
	uvec4 words[1];
} pc;
#endif

const int WIN_W = 18;
#if LAYER_FAMILY == 0 && LAYER_POOL != 0
const int PY = 2;
#else
const int PY = 1;
#endif
const int CONV_H = LAYER_TILE_H * PY;
const int WIN_H  = CONV_H + 2;
const int WIN    = WIN_W * WIN_H;
const int ROWS   = LAYER_TILE_H / 4;

// 16-byte-aligned padded accumulator row stride (20 ints = 80 B) cuts 8-way LDS bank conflicts on non-RADV_REG_ONLY paths.
const uint SACC_STRIDE = 20u;
const uint SACC_TILE   = 16u * SACC_STRIDE; // 320 ints per 16x16 accumulator tile

#if LAYER_FAMILY == 2
// Flow stages one 16-channel input step at a time and 2 x (9 taps x 16x16 col-major) weight tiles (NT = 4 tiles of 8 ch = 32 ch)
shared uint winWords[WIN * 4];
shared uint wsmWords[2 * 9 * 80];
#if RADV_REG_ONLY == 0
shared int  sAcc[4 * int(SACC_TILE)]; // Phased half-emission with padded stride
#endif
#else
const int ZPER = LAYER_OUT / LAYER_ZSPLIT;
#if (LAYER_OUT / LAYER_ZSPLIT) == 1 && LAYER_IN > 1
#define STREAM_SLICE 1
shared uint winWords[WIN * 4];
shared uint wsmWords[9 * 80];
#else
#define STREAM_SLICE 0
shared uint winWords[LAYER_IN * WIN * 4];
// Double-buffered weights (2 x 9 x 80 = 5.6 KB) enable software pipelining and halve workgroup barriers per slice.
shared uint wsmWords[2 * 9 * 80];
#endif
#if RADV_REG_ONLY == 0
shared int  sAcc[4 * PY * int(SACC_TILE)];
#endif
#endif

int sbyte(uint w, uint k)
{
	return bitfieldExtract(int(w), int(k * 8u), 8);
}

int div16Signed(int v)
{
	return v >= 0 ? (v >> 4) : -((-v) >> 4);
}

uint uvec4Comp(uvec4 v, int k)
{
	return k == 0 ? v.x : (k == 1 ? v.y : (k == 2 ? v.z : v.w));
}

#if RADV_REG_ONLY != 0
// Packs 16 8-bit channels held across lanes [gBase + 0 .. gBase + 15] into 4 uint words on lane gBase + 0.
// Must be called uniformly by all 32 lanes in the subgroup.
uvec4 radvPack16Ch(uint q, uint lane)
{
	uint b1 = subgroupShuffleXor(q, 1u);
	uint b2 = subgroupShuffleXor(q, 2u);
	uint b3 = subgroupShuffleXor(b1, 2u);
	uint word = q | (b1 << 8u) | (b2 << 16u) | (b3 << 24u);
	uint gBase = lane & 16u;
	return uvec4(
		subgroupShuffle(word, gBase + 0u),
		subgroupShuffle(word, gBase + 4u),
		subgroupShuffle(word, gBase + 8u),
		subgroupShuffle(word, gBase + 12u)
	);
}
#endif

// Hardware clamp-to-border (0,0,0,0) equivalent for samplerless texelFetch (sz hoisted by caller)
uvec4 fetchInput(int x, int y, int slice, ivec3 sz)
{
	if (x < 0 || y < 0 || slice < 0 || x >= sz.x || y >= sz.y || slice >= sz.z)
		return uvec4(0u);
	return texelFetch(uInput, ivec3(x, y, slice), 0);
}

#if LAYER_FAMILY == 1
uvec4 fetchSkip(int x, int y, int slice, ivec3 sz)
{
	if (x < 0 || y < 0 || slice < 0 || x >= sz.x || y >= sz.y || slice >= sz.z)
		return uvec4(0u);
	return texelFetch(uSkip, ivec3(x, y, slice), 0);
}

// Exact port of UpSkipBilinearWord (9*a + 3*b + 3*c + d, signed div 16 + skip clamped to 0..127)
uint upSkipBilinearWord(uint aw, uint bw, uint cw, uint dw, uint sw)
{
	uint packed = 0u;
	for (uint k = 0u; k < 4u; ++k)
	{
		int dot = 9 * sbyte(aw, k) + 3 * (sbyte(bw, k) + sbyte(cw, k)) + sbyte(dw, k);
		int v = clamp(sbyte(sw, k) + div16Signed(dot), 0, 127);
		packed |= (uint(v) & 0xFFu) << (k * 8u);
	}
	return packed;
}
#endif

#if LAYER_FAMILY != 2
// Exact port of PoolConv / UpSkip Requant: trunc(fma(float(acc), scale, bias)), clamp(lo..127)
uint requantFloat(int acc, float s, float b, int lo)
{
	int q = int(fma(float(acc), s, b));
	return uint(clamp(q, lo, 127)) & 0xFFu;
}

// Stages one 144-uvec4 weight block (z * LAYER_IN + slice) into 9 column-major 16x16 int8 tap matrices in wsmWords.
// In Intel's layout, uWeights[(block * 144) + tap * 16 + word * 4 + s].l holds the 4 input channels (4*word..4*word+3)
// for output channel oc = 4*s + l. In column-major layout with stride = 4 uint32 words (16 int8 rows), column oc
// sits at wsmWords[tap * 64 + oc * 4 + word].
void stagePoolWeights(int block, uint tid, uint buf)
{
	const uint bufOff = buf * 720u; // 9 * 80 words per weight buffer
	for (uint i = tid; i < 144u; i += gl_WorkGroupSize.x)
	{
		uint tap  = i / 16u;
		uint rem  = i % 16u;
		uint word = rem / 4u;
		uint s    = rem % 4u;
		uvec4 v   = uWeights.data[uint(block) * 144u + i];
		uint base = bufOff + tap * 80u + (4u * s) * 5u + word;
		wsmWords[base + 0u * 5u] = v.x;
		wsmWords[base + 1u * 5u] = v.y;
		wsmWords[base + 2u * 5u] = v.z;
		wsmWords[base + 3u * 5u] = v.w;
	}
}

#if RADV_REG_ONLY == 0
void emitPoolRow(int r, int z, int X0, int Y0, int limitW, int limitH, uint warp, uint sAccWarp, uint lane,
                 float s[16], float bi[16], int lo)
{
	int Y = Y0 + int(warp) + r * int(gl_WorkGroupSize.x >> 5u);
	if (Y >= limitH)
		return;

#if LAYER_POOL != 0
	if (lane < 8u)
	{
		int px = int(lane);
		int X = X0 + px;
		if (X < limitW)
		{
			uint base0 = (sAccWarp * 2u + 0u) * SACC_TILE;
			uint base1 = (sAccWarp * 2u + 1u) * SACC_TILE;
			uint m0 = uint(2 * px) * SACC_STRIDE;
			uint m1 = uint(2 * px + 1) * SACC_STRIDE;
			uint words[4];
			for (int w = 0; w < 4; ++w)
			{
				uint packed = 0u;
				for (int c = 0; c < 4; ++c)
				{
					int oc = w * 4 + c;
					int v00 = sAcc[base0 + m0 + uint(oc)];
					int v10 = sAcc[base0 + m1 + uint(oc)];
					int v01 = sAcc[base1 + m0 + uint(oc)];
					int v11 = sAcc[base1 + m1 + uint(oc)];
					int m = max(max(v00, v01), max(v10, v11));
					packed |= requantFloat(m, s[oc], bi[oc], lo) << uint(c * 8);
				}
				words[w] = packed;
			}
			imageStore(uDst, ivec3(X, Y, z), uvec4(words[0], words[1], words[2], words[3]));
		}
	}
#else
	if (lane < 16u)
	{
		int px = int(lane);
		int X = X0 + px;
		if (X < limitW)
		{
			uint base0 = sAccWarp * SACC_TILE + uint(px) * SACC_STRIDE;
			uint words[4];
			for (int w = 0; w < 4; ++w)
			{
				uint packed = 0u;
				for (int c = 0; c < 4; ++c)
				{
					int oc = w * 4 + c;
					int val = sAcc[base0 + uint(oc)];
					packed |= requantFloat(val, s[oc], bi[oc], lo) << uint(c * 8);
				}
				words[w] = packed;
			}
			imageStore(uDst, ivec3(X, Y, z), uvec4(words[0], words[1], words[2], words[3]));
		}
	}
#endif
}
#else
#if LAYER_POOL != 0
void emitPoolRowRadv(int r, int z, int X0, int Y0, int limitW, int limitH,
                     uint warp, uint lane, float sLane, float biLane, int lo,
                     coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0,
                     coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC1)
{
	int Y = Y0 + int(warp) + r * int(gl_WorkGroupSize.x >> 5u);
	for (int i = 0; i < 8; ++i)
	{
		int vy = max(matC0[i], matC1[i]);
		int vPeer = subgroupShuffleXor(vy, 16u);
		int pooled = max(vy, vPeer);
		uint q = requantFloat(pooled, sLane, biLane, lo);
		uvec4 words = radvPack16Ch(q, lane);
		if (lane == 0u && Y < limitH && (X0 + i) < limitW)
			imageStore(uDst, ivec3(X0 + i, Y, z), words);
	}
}
#else
void emitPoolRowRadv(int r, int z, int X0, int Y0, int limitW, int limitH,
                     uint warp, uint lane, float sLane, float biLane, int lo,
                     coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0)
{
	int Y = Y0 + int(warp) + r * int(gl_WorkGroupSize.x >> 5u);
	uint g = lane >> 4u;
	for (int i = 0; i < 8; ++i)
	{
		uint q = requantFloat(matC0[i], sLane, biLane, lo);
		uvec4 words = radvPack16Ch(q, lane);
		int X = X0 + int(g) + i * 2;
		if ((lane & 15u) == 0u && Y < limitH && X < limitW)
			imageStore(uDst, ivec3(X, Y, z), words);
	}
}
#endif
#endif
