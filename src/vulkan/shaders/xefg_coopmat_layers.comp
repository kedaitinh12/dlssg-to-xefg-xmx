// SPDX-License-Identifier: MIT
//
// Full 9-tap 3x3 INT8 convolution GLSL compute shader template for XeFG's 17 ported INT8 layers
// using VK_KHR_cooperative_matrix (SPV_KHR_cooperative_matrix / GL_KHR_cooperative_matrix)
// on AMD RDNA 4 / RDNA 3 (WMMA) and Intel Arc / Battlemage (XMX).
//
// Direct bit-exact port of PoolConv, UpSkip (Decoder), and Flow from src/MfgPort/Cuda/xefg_cuda_layers.cu:
//   - LAYER_FAMILY == 0 (PoolConv): 18 x (CONV_H + 2) window with out-of-bounds zero padding, optional +0x80808080u
//     input bias (L_aa016078), 9-tap 3x3 x 16-channel cooperative-matrix accumulation across LAYER_IN slices,
//     optional 2x2 max-pooling, and IEEE-754 float fma(acc, scale, bias) + trunc + clamp(LO..127) requantization.
//   - LAYER_FAMILY == 1 (UpSkip Decoder): integer 2x bilinear upsampling (9*a + 3*b + 3*c + d) / 16 + skip clamped
//     to [0..127] inside Wd x Hd (pc.words[0].xy), 9-tap 3x3 cooperative-matrix convolution, and ReLU requantization.
//   - LAYER_FAMILY == 2 (Flow): 1-row top border (ys = Y0 + row >= 1..Hd, output stored at y + 1), 8-channel (2 slices
//     packed per 16-channel step, rg32ui output) or 16-channel (1 slice per step, rgba32ui output) 9-tap 3x3
//     accumulation across NT = 4 tiles (32 output channels per workgroup), and asymmetric int32 posMul/neg shift
//     requantization with [-2^ACC_BITS .. 2^ACC_BITS - 1] clamping.
//
// Compiled per layer via tools/GenerateXeFgCoopMat.py with glslangValidator --target-env vulkan1.3
// into third_party/xefg_mfg_programs/vulkan/coopmat/<kernel>.spv (and <program>.spv).
#version 460
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_samplerless_texture_functions : enable

// Optional AMD Wave32 register-only accumulator epilogue (zero sAcc LDS, zero subgroupBarrier).
//   RADV_REG_ONLY == 1 (RDNA 3 / gfx11, LLPC & RADV): lane (g = lane >> 4, p = lane & 15) owns C[g + i * 2][p].
//   RADV_REG_ONLY == 2 (RDNA 4 / gfx12, LLPC & RADV): lane (g = lane >> 4, p = lane & 15) owns C[g * 8 + i][p].
// Strictly gated at runtime in xvk_coopmat.cpp / D3D12VulkanWmma.cpp via hardware matC probe.
#ifndef RADV_REG_ONLY
#define RADV_REG_ONLY 0
#endif
#if RADV_REG_ONLY != 0
#extension GL_KHR_shader_subgroup_shuffle : enable
#endif

#ifndef COOP_K_COMPILED
#define COOP_K_COMPILED 16
#endif

layout(constant_id = 0) const uint COOP_M = 16;
layout(constant_id = 1) const uint COOP_N = 16;
layout(constant_id = 2) const uint COOP_K = COOP_K_COMPILED;
layout(constant_id = 3) const uint SUBGROUP_SIZE = 32;

#ifndef LAYER_FAMILY
#define LAYER_FAMILY 0 // 0 = PoolConv, 1 = UpSkip (Decoder), 2 = Flow
#endif

#ifndef LAYER_IN
#define LAYER_IN 1
#endif

#ifndef LAYER_OUT
#define LAYER_OUT 1
#endif

#ifndef LAYER_BIAS
#define LAYER_BIAS 0
#endif

#ifndef LAYER_POOL
#define LAYER_POOL 0
#endif

#ifndef LAYER_RELU
#define LAYER_RELU 0
#endif

#ifndef LAYER_TILE_H
#define LAYER_TILE_H 16
#endif

#ifndef LAYER_ZSPLIT
#define LAYER_ZSPLIT 1
#endif

#ifndef LAYER_ACC_BITS
#define LAYER_ACC_BITS 16
#endif

#ifndef LAYER_NT
#define LAYER_NT 4
#endif

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(local_size_x_id = 4) in;

// Descriptor bindings matching third_party/xefg_mfg_programs/vulkan/programs.tsv and xvk_coopmat.cpp:
//   binding 0  : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE (utexture2DArray t0)
//   binding 1  : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER (uWeights t1)
//   binding 2  : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER (uScale t2: float scale for Pool/Decoder, int32 bias for Flow)
//   binding 3  : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER (uBias t3: float bias for Pool/Decoder, int32 negMul for Flow)
//   binding 4  : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE (utexture2DArray t4, Decoder LAYER_FAMILY == 1 only)
//   binding 64 : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE (uimage2DArray u0: rg32ui for 8-ch Flow, rgba32ui otherwise)
layout(set = 0, binding = 0) uniform utexture2DArray uInput;
layout(set = 0, binding = 1, std430) readonly buffer WeightBuf { uvec4 data[]; } uWeights;
layout(set = 0, binding = 2, std430) readonly buffer ScaleBuf  { uvec4 data[]; } uScale;
layout(set = 0, binding = 3, std430) readonly buffer BiasBuf   { uvec4 data[]; } uBias;
#if LAYER_FAMILY == 1
layout(set = 0, binding = 4) uniform utexture2DArray uSkip;
#endif
#if LAYER_FAMILY == 2 && LAYER_OUT == 8
layout(set = 0, binding = 64, rg32ui) uniform writeonly uimage2DArray uDst;
#else
layout(set = 0, binding = 64, rgba32ui) uniform writeonly uimage2DArray uDst;
#endif

#if LAYER_FAMILY == 2
layout(push_constant) uniform PushConstants
{
	uvec4 words[3];
} pc;
#else
layout(push_constant) uniform PushConstants
{
	uvec4 words[1];
} pc;
#endif

const int WIN_W = 18;
#if LAYER_FAMILY == 0 && LAYER_POOL != 0
const int PY = 2;
#else
const int PY = 1;
#endif
const int CONV_H = LAYER_TILE_H * PY;
const int WIN_H  = CONV_H + 2;
const int WIN    = WIN_W * WIN_H;
const int ROWS   = LAYER_TILE_H / 4;

// 16-byte-aligned padded accumulator row stride (20 ints = 80 B) cuts 8-way LDS bank conflicts on non-RADV_REG_ONLY paths.
const uint SACC_STRIDE = 20u;
const uint SACC_TILE   = 16u * SACC_STRIDE; // 320 ints per 16x16 accumulator tile

#if COOP_K_COMPILED == 32
// Double-K (16x16x32): 6 paired horizontal taps per slice/step; stride = 12 uint32 (48 B) keeps every column 16-byte aligned for RDNA 4 128-bit LDS loads while keeping Flow LDS <= 29 KB.
const uint WSM_COL_STRIDE = 12u;
const uint WSM_TAP_WORDS  = 16u * WSM_COL_STRIDE; // 192 words per 32x16 paired-tap matrix
const uint WSM_BUF_WORDS  = 6u * WSM_TAP_WORDS;   // 1152 words per 6-pair buffer
const int  WIN_TAIL_PAD   = 4;                    // 4 trailing words keep dx=2 upper K=16..31 loads in-bounds
#else
// Tight 16-byte-aligned column stride (4 uint32 = 16 B per 16xint8 column).
// LDS reduction: default sAcc path Flow 21.9 -> 19.6 KB, L_a3c3caa1 21.9 -> 20.8 KB (no occupancy change);
// register-only (radv_reg / gfx12_reg) Flow 16.9 -> 14.6 KB, L_a3c3caa1 16.9 -> 15.8 KB (<= 16 KB, 4 WG/CU if not VGPR-limited).
#ifndef WSM_COL_STRIDE_VAL
#define WSM_COL_STRIDE_VAL 4
#endif
const uint WSM_COL_STRIDE = uint(WSM_COL_STRIDE_VAL);
const uint WSM_TAP_WORDS  = 16u * WSM_COL_STRIDE; // 64 words per 16x16 tap matrix
const uint WSM_BUF_WORDS  = 9u * WSM_TAP_WORDS;   // 576 words per 9-tap buffer
const int  WIN_TAIL_PAD   = 0;
#endif

#if LAYER_FAMILY == 2
// Double-buffered Flow input window + weights cut barriers in half (1 barrier/step instead of 2) while keeping LDS <= 25 KB.
const uint FLOW_WIN_BUF_WORDS = uint(WIN * 4 + WIN_TAIL_PAD);
const uint FLOW_WSM_BUF_WORDS = 2u * WSM_BUF_WORDS;
shared uint winWords[2 * (WIN * 4 + WIN_TAIL_PAD)];
shared uint wsmWords[2 * 2 * int(WSM_BUF_WORDS)];
#if RADV_REG_ONLY == 0
shared int  sAcc[4 * int(SACC_TILE)]; // Phased half-emission with padded stride
#endif
#else
const int ZPER = LAYER_OUT / LAYER_ZSPLIT;
#if (LAYER_OUT / LAYER_ZSPLIT) == 1 && LAYER_IN > 1
#define STREAM_SLICE 1
shared uint winWords[WIN * 4 + WIN_TAIL_PAD];
shared uint wsmWords[int(WSM_BUF_WORDS)];
#else
#define STREAM_SLICE 0
shared uint winWords[LAYER_IN * WIN * 4 + WIN_TAIL_PAD];
// Double-buffered weights enable software pipelining and halve workgroup barriers per slice.
shared uint wsmWords[2 * int(WSM_BUF_WORDS)];
#endif
#if RADV_REG_ONLY == 0
shared int  sAcc[4 * PY * int(SACC_TILE)];
#endif
#endif

#if LAYER_FAMILY == 1
i16vec4 unpackS8x4ToI16(uint w)
{
	return i16vec4(
		int16_t(bitfieldExtract(int(w),  0, 8)),
		int16_t(bitfieldExtract(int(w),  8, 8)),
		int16_t(bitfieldExtract(int(w), 16, 8)),
		int16_t(bitfieldExtract(int(w), 24, 8)));
}
#endif

uint uvec4Comp(uvec4 v, int k)
{
	return k == 0 ? v.x : (k == 1 ? v.y : (k == 2 ? v.z : v.w));
}

#if RADV_REG_ONLY != 0
// Packs 16 8-bit channels held across lanes [gBase + 0 .. gBase + 15] into 4 uint words on lane gBase + 0.
// Must be called uniformly by all 32 lanes in the subgroup.
uvec4 radvPack16Ch(uint q, uint lane)
{
	uint b1 = subgroupShuffleXor(q, 1u);
	uint b2 = subgroupShuffleXor(q, 2u);
	uint b3 = subgroupShuffleXor(b1, 2u);
	uint word = q | (b1 << 8u) | (b2 << 16u) | (b3 << 24u);
	uint gBase = lane & 16u;
	return uvec4(
		subgroupShuffle(word, gBase + 0u),
		subgroupShuffle(word, gBase + 4u),
		subgroupShuffle(word, gBase + 8u),
		subgroupShuffle(word, gBase + 12u)
	);
}
#endif

// Hardware clamp-to-border (0,0,0,0) equivalent for samplerless texelFetch (sz hoisted by caller)
uvec4 fetchInput(int x, int y, int slice, ivec3 sz)
{
	if (x < 0 || y < 0 || slice < 0 || x >= sz.x || y >= sz.y || slice >= sz.z)
		return uvec4(0u);
	return texelFetch(uInput, ivec3(x, y, slice), 0);
}

#if LAYER_FAMILY == 1
uvec4 fetchSkip(int x, int y, int slice, ivec3 sz)
{
	if (x < 0 || y < 0 || slice < 0 || x >= sz.x || y >= sz.y || slice >= sz.z)
		return uvec4(0u);
	return texelFetch(uSkip, ivec3(x, y, slice), 0);
}

// Bit-exact packed i16vec4 port of UpSkipBilinearWord (9*a + 3*b + 3*c + d, signed div 16 + skip clamped to 0..127).
// Enables 2x-throughput packed 16-bit ALU (v_pk_mul_lo_u16 / v_pk_add_i16) on RDNA 3/4; dot fits in [-2048, 2032].
uint upSkipBilinearWord(uint aw, uint bw, uint cw, uint dw, uint sw)
{
	i16vec4 a    = unpackS8x4ToI16(aw);
	i16vec4 b    = unpackS8x4ToI16(bw);
	i16vec4 c    = unpackS8x4ToI16(cw);
	i16vec4 d    = unpackS8x4ToI16(dw);
	i16vec4 s    = unpackS8x4ToI16(sw);
	i16vec4 dot  = i16vec4(int16_t(9)) * a + i16vec4(int16_t(3)) * (b + c) + d;
	i16vec4 bias = (dot >> i16vec4(int16_t(15))) & i16vec4(int16_t(15));
	i16vec4 q    = (dot + bias) >> i16vec4(int16_t(4));
	u16vec4 v    = u16vec4(clamp(s + q, i16vec4(int16_t(0)), i16vec4(int16_t(127))));
	return uint(v.x) | (uint(v.y) << 8u) | (uint(v.z) << 16u) | (uint(v.w) << 24u);
}
#endif

#if LAYER_FAMILY != 2
// Exact port of PoolConv / UpSkip Requant: trunc(fma(float(acc), scale, bias)), clamp(lo..127)
uint requantFloat(int acc, float s, float b, int lo)
{
	int q = int(fma(float(acc), s, b));
	return uint(clamp(q, lo, 127)) & 0xFFu;
}

// Stages one 144-uvec4 weight block (z * LAYER_IN + slice) into 9 column-major 16x16 int8 tap matrices in wsmWords.
// In Intel's layout, uWeights[(block * 144) + tap * 16 + word * 4 + s].l holds the 4 input channels (4*word..4*word+3)
// for output channel oc = 4*s + l. In column-major layout with stride = 4 uint32 words (16 int8 rows), column oc
// sits at wsmWords[tap * 64 + oc * 4 + word].
void stagePoolWeights(int block, uint tid, uint buf)
{
	const uint bufOff = buf * WSM_BUF_WORDS;
#if COOP_K_COMPILED == 32
	for (uint i = tid; i < 144u; i += gl_WorkGroupSize.x)
	{
		uint tap   = i / 16u;
		uint rem   = i % 16u;
		uint word  = rem / 4u;
		uint s     = rem % 4u;
		uvec4 v    = uWeights.data[uint(block) * 144u + i];
		uint dy    = tap / 3u;
		uint dx    = tap % 3u;
		uint pair  = dy * 2u + (dx >> 1u);
		uint kHalf = (dx == 1u) ? 4u : 0u;
		uint base  = bufOff + pair * WSM_TAP_WORDS + (4u * s) * WSM_COL_STRIDE + kHalf + word;
		wsmWords[base + 0u * WSM_COL_STRIDE] = v.x;
		wsmWords[base + 1u * WSM_COL_STRIDE] = v.y;
		wsmWords[base + 2u * WSM_COL_STRIDE] = v.z;
		wsmWords[base + 3u * WSM_COL_STRIDE] = v.w;
		if (dx == 2u)
		{
			uint zBase = base + 4u;
			wsmWords[zBase + 0u * WSM_COL_STRIDE] = 0u;
			wsmWords[zBase + 1u * WSM_COL_STRIDE] = 0u;
			wsmWords[zBase + 2u * WSM_COL_STRIDE] = 0u;
			wsmWords[zBase + 3u * WSM_COL_STRIDE] = 0u;
		}
	}
#else
	// Stage one full 16-byte column (4 contiguous uint32 words) per lane so adjacent lanes write
	// adjacent columns without 4-way LDS bank conflicts under WSM_COL_STRIDE == 4u.
	for (uint i = tid; i < 144u; i += gl_WorkGroupSize.x)
	{
		uint tap = i / 16u;
		uint oc  = i % 16u;
		uint s   = oc / 4u;
		uint l   = oc % 4u;
		uint src = uint(block) * 144u + tap * 16u + s;
		uvec4 col = uvec4(
			uWeights.data[src +  0u][l],
			uWeights.data[src +  4u][l],
			uWeights.data[src +  8u][l],
			uWeights.data[src + 12u][l]);
		uint dst = bufOff + tap * WSM_TAP_WORDS + oc * WSM_COL_STRIDE;
		wsmWords[dst + 0u] = col.x;
		wsmWords[dst + 1u] = col.y;
		wsmWords[dst + 2u] = col.z;
		wsmWords[dst + 3u] = col.w;
	}
#endif
}

#if RADV_REG_ONLY == 0
void emitPoolRow(int r, int z, int X0, int Y0, int limitW, int limitH, uint warp, uint sAccWarp, uint lane,
                 float s[16], float bi[16], int lo)
{
	int Y = Y0 + int(warp) + r * int(gl_WorkGroupSize.x >> 5u);
	if (Y >= limitH)
		return;

#if LAYER_POOL != 0
	if (lane < 8u)
	{
		int px = int(lane);
		int X = X0 + px;
		if (X < limitW)
		{
			uint base0 = (sAccWarp * 2u + 0u) * SACC_TILE;
			uint base1 = (sAccWarp * 2u + 1u) * SACC_TILE;
			uint m0 = uint(2 * px) * SACC_STRIDE;
			uint m1 = uint(2 * px + 1) * SACC_STRIDE;
			uint words[4];
			for (int w = 0; w < 4; ++w)
			{
				uint packed = 0u;
				for (int c = 0; c < 4; ++c)
				{
					int oc = w * 4 + c;
					int v00 = sAcc[base0 + m0 + uint(oc)];
					int v10 = sAcc[base0 + m1 + uint(oc)];
					int v01 = sAcc[base1 + m0 + uint(oc)];
					int v11 = sAcc[base1 + m1 + uint(oc)];
					int m = max(max(v00, v01), max(v10, v11));
					packed |= requantFloat(m, s[oc], bi[oc], lo) << uint(c * 8);
				}
				words[w] = packed;
			}
			imageStore(uDst, ivec3(X, Y, z), uvec4(words[0], words[1], words[2], words[3]));
		}
	}
#else
	if (lane < 16u)
	{
		int px = int(lane);
		int X = X0 + px;
		if (X < limitW)
		{
			uint base0 = sAccWarp * SACC_TILE + uint(px) * SACC_STRIDE;
			uint words[4];
			for (int w = 0; w < 4; ++w)
			{
				uint packed = 0u;
				for (int c = 0; c < 4; ++c)
				{
					int oc = w * 4 + c;
					int val = sAcc[base0 + uint(oc)];
					packed |= requantFloat(val, s[oc], bi[oc], lo) << uint(c * 8);
				}
				words[w] = packed;
			}
			imageStore(uDst, ivec3(X, Y, z), uvec4(words[0], words[1], words[2], words[3]));
		}
	}
#endif
}
#else
#if LAYER_POOL != 0
void emitPoolRowRadv(int r, int z, int X0, int Y0, int limitW, int limitH,
                     uint warp, uint lane, float sLane, float biLane, int lo,
                     coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0,
                     coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC1)
{
	int Y = Y0 + int(warp) + r * int(gl_WorkGroupSize.x >> 5u);
	uvec4 myWords = uvec4(0u);
#if RADV_REG_ONLY == 2
	// RDNA 4 (gfx12): lane (g, p) holds rows g*8 + 0..7; gather into lanes 0..3 / 16..19 for 1 coalesced 8-lane store.
	uint g = lane >> 4u;
	uint p = lane & 15u;
	for (int k = 0; k < 4; ++k)
	{
		int v0 = max(matC0[2 * k],     matC1[2 * k]);
		int v1 = max(matC0[2 * k + 1], matC1[2 * k + 1]);
		int pooled = max(v0, v1);
		uint q = requantFloat(pooled, sLane, biLane, lo);
		uvec4 words = radvPack16Ch(q, lane);
		if (p == uint(k))
			myWords = words;
	}
	int X = X0 + int(g) * 4 + int(p);
	if (p < 4u && Y < limitH && X < limitW)
		imageStore(uDst, ivec3(X, Y, z), myWords);
#else
	// RDNA 3 (gfx11): gather all 8 pooled pixels into contiguous lanes 0..7 for 1 coalesced 8-lane store.
	for (int i = 0; i < 8; ++i)
	{
		int vy = max(matC0[i], matC1[i]);
		int vPeer = subgroupShuffleXor(vy, 16u);
		int pooled = max(vy, vPeer);
		uint q = requantFloat(pooled, sLane, biLane, lo);
		uvec4 words = radvPack16Ch(q, lane);
		if (lane == uint(i))
			myWords = words;
	}
	int X = X0 + int(lane);
	if (lane < 8u && Y < limitH && X < limitW)
		imageStore(uDst, ivec3(X, Y, z), myWords);
#endif
}
#else
void emitPoolRowRadv(int r, int z, int X0, int Y0, int limitW, int limitH,
                     uint warp, uint lane, float sLane, float biLane, int lo,
                     coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0)
{
	int Y = Y0 + int(warp) + r * int(gl_WorkGroupSize.x >> 5u);
	uint g = lane >> 4u;
	uint p = lane & 15u;
	uvec4 myWords = uvec4(0u);
	for (int i = 0; i < 8; ++i)
	{
		uint q = requantFloat(matC0[i], sLane, biLane, lo);
		uvec4 words = radvPack16Ch(q, lane);
		if (p == uint(i))
			myWords = words;
	}
#if RADV_REG_ONLY == 2
	int X = X0 + int(g) * 8 + int(p);
#else
	int X = X0 + int(g) + int(p) * 2;
#endif
	if (p < 8u && Y < limitH && X < limitW)
		imageStore(uDst, ivec3(X, Y, z), myWords);
}
#endif
#endif
#else
// Exact port of Flow requantization from src/MfgPort/Cuda/xefg_cuda_layers.cu lines 533-538
// Uses hoisted uniform rounding constants and single-multiply branchless select (bit-exact for s1, s2 in [1, 31])
uint requantFlow(int a, int ib, int neg, int lim, uint posMul, uint s1, uint s2, uint roundPos, uint roundNeg)
{
	int clamped = clamp(a + ib, -lim, lim - 1);
	bool isPos  = clamped >= 0;
	uint mul    = isPos ? posMul   : uint(neg);
	uint rnd    = isPos ? roundPos : roundNeg;
	int  sh     = int(isPos ? s1   : s2);
	int  val    = int(uint(clamped) * mul + rnd) >> sh;
	return uint(clamp(val, -128, 127)) & 0xFFu;
}

void fillFlowWindow(int step, int X0, int Y0, int Wd, int Hd, ivec3 inSz, uint tid, uint buf)
{
	const uint winBufOff = buf * FLOW_WIN_BUF_WORDS;
	for (uint e = tid; e < uint(WIN); e += gl_WorkGroupSize.x)
	{
		int x  = X0 - 1 + (int(e) % WIN_W);
		int ys = Y0 + (int(e) / WIN_W);
		uvec4 v = uvec4(0u);
		if (x >= 0 && x < Wd && ys >= 1 && ys <= Hd)
		{
#if LAYER_OUT == 8
			uvec4 a = fetchInput(x, ys, 2 * step, inSz);
			uvec4 b = fetchInput(x, ys, 2 * step + 1, inSz);
			v = uvec4(a.x, a.y, b.x, b.y);
#else
			v = fetchInput(x, ys, step, inSz);
#endif
		}
		uint dst = winBufOff + e * 4u;
		winWords[dst + 0u] = v.x;
		winWords[dst + 1u] = v.y;
		winWords[dst + 2u] = v.z;
		winWords[dst + 3u] = v.w;
	}
}

// Stages weights for step `step` across NT = 4 tiles of 8 channels (two 16-channel halves h = 0, 1) into double-buffered wsmWords
void stageFlowWeights(int step, int n0, uint tid, uint buf)
{
	const uint wBufOff = buf * FLOW_WSM_BUF_WORDS;
#if COOP_K_COMPILED == 32
	for (uint e = tid; e < uint(LAYER_NT * 72); e += gl_WorkGroupSize.x)
	{
		int nt     = int(e) / 72;
		int group  = (int(e) % 72) / 36;
		int k      = int(e) % 36;
		int tap    = k / 4;
		int word   = k % 4;
		int ch     = (n0 + nt) * 8;
		int z      = ch / LAYER_OUT;
		int c      = ch % LAYER_OUT;
		uint idx   = uint(((z * LAYER_IN + step) * (LAYER_OUT / 4) + (c / 4) + group) * 36 + k);
		uvec4 v    = uWeights.data[idx];

		uint h      = uint(nt >> 1);
		uint ocBase = uint((nt & 1) * 8 + group * 4);
		uint dy     = uint(tap) / 3u;
		uint dx     = uint(tap) % 3u;
		uint pair   = dy * 2u + (dx >> 1u);
		uint kHalf  = (dx == 1u) ? 4u : 0u;
		uint base   = wBufOff + h * WSM_BUF_WORDS + pair * WSM_TAP_WORDS + ocBase * WSM_COL_STRIDE + kHalf + uint(word);
		wsmWords[base + 0u * WSM_COL_STRIDE] = v.x;
		wsmWords[base + 1u * WSM_COL_STRIDE] = v.y;
		wsmWords[base + 2u * WSM_COL_STRIDE] = v.z;
		wsmWords[base + 3u * WSM_COL_STRIDE] = v.w;
		if (dx == 2u)
		{
			uint zBase = base + 4u;
			wsmWords[zBase + 0u * WSM_COL_STRIDE] = 0u;
			wsmWords[zBase + 1u * WSM_COL_STRIDE] = 0u;
			wsmWords[zBase + 2u * WSM_COL_STRIDE] = 0u;
			wsmWords[zBase + 3u * WSM_COL_STRIDE] = 0u;
		}
	}
#else
#if (LAYER_NT % 2) != 0
#error "stageFlowWeights K=16 requires even LAYER_NT"
#endif
	// Stage one full 16-byte column (4 contiguous uint32 words) per lane to match stagePoolWeights
	// and allow ds_store_b128 coalescing under WSM_COL_STRIDE == 4u.
	for (uint e = tid; e < uint(LAYER_NT * 72); e += gl_WorkGroupSize.x)
	{
		uint h   = e / 144u;
		uint r   = e % 144u;
		uint tap = r / 16u;
		uint oc  = r % 16u;
		int  nt  = int(h * 2u + oc / 8u);
		int  grp = int((oc % 8u) / 4u);
		uint j   = oc % 4u;
		int  ch  = (n0 + nt) * 8;
		int  z   = ch / LAYER_OUT;
		int  c   = ch % LAYER_OUT;
		uint src = uint(((z * LAYER_IN + step) * (LAYER_OUT / 4) + (c / 4) + grp) * 36) + tap * 4u;
		uvec4 col = uvec4(
			uWeights.data[src + 0u][j],
			uWeights.data[src + 1u][j],
			uWeights.data[src + 2u][j],
			uWeights.data[src + 3u][j]);
		uint dst = wBufOff + h * WSM_BUF_WORDS + tap * WSM_TAP_WORDS + oc * WSM_COL_STRIDE;
		wsmWords[dst + 0u] = col.x;
		wsmWords[dst + 1u] = col.y;
		wsmWords[dst + 2u] = col.z;
		wsmWords[dst + 3u] = col.w;
	}
#endif
}

#if RADV_REG_ONLY == 0
void emitFlowHalf(int r, int h, int n0, int X0, int Y0, int limitW, int limitH,
                  int lim, uint posMul, uint s1, uint s2, uint roundPos, uint roundNeg,
                  uint warp, uint lane, uvec4 flowScale[8], uvec4 flowBias[8])
{
	int y = Y0 + int(warp) + r * 4;
	if (lane >= 16u || y >= limitH)
		return;

	int px = int(lane);
	int x = X0 + px;
	if (x >= limitW)
		return;

	uint baseAcc = warp * SACC_TILE + uint(px) * SACC_STRIDE;
	uint words[4];
	for (int w = 0; w < 4; ++w)
	{
		uvec4 bv = flowScale[h * 4 + w];
		uvec4 nv = flowBias[h * 4 + w];
		int ib[4] = { int(bv.x), int(bv.y), int(bv.z), int(bv.w) };
		int ng[4] = { int(nv.x), int(nv.y), int(nv.z), int(nv.w) };
		uint packed = 0u;
		for (int c = 0; c < 4; ++c)
		{
			int a = sAcc[baseAcc + uint(w * 4 + c)];
			packed |= requantFlow(a, ib[c], ng[c], lim, posMul, s1, s2, roundPos, roundNeg) << uint(c * 8);
		}
		words[w] = packed;
	}

#if LAYER_OUT == 8
	imageStore(uDst, ivec3(x, y + 1, n0 + h * 2 + 0), uvec4(words[0], words[1], words[0], words[0]));
	imageStore(uDst, ivec3(x, y + 1, n0 + h * 2 + 1), uvec4(words[2], words[3], words[2], words[2]));
#else
	imageStore(uDst, ivec3(x, y + 1, (n0 / 2) + h), uvec4(words[0], words[1], words[2], words[3]));
#endif
}
#else
void emitFlowHalfRadv(int r, int h, int n0, int X0, int Y0, int limitW, int limitH,
                      int lim, uint posMul, uint s1, uint s2, uint roundPos, uint roundNeg,
                      uint warp, uint lane, int ibLane, int ngLane,
                      coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC)
{
	int y = Y0 + int(warp) + r * 4;
	uint g = lane >> 4u;
	uint p = lane & 15u;
	uvec4 myWords = uvec4(0u);
	for (int i = 0; i < 8; ++i)
	{
		uint q = requantFlow(matC[i], ibLane, ngLane, lim, posMul, s1, s2, roundPos, roundNeg);
		uvec4 words = radvPack16Ch(q, lane);
		if (p == uint(i))
			myWords = words;
	}
#if RADV_REG_ONLY == 2
	int x = X0 + int(g) * 8 + int(p);
#else
	int x = X0 + int(g) + int(p) * 2;
#endif
	if (p < 8u && y < limitH && x < limitW)
	{
#if LAYER_OUT == 8
		imageStore(uDst, ivec3(x, y + 1, n0 + h * 2 + 0), uvec4(myWords.x, myWords.y, myWords.x, myWords.x));
		imageStore(uDst, ivec3(x, y + 1, n0 + h * 2 + 1), uvec4(myWords.z, myWords.w, myWords.z, myWords.z));
#else
		imageStore(uDst, ivec3(x, y + 1, (n0 / 2) + h), myWords);
#endif
	}
}
#endif
#endif

// L2-cache-friendly 2D workgroup swizzle (vertical bands of 8 tiles = 128 px wide).
// Keeps 3x3 halo rows and weights hot in L2 across consecutive launches on RDNA 3/4.
// Exact bijection over [0..numWg.x-1] x [0..numWg.y-1] for any grid size (pure SGPR, 0 VGPR/LDS).
uvec2 swizzleWorkGroup2D(uvec2 wg, uvec2 numWg)
{
	const uint linear     = wg.y * numWg.x + wg.x;
	const uint bandW      = 8u;
	const uint fullBandsX = numWg.x & ~(bandW - 1u);
	const uint fullArea   = fullBandsX * numWg.y;
	if (linear < fullArea)
	{
		const uint bandArea = bandW * numWg.y;
		const uint band     = linear / bandArea;
		const uint rem      = linear - band * bandArea;
		return uvec2(band * bandW + (rem & (bandW - 1u)), rem >> 3u);
	}
	const uint remW = numWg.x - fullBandsX;
	const uint tail = linear - fullArea;
	return uvec2(fullBandsX + (tail % remW), tail / remW);
}

void main()
{
	const uint tid  = gl_LocalInvocationIndex;
	const uint warp = tid >> 5u;
	const uint lane = tid & 31u;
	ivec3 outSz = imageSize(uDst);

	coopmat<int8_t, gl_ScopeSubgroup, 16, COOP_K_COMPILED, gl_MatrixUseA> matA;
	coopmat<int8_t, gl_ScopeSubgroup, 16, COOP_K_COMPILED, gl_MatrixUseA> matA1;
	coopmat<int8_t, gl_ScopeSubgroup, COOP_K_COMPILED, 16, gl_MatrixUseB> matB;
#if LAYER_FAMILY == 2
	coopmat<int8_t, gl_ScopeSubgroup, COOP_K_COMPILED, 16, gl_MatrixUseB> matB1;
#endif

#if LAYER_FAMILY != 2
	// ---- Family 0 (PoolConv) & Family 1 (UpSkip Decoder) ----
	const uvec2 swWg = swizzleWorkGroup2D(gl_WorkGroupID.xy, gl_NumWorkGroups.xy);
	const int X0 = int(swWg.x) * ((LAYER_POOL != 0) ? 8 : 16);
	const int Y0 = int(swWg.y) * LAYER_TILE_H;
	const int limitW = outSz.x;
	const int limitH = outSz.y;
	const int lo = (LAYER_FAMILY == 1 || LAYER_RELU != 0) ? 0 : -128;

	const ivec3 inSz = textureSize(uInput, 0);
#if LAYER_FAMILY == 0
	const int cx0 = (LAYER_POOL != 0) ? (2 * X0) : X0;
	const int cy0 = (LAYER_POOL != 0) ? (2 * Y0) : Y0;
#if STREAM_SLICE == 0
	for (uint i = tid; i < uint(LAYER_IN * WIN); i += gl_WorkGroupSize.x)
	{
		int slice = int(i) / WIN;
		int r     = int(i) % WIN;
		uvec4 v   = fetchInput(cx0 - 1 + (r % WIN_W), cy0 - 1 + (r / WIN_W), slice, inSz);
#if LAYER_BIAS != 0
		v += uvec4(0x80808080u);
#endif
		winWords[i * 4u + 0u] = v.x;
		winWords[i * 4u + 1u] = v.y;
		winWords[i * 4u + 2u] = v.z;
		winWords[i * 4u + 3u] = v.w;
	}
	barrier();
#endif
#else
	const ivec3 skipSz = textureSize(uSkip, 0);
	const int Wd = int(pc.words[0].x);
	const int Hd = int(pc.words[0].y);
#if STREAM_SLICE == 0
	for (uint i = tid; i < uint(LAYER_IN * WIN); i += gl_WorkGroupSize.x)
	{
		int slice = int(i) / WIN;
		int r     = int(i) % WIN;
		int x     = X0 - 1 + (r % WIN_W);
		int y     = Y0 - 1 + (r / WIN_W);
		uvec4 res = uvec4(0u);
		if (x >= 0 && y >= 0 && x < Wd && y < Hd)
		{
			int xn = x >> 1;
			int yn = y >> 1;
			int xf = ((x & 1) != 0) ? (xn + 1) : (xn - 1);
			int yf = ((y & 1) != 0) ? (yn + 1) : (yn - 1);
			uvec4 a = fetchInput(xn, yn, slice, inSz);
			uvec4 b = fetchInput(xf, yn, slice, inSz);
			uvec4 c = fetchInput(xn, yf, slice, inSz);
			uvec4 d = fetchInput(xf, yf, slice, inSz);
			uvec4 s = fetchSkip(x, y, slice, skipSz);
			res = uvec4(
				upSkipBilinearWord(a.x, b.x, c.x, d.x, s.x),
				upSkipBilinearWord(a.y, b.y, c.y, d.y, s.y),
				upSkipBilinearWord(a.z, b.z, c.z, d.z, s.z),
				upSkipBilinearWord(a.w, b.w, c.w, d.w, s.w));
		}
		winWords[i * 4u + 0u] = res.x;
		winWords[i * 4u + 1u] = res.y;
		winWords[i * 4u + 2u] = res.z;
		winWords[i * 4u + 3u] = res.w;
	}
	barrier();
#endif
#endif

	const int zBegin = int(gl_WorkGroupID.z) * ZPER;
	for (int z = zBegin; z < zBegin + ZPER; ++z)
	{
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0_0 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#if LAYER_POOL != 0
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0_1 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#endif
#if LAYER_TILE_H >= 8
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC1_0 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#if LAYER_POOL != 0
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC1_1 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#endif
#endif
#if LAYER_TILE_H >= 16
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC2_0 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC3_0 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#if LAYER_POOL != 0
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC2_1 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC3_1 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#endif
#endif

#if STREAM_SLICE == 0
		if (z > zBegin)
			barrier();
		stagePoolWeights(z * LAYER_IN, tid, 0u);
		barrier();
#endif

		for (int slice = 0; slice < LAYER_IN; ++slice)
		{
#if STREAM_SLICE != 0
#if LAYER_FAMILY == 0
			for (uint r = tid; r < uint(WIN); r += gl_WorkGroupSize.x)
			{
				uvec4 v = fetchInput(cx0 - 1 + (int(r) % WIN_W), cy0 - 1 + (int(r) / WIN_W), slice, inSz);
#if LAYER_BIAS != 0
				v += uvec4(0x80808080u);
#endif
				winWords[r * 4u + 0u] = v.x;
				winWords[r * 4u + 1u] = v.y;
				winWords[r * 4u + 2u] = v.z;
				winWords[r * 4u + 3u] = v.w;
			}
#else
			for (uint r = tid; r < uint(WIN); r += gl_WorkGroupSize.x)
			{
				int x = X0 - 1 + (int(r) % WIN_W);
				int y = Y0 - 1 + (int(r) / WIN_W);
				uvec4 res = uvec4(0u);
				if (x >= 0 && y >= 0 && x < Wd && y < Hd)
				{
					int xn = x >> 1;
					int yn = y >> 1;
					int xf = ((x & 1) != 0) ? (xn + 1) : (xn - 1);
					int yf = ((y & 1) != 0) ? (yn + 1) : (yn - 1);
					uvec4 a = fetchInput(xn, yn, slice, inSz);
					uvec4 b = fetchInput(xf, yn, slice, inSz);
					uvec4 c = fetchInput(xn, yf, slice, inSz);
					uvec4 d = fetchInput(xf, yf, slice, inSz);
					uvec4 s = fetchSkip(x, y, slice, skipSz);
					res = uvec4(
						upSkipBilinearWord(a.x, b.x, c.x, d.x, s.x),
						upSkipBilinearWord(a.y, b.y, c.y, d.y, s.y),
						upSkipBilinearWord(a.z, b.z, c.z, d.z, s.z),
						upSkipBilinearWord(a.w, b.w, c.w, d.w, s.w));
				}
				winWords[r * 4u + 0u] = res.x;
				winWords[r * 4u + 1u] = res.y;
				winWords[r * 4u + 2u] = res.z;
				winWords[r * 4u + 3u] = res.w;
			}
#endif
#endif
#if STREAM_SLICE != 0
			stagePoolWeights(z * LAYER_IN + slice, tid, 0u);
			barrier();
			const uint wBufOff = 0u;
#else
			const uint curBuf = uint(slice & 1);
			const uint wBufOff = curBuf * WSM_BUF_WORDS;
			if (slice + 1 < LAYER_IN)
				stagePoolWeights(z * LAYER_IN + slice + 1, tid, curBuf ^ 1u);
#endif

			int sliceBase = (STREAM_SLICE != 0) ? 0 : (slice * WIN);
#if COOP_K_COMPILED == 32
			for (int tap = 0; tap < 6; ++tap)
			{
				int dy = tap >> 1;
				int dx = (tap & 1) * 2;
				coopMatLoad(matB, wsmWords, wBufOff + uint(tap) * WSM_TAP_WORDS, WSM_COL_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
#else
			for (int tap = 0; tap < 9; ++tap)
			{
				int dy = tap / 3;
				int dx = tap % 3;
				coopMatLoad(matB, wsmWords, wBufOff + uint(tap) * WSM_TAP_WORDS, WSM_COL_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
#endif

#if LAYER_POOL != 0
				// Row group r = 0 (yl = warp + 0): ping-pong matA/matA1 to overlap LDS loads with WMMA
				{
					int yl = int(warp);
					uint aOff0 = uint((sliceBase + (yl * PY + 0 + dy) * WIN_W + dx) * 4);
					uint aOff1 = uint((sliceBase + (yl * PY + 1 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA,  winWords, aOff0, 4u, gl_CooperativeMatrixLayoutRowMajor);
					coopMatLoad(matA1, winWords, aOff1, 4u, gl_CooperativeMatrixLayoutRowMajor);
					matC0_0 = coopMatMulAdd(matA,  matB, matC0_0);
					matC0_1 = coopMatMulAdd(matA1, matB, matC0_1);
				}

#if LAYER_TILE_H >= 8
				// Row group r = 1 (yl = warp + 4 for 128 threads, warp + 8 for 256 threads)
				{
					int yl = int(warp) + int(gl_WorkGroupSize.x >> 5u);
					uint aOff0 = uint((sliceBase + (yl * PY + 0 + dy) * WIN_W + dx) * 4);
					uint aOff1 = uint((sliceBase + (yl * PY + 1 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA,  winWords, aOff0, 4u, gl_CooperativeMatrixLayoutRowMajor);
					coopMatLoad(matA1, winWords, aOff1, 4u, gl_CooperativeMatrixLayoutRowMajor);
					matC1_0 = coopMatMulAdd(matA,  matB, matC1_0);
					matC1_1 = coopMatMulAdd(matA1, matB, matC1_1);
				}
#endif

#if LAYER_TILE_H >= 16
				// Row group r = 2 and r = 3 (only needed when 4 warps cover 16 rows)
				if (gl_WorkGroupSize.x < 256u)
				{
					int yl2 = int(warp) + 8;
					uint aOff2_0 = uint((sliceBase + (yl2 * PY + 0 + dy) * WIN_W + dx) * 4);
					uint aOff2_1 = uint((sliceBase + (yl2 * PY + 1 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA,  winWords, aOff2_0, 4u, gl_CooperativeMatrixLayoutRowMajor);
					coopMatLoad(matA1, winWords, aOff2_1, 4u, gl_CooperativeMatrixLayoutRowMajor);
					matC2_0 = coopMatMulAdd(matA,  matB, matC2_0);
					matC2_1 = coopMatMulAdd(matA1, matB, matC2_1);

					int yl3 = int(warp) + 12;
					uint aOff3_0 = uint((sliceBase + (yl3 * PY + 0 + dy) * WIN_W + dx) * 4);
					uint aOff3_1 = uint((sliceBase + (yl3 * PY + 1 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA,  winWords, aOff3_0, 4u, gl_CooperativeMatrixLayoutRowMajor);
					coopMatLoad(matA1, winWords, aOff3_1, 4u, gl_CooperativeMatrixLayoutRowMajor);
					matC3_0 = coopMatMulAdd(matA,  matB, matC3_0);
					matC3_1 = coopMatMulAdd(matA1, matB, matC3_1);
				}
#endif
#else
				// Non-pooled layers: pair row groups (r=0,1) and (r=2,3) across matA/matA1
				{
					int yl0 = int(warp);
					uint aOff0 = uint((sliceBase + (yl0 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA, winWords, aOff0, 4u, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_TILE_H >= 8
					int yl1 = int(warp) + int(gl_WorkGroupSize.x >> 5u);
					uint aOff1 = uint((sliceBase + (yl1 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA1, winWords, aOff1, 4u, gl_CooperativeMatrixLayoutRowMajor);
#endif
					matC0_0 = coopMatMulAdd(matA, matB, matC0_0);
#if LAYER_TILE_H >= 8
					matC1_0 = coopMatMulAdd(matA1, matB, matC1_0);
#endif
				}

#if LAYER_TILE_H >= 16
				if (gl_WorkGroupSize.x < 256u)
				{
					int yl2 = int(warp) + 8;
					int yl3 = int(warp) + 12;
					uint aOff2 = uint((sliceBase + (yl2 + dy) * WIN_W + dx) * 4);
					uint aOff3 = uint((sliceBase + (yl3 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA,  winWords, aOff2, 4u, gl_CooperativeMatrixLayoutRowMajor);
					coopMatLoad(matA1, winWords, aOff3, 4u, gl_CooperativeMatrixLayoutRowMajor);
					matC2_0 = coopMatMulAdd(matA,  matB, matC2_0);
					matC3_0 = coopMatMulAdd(matA1, matB, matC3_0);
				}
#endif
#endif
			}
#if STREAM_SLICE != 0
			barrier();
#else
			if (slice + 1 < LAYER_IN)
				barrier();
#endif
		}

#if RADV_REG_ONLY != 0
		const uint pCh = lane & 15u;
		const uvec4 sv = uScale.data[uint(z * 4) + (pCh >> 2u)];
		const uvec4 bv = uBias.data[uint(z * 4) + (pCh >> 2u)];
		const float sLane  = uintBitsToFloat(uvec4Comp(sv, int(pCh & 3u)));
		const float biLane = uintBitsToFloat(uvec4Comp(bv, int(pCh & 3u)));
#if LAYER_POOL != 0
		emitPoolRowRadv(0, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC0_0, matC0_1);
#if LAYER_TILE_H >= 8
		emitPoolRowRadv(1, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC1_0, matC1_1);
#endif
#if LAYER_TILE_H >= 16
		if (gl_WorkGroupSize.x < 256u)
		{
			emitPoolRowRadv(2, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC2_0, matC2_1);
			emitPoolRowRadv(3, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC3_0, matC3_1);
		}
#endif
#else
		emitPoolRowRadv(0, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC0_0);
#if LAYER_TILE_H >= 8
		emitPoolRowRadv(1, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC1_0);
#endif
#if LAYER_TILE_H >= 16
		if (gl_WorkGroupSize.x < 256u)
		{
			emitPoolRowRadv(2, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC2_0);
			emitPoolRowRadv(3, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC3_0);
		}
#endif
#endif
#else
		float s[16];
		float bi[16];
		for (int w = 0; w < 4; ++w)
		{
			uvec4 sv = uScale.data[uint(z * 4 + w)];
			uvec4 bv = uBias.data[uint(z * 4 + w)];
			s[w * 4 + 0]  = uintBitsToFloat(sv.x);
			s[w * 4 + 1]  = uintBitsToFloat(sv.y);
			s[w * 4 + 2]  = uintBitsToFloat(sv.z);
			s[w * 4 + 3]  = uintBitsToFloat(sv.w);
			bi[w * 4 + 0] = uintBitsToFloat(bv.x);
			bi[w * 4 + 1] = uintBitsToFloat(bv.y);
			bi[w * 4 + 2] = uintBitsToFloat(bv.z);
			bi[w * 4 + 3] = uintBitsToFloat(bv.w);
		}

		if (gl_WorkGroupSize.x >= 256u)
		{
#if LAYER_TILE_H >= 16
			const uint sAccWarp = warp & 3u;
			if (warp < 4u)
			{
				coopMatStore(matC0_0, sAcc, (sAccWarp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
				coopMatStore(matC0_1, sAcc, (sAccWarp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				emitPoolRow(0, z, X0, Y0, limitW, limitH, warp, sAccWarp, lane, s, bi, lo);
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				coopMatStore(matC1_0, sAcc, (sAccWarp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
				coopMatStore(matC1_1, sAcc, (sAccWarp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				emitPoolRow(1, z, X0, Y0, limitW, limitH, warp, sAccWarp, lane, s, bi, lo);
			}
			barrier();
			if (warp >= 4u)
			{
				coopMatStore(matC0_0, sAcc, (sAccWarp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
				coopMatStore(matC0_1, sAcc, (sAccWarp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				emitPoolRow(0, z, X0, Y0, limitW, limitH, warp, sAccWarp, lane, s, bi, lo);
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				coopMatStore(matC1_0, sAcc, (sAccWarp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
				coopMatStore(matC1_1, sAcc, (sAccWarp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				emitPoolRow(1, z, X0, Y0, limitW, limitH, warp, sAccWarp, lane, s, bi, lo);
			}
#endif
		}
		else
		{
			// Store & requantize r = 0 (per-warp sAcc region: subgroup sync avoids stalling all 4 warps)
			coopMatStore(matC0_0, sAcc, (warp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
			coopMatStore(matC0_1, sAcc, (warp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
			subgroupMemoryBarrierShared();
			subgroupBarrier();
			emitPoolRow(0, z, X0, Y0, limitW, limitH, warp, warp, lane, s, bi, lo);
#if LAYER_TILE_H >= 8
			subgroupMemoryBarrierShared();
			subgroupBarrier();

			// Store & requantize r = 1
			coopMatStore(matC1_0, sAcc, (warp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
			coopMatStore(matC1_1, sAcc, (warp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
			subgroupMemoryBarrierShared();
			subgroupBarrier();
			emitPoolRow(1, z, X0, Y0, limitW, limitH, warp, warp, lane, s, bi, lo);
#endif

#if LAYER_TILE_H >= 16
			subgroupMemoryBarrierShared();
			subgroupBarrier();

			// Store & requantize r = 2
			coopMatStore(matC2_0, sAcc, (warp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
			coopMatStore(matC2_1, sAcc, (warp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
			subgroupMemoryBarrierShared();
			subgroupBarrier();
			emitPoolRow(2, z, X0, Y0, limitW, limitH, warp, warp, lane, s, bi, lo);
			subgroupMemoryBarrierShared();
			subgroupBarrier();

			// Store & requantize r = 3
			coopMatStore(matC3_0, sAcc, (warp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
			coopMatStore(matC3_1, sAcc, (warp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
			subgroupMemoryBarrierShared();
			subgroupBarrier();
			emitPoolRow(3, z, X0, Y0, limitW, limitH, warp, warp, lane, s, bi, lo);
#endif
		}
#endif
	}

#else
	// ---- Family 2 (Flow: NIT = LAYER_IN, NOUT = LAYER_OUT, TILE_H = 8, NT = 4) ----
	const int Wd      = int(pc.words[0].z);
	const int Hd      = int(pc.words[0].w);
	const int Wout    = int(pc.words[1].x);
	const int Hout    = int(pc.words[1].y);
	const uint posMul = pc.words[2].y;
	const uint shifts = pc.words[2].z;
	const uint s1     = shifts & 31u;
	const uint s2     = (shifts >> 8u) & 31u;
	const int lim     = 1 << LAYER_ACC_BITS;
	const uvec2 swWg  = swizzleWorkGroup2D(gl_WorkGroupID.xy, gl_NumWorkGroups.xy);
	const int X0      = int(swWg.x) * 16;
	const int Y0      = int(swWg.y) * LAYER_TILE_H;
	const int n0      = int(gl_WorkGroupID.z) * LAYER_NT;
	const int limitW  = min(outSz.x, Wout);
	const int limitH  = min(outSz.y, Hout);

	coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0_0 =
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
	coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0_1 =
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
	coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC1_0 =
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
	coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC1_1 =
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);

	const ivec3 inSz = textureSize(uInput, 0);
	fillFlowWindow(0, X0, Y0, Wd, Hd, inSz, tid, 0u);
	stageFlowWeights(0, n0, tid, 0u);
	barrier();
	for (int step = 0; step < LAYER_IN; ++step)
	{
		const uint curBuf    = uint(step & 1);
		const uint winBufOff = curBuf * FLOW_WIN_BUF_WORDS;
		const uint wBufOff   = curBuf * FLOW_WSM_BUF_WORDS;
		if (step + 1 < LAYER_IN)
		{
			const uint nextBuf = curBuf ^ 1u;
			fillFlowWindow(step + 1, X0, Y0, Wd, Hd, inSz, tid, nextBuf);
			stageFlowWeights(step + 1, n0, tid, nextBuf);
		}

#if COOP_K_COMPILED == 32
		for (int tap = 0; tap < 6; ++tap)
		{
			int dy = tap >> 1;
			int dx = (tap & 1) * 2;
#else
		for (int tap = 0; tap < 9; ++tap)
		{
			int dy = tap / 3;
			int dx = tap % 3;
#endif

			// Load both row-group A tiles and both weight halves (matB/matB1) without WAW stalls
			uint aOff0 = winBufOff + uint(((int(warp) + 0 + dy) * WIN_W + dx) * 4);
			uint aOff1 = winBufOff + uint(((int(warp) + 4 + dy) * WIN_W + dx) * 4);
			coopMatLoad(matA,  winWords, aOff0, 4u, gl_CooperativeMatrixLayoutRowMajor);
			coopMatLoad(matA1, winWords, aOff1, 4u, gl_CooperativeMatrixLayoutRowMajor);
			coopMatLoad(matB,  wsmWords, wBufOff + uint(tap) * WSM_TAP_WORDS, WSM_COL_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
			coopMatLoad(matB1, wsmWords, wBufOff + WSM_BUF_WORDS + uint(tap) * WSM_TAP_WORDS, WSM_COL_STRIDE, gl_CooperativeMatrixLayoutColumnMajor);

			matC0_0 = coopMatMulAdd(matA,  matB,  matC0_0);
			matC1_0 = coopMatMulAdd(matA1, matB,  matC1_0);
			matC0_1 = coopMatMulAdd(matA,  matB1, matC0_1);
			matC1_1 = coopMatMulAdd(matA1, matB1, matC1_1);
		}
		if (step + 1 < LAYER_IN)
			barrier();
	}

	const uint roundPos = 1u << ((s1 + 31u) & 31u);
	const uint roundNeg = 1u << ((s2 + 31u) & 31u);

#if RADV_REG_ONLY != 0
	const int pCh = int(lane & 15u);
	const int ch0 = n0 * 8 + pCh;
	const int ch1 = n0 * 8 + 16 + pCh;
	const int ib0 = int(uvec4Comp(uScale.data[uint(ch0 >> 2)], ch0 & 3));
	const int ng0 = int(uvec4Comp(uBias.data[uint(ch0 >> 2)],  ch0 & 3));
	const int ib1 = int(uvec4Comp(uScale.data[uint(ch1 >> 2)], ch1 & 3));
	const int ng1 = int(uvec4Comp(uBias.data[uint(ch1 >> 2)],  ch1 & 3));
	emitFlowHalfRadv(0, 0, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, ib0, ng0, matC0_0);
	emitFlowHalfRadv(0, 1, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, ib1, ng1, matC0_1);
	emitFlowHalfRadv(1, 0, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, ib0, ng0, matC1_0);
	emitFlowHalfRadv(1, 1, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, ib1, ng1, matC1_1);
#else
	uvec4 flowScale[8];
	uvec4 flowBias[8];
	for (int h = 0; h < 2; ++h)
	{
		for (int w = 0; w < 4; ++w)
		{
			int ch4 = (n0 * 8 + h * 16) + w * 4;
			flowScale[h * 4 + w] = uScale.data[uint(ch4 >> 2)];
			flowBias[h * 4 + w]  = uBias.data[uint(ch4 >> 2)];
		}
	}


	// Emit r = 0, phased by half h = 0, 1 so sAcc stays 4 KB (per-warp subgroup sync)
	coopMatStore(matC0_0, sAcc, warp * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
	subgroupMemoryBarrierShared();
	subgroupBarrier();
	emitFlowHalf(0, 0, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, flowScale, flowBias);
	subgroupMemoryBarrierShared();
	subgroupBarrier();

	coopMatStore(matC0_1, sAcc, warp * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
	subgroupMemoryBarrierShared();
	subgroupBarrier();
	emitFlowHalf(0, 1, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, flowScale, flowBias);
	subgroupMemoryBarrierShared();
	subgroupBarrier();

	// Emit r = 1, phased by half h = 0, 1
	coopMatStore(matC1_0, sAcc, warp * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
	subgroupMemoryBarrierShared();
	subgroupBarrier();
	emitFlowHalf(1, 0, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, flowScale, flowBias);
	subgroupMemoryBarrierShared();
	subgroupBarrier();

	coopMatStore(matC1_1, sAcc, warp * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
	subgroupMemoryBarrierShared();
	subgroupBarrier();
	emitFlowHalf(1, 1, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, flowScale, flowBias);
#endif
#endif
}
