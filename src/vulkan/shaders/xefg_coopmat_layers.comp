// Exact port of Flow requantization from src/MfgPort/Cuda/xefg_cuda_layers.cu lines 533-538
// Uses hoisted uniform rounding constants and single-multiply branchless select (bit-exact for s1, s2 in [1, 31])
uint requantFlow(int a, int ib, int neg, int lim, uint posMul, uint s1, uint s2, uint roundPos, uint roundNeg)
{
	int clamped = clamp(a + ib, -lim, lim - 1);
	bool isPos  = clamped >= 0;
	uint mul    = isPos ? posMul   : uint(neg);
	uint rnd    = isPos ? roundPos : roundNeg;
	int  sh     = int(isPos ? s1   : s2);
	int  val    = int(uint(clamped) * mul + rnd) >> sh;
	return uint(clamp(val, -128, 127)) & 0xFFu;
}

void fillFlowWindow(int step, int X0, int Y0, int Wd, int Hd, ivec3 inSz, uint tid)
{
	for (uint e = tid; e < uint(WIN); e += gl_WorkGroupSize.x)
	{
		int x  = X0 - 1 + (int(e) % WIN_W);
		int ys = Y0 + (int(e) / WIN_W);
		uvec4 v = uvec4(0u);
		if (x >= 0 && x < Wd && ys >= 1 && ys <= Hd)
		{
#if LAYER_OUT == 8
			uvec4 a = fetchInput(x, ys, 2 * step, inSz);
			uvec4 b = fetchInput(x, ys, 2 * step + 1, inSz);
			v = uvec4(a.x, a.y, b.x, b.y);
#else
			v = fetchInput(x, ys, step, inSz);
#endif
		}
		winWords[e * 4u + 0u] = v.x;
		winWords[e * 4u + 1u] = v.y;
		winWords[e * 4u + 2u] = v.z;
		winWords[e * 4u + 3u] = v.w;
	}
}

// Stages weights for step `step` across NT = 4 tiles of 8 channels (two 16-channel halves h = 0, 1) into wsmWords
void stageFlowWeights(int step, int n0, uint tid)
{
	for (uint e = tid; e < uint(LAYER_NT * 72); e += gl_WorkGroupSize.x)
	{
		int nt    = int(e) / 72;
		int group = (int(e) % 72) / 36;
		int k     = int(e) % 36;
		int tap   = k / 4;
		int word  = k % 4;
		int ch    = (n0 + nt) * 8;
		int z     = ch / LAYER_OUT;
		int c     = ch % LAYER_OUT;
		uint idx  = uint(((z * LAYER_IN + step) * (LAYER_OUT / 4) + (c / 4) + group) * 36 + k);
		uvec4 v   = uWeights.data[idx];

		int h     = nt >> 1;
		int ocBase = (nt & 1) * 8 + group * 4;
		uint base = uint((h * 9 + tap) * 80 + ocBase * 5 + word);
		wsmWords[base + 0u * 5u] = v.x;
		wsmWords[base + 1u * 5u] = v.y;
		wsmWords[base + 2u * 5u] = v.z;
		wsmWords[base + 3u * 5u] = v.w;
	}
}

#if RADV_REG_ONLY == 0
void emitFlowHalf(int r, int h, int n0, int X0, int Y0, int limitW, int limitH,
                  int lim, uint posMul, uint s1, uint s2, uint roundPos, uint roundNeg,
                  uint warp, uint lane, uvec4 flowScale[8], uvec4 flowBias[8])
{
	int y = Y0 + int(warp) + r * 4;
	if (lane >= 16u || y >= limitH)
		return;

	int px = int(lane);
	int x = X0 + px;
	if (x >= limitW)
		return;

	uint baseAcc = warp * SACC_TILE + uint(px) * SACC_STRIDE;
	uint words[4];
	for (int w = 0; w < 4; ++w)
	{
		uvec4 bv = flowScale[h * 4 + w];
		uvec4 nv = flowBias[h * 4 + w];
		int ib[4] = { int(bv.x), int(bv.y), int(bv.z), int(bv.w) };
		int ng[4] = { int(nv.x), int(nv.y), int(nv.z), int(nv.w) };
		uint packed = 0u;
		for (int c = 0; c < 4; ++c)
		{
			int a = sAcc[baseAcc + uint(w * 4 + c)];
			packed |= requantFlow(a, ib[c], ng[c], lim, posMul, s1, s2, roundPos, roundNeg) << uint(c * 8);
		}
		words[w] = packed;
	}

#if LAYER_OUT == 8
	imageStore(uDst, ivec3(x, y + 1, n0 + h * 2 + 0), uvec4(words[0], words[1], words[0], words[0]));
	imageStore(uDst, ivec3(x, y + 1, n0 + h * 2 + 1), uvec4(words[2], words[3], words[2], words[2]));
#else
	imageStore(uDst, ivec3(x, y + 1, (n0 / 2) + h), uvec4(words[0], words[1], words[2], words[3]));
#endif
}
#else
void emitFlowHalfRadv(int r, int h, int n0, int X0, int Y0, int limitW, int limitH,
                      int lim, uint posMul, uint s1, uint s2, uint roundPos, uint roundNeg,
                      uint warp, uint lane, int ibLane, int ngLane,
                      coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC)
{
	int y = Y0 + int(warp) + r * 4;
	uint g = lane >> 4u;
	for (int i = 0; i < 8; ++i)
	{
		uint q = requantFlow(matC[i], ibLane, ngLane, lim, posMul, s1, s2, roundPos, roundNeg);
		uvec4 words = radvPack16Ch(q, lane);
		int x = X0 + int(g) + i * 2;
		if ((lane & 15u) == 0u && y < limitH && x < limitW)
		{
#if LAYER_OUT == 8
			imageStore(uDst, ivec3(x, y + 1, n0 + h * 2 + 0), uvec4(words.x, words.y, words.x, words.x));
			imageStore(uDst, ivec3(x, y + 1, n0 + h * 2 + 1), uvec4(words.z, words.w, words.z, words.z));
#else
			imageStore(uDst, ivec3(x, y + 1, (n0 / 2) + h), words);
#endif
		}
	}
}
#endif
#endif

// L2-cache-friendly 2D workgroup swizzle (vertical bands of 8 tiles = 128 px wide).
// Keeps 3x3 halo rows and weights hot in L2 across consecutive launches on RDNA 3/4.
// Exact bijection over [0..numWg.x-1] x [0..numWg.y-1] for any grid size (pure SGPR, 0 VGPR/LDS).
uvec2 swizzleWorkGroup2D(uvec2 wg, uvec2 numWg)
{
	const uint linear     = wg.y * numWg.x + wg.x;
	const uint bandW      = 8u;
	const uint fullBandsX = numWg.x & ~(bandW - 1u);
	const uint fullArea   = fullBandsX * numWg.y;
	if (linear < fullArea)
	{
		const uint bandArea = bandW * numWg.y;
		const uint band     = linear / bandArea;
		const uint rem      = linear - band * bandArea;
		return uvec2(band * bandW + (rem & (bandW - 1u)), rem >> 3u);
	}
	const uint remW = numWg.x - fullBandsX;
	const uint tail = linear - fullArea;
	return uvec2(fullBandsX + (tail % remW), tail / remW);
}

void main()
{
	const uint tid  = gl_LocalInvocationIndex;
	const uint warp = tid >> 5u;
	const uint lane = tid & 31u;
	ivec3 outSz = imageSize(uDst);

	coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matA;
	coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matA1;
	coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matB;

#if LAYER_FAMILY != 2
	// ---- Family 0 (PoolConv) & Family 1 (UpSkip Decoder) ----
	const uvec2 swWg = swizzleWorkGroup2D(gl_WorkGroupID.xy, gl_NumWorkGroups.xy);
	const int X0 = int(swWg.x) * ((LAYER_POOL != 0) ? 8 : 16);
	const int Y0 = int(swWg.y) * LAYER_TILE_H;
	const int limitW = outSz.x;
	const int limitH = outSz.y;
	const int lo = (LAYER_FAMILY == 1 || LAYER_RELU != 0) ? 0 : -128;

	const ivec3 inSz = textureSize(uInput, 0);
#if LAYER_FAMILY == 0
	const int cx0 = (LAYER_POOL != 0) ? (2 * X0) : X0;
	const int cy0 = (LAYER_POOL != 0) ? (2 * Y0) : Y0;
#if STREAM_SLICE == 0
	for (uint i = tid; i < uint(LAYER_IN * WIN); i += gl_WorkGroupSize.x)
	{
		int slice = int(i) / WIN;
		int r     = int(i) % WIN;
		uvec4 v   = fetchInput(cx0 - 1 + (r % WIN_W), cy0 - 1 + (r / WIN_W), slice, inSz);
#if LAYER_BIAS != 0
		v += uvec4(0x80808080u);
#endif
		winWords[i * 4u + 0u] = v.x;
		winWords[i * 4u + 1u] = v.y;
		winWords[i * 4u + 2u] = v.z;
		winWords[i * 4u + 3u] = v.w;
	}
	barrier();
#endif
#else
	const ivec3 skipSz = textureSize(uSkip, 0);
	const int Wd = int(pc.words[0].x);
	const int Hd = int(pc.words[0].y);
#if STREAM_SLICE == 0
	for (uint i = tid; i < uint(LAYER_IN * WIN); i += gl_WorkGroupSize.x)
	{
		int slice = int(i) / WIN;
		int r     = int(i) % WIN;
		int x     = X0 - 1 + (r % WIN_W);
		int y     = Y0 - 1 + (r / WIN_W);
		uvec4 res = uvec4(0u);
		if (x >= 0 && y >= 0 && x < Wd && y < Hd)
		{
			int xn = x >> 1;
			int yn = y >> 1;
			int xf = ((x & 1) != 0) ? (xn + 1) : (xn - 1);
			int yf = ((y & 1) != 0) ? (yn + 1) : (yn - 1);
			uvec4 a = fetchInput(xn, yn, slice, inSz);
			uvec4 b = fetchInput(xf, yn, slice, inSz);
			uvec4 c = fetchInput(xn, yf, slice, inSz);
			uvec4 d = fetchInput(xf, yf, slice, inSz);
			uvec4 s = fetchSkip(x, y, slice, skipSz);
			res = uvec4(
				upSkipBilinearWord(a.x, b.x, c.x, d.x, s.x),
				upSkipBilinearWord(a.y, b.y, c.y, d.y, s.y),
				upSkipBilinearWord(a.z, b.z, c.z, d.z, s.z),
				upSkipBilinearWord(a.w, b.w, c.w, d.w, s.w));
		}
		winWords[i * 4u + 0u] = res.x;
		winWords[i * 4u + 1u] = res.y;
		winWords[i * 4u + 2u] = res.z;
		winWords[i * 4u + 3u] = res.w;
	}
	barrier();
#endif
#endif

	const int zBegin = int(gl_WorkGroupID.z) * ZPER;
	for (int z = zBegin; z < zBegin + ZPER; ++z)
	{
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0_0 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#if LAYER_POOL != 0
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0_1 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#endif
#if LAYER_TILE_H >= 8
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC1_0 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#if LAYER_POOL != 0
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC1_1 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#endif
#endif
#if LAYER_TILE_H >= 16
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC2_0 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC3_0 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#if LAYER_POOL != 0
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC2_1 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC3_1 =
			coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
#endif
#endif

#if STREAM_SLICE == 0
		if (z > zBegin)
			barrier();
		stagePoolWeights(z * LAYER_IN, tid, 0u);
		barrier();
#endif

		for (int slice = 0; slice < LAYER_IN; ++slice)
		{
#if STREAM_SLICE != 0
#if LAYER_FAMILY == 0
			for (uint r = tid; r < uint(WIN); r += gl_WorkGroupSize.x)
			{
				uvec4 v = fetchInput(cx0 - 1 + (int(r) % WIN_W), cy0 - 1 + (int(r) / WIN_W), slice, inSz);
#if LAYER_BIAS != 0
				v += uvec4(0x80808080u);
#endif
				winWords[r * 4u + 0u] = v.x;
				winWords[r * 4u + 1u] = v.y;
				winWords[r * 4u + 2u] = v.z;
				winWords[r * 4u + 3u] = v.w;
			}
#else
			for (uint r = tid; r < uint(WIN); r += gl_WorkGroupSize.x)
			{
				int x = X0 - 1 + (int(r) % WIN_W);
				int y = Y0 - 1 + (int(r) / WIN_W);
				uvec4 res = uvec4(0u);
				if (x >= 0 && y >= 0 && x < Wd && y < Hd)
				{
					int xn = x >> 1;
					int yn = y >> 1;
					int xf = ((x & 1) != 0) ? (xn + 1) : (xn - 1);
					int yf = ((y & 1) != 0) ? (yn + 1) : (yn - 1);
					uvec4 a = fetchInput(xn, yn, slice, inSz);
					uvec4 b = fetchInput(xf, yn, slice, inSz);
					uvec4 c = fetchInput(xn, yf, slice, inSz);
					uvec4 d = fetchInput(xf, yf, slice, inSz);
					uvec4 s = fetchSkip(x, y, slice, skipSz);
					res = uvec4(
						upSkipBilinearWord(a.x, b.x, c.x, d.x, s.x),
						upSkipBilinearWord(a.y, b.y, c.y, d.y, s.y),
						upSkipBilinearWord(a.z, b.z, c.z, d.z, s.z),
						upSkipBilinearWord(a.w, b.w, c.w, d.w, s.w));
				}
				winWords[r * 4u + 0u] = res.x;
				winWords[r * 4u + 1u] = res.y;
				winWords[r * 4u + 2u] = res.z;
				winWords[r * 4u + 3u] = res.w;
			}
#endif
#endif
#if STREAM_SLICE != 0
			stagePoolWeights(z * LAYER_IN + slice, tid, 0u);
			barrier();
			const uint wBufOff = 0u;
#else
			const uint curBuf = uint(slice & 1);
			const uint wBufOff = curBuf * 720u;
			if (slice + 1 < LAYER_IN)
				stagePoolWeights(z * LAYER_IN + slice + 1, tid, curBuf ^ 1u);
#endif

			int sliceBase = (STREAM_SLICE != 0) ? 0 : (slice * WIN);
			for (int tap = 0; tap < 9; ++tap)
			{
				int dy = tap / 3;
				int dx = tap % 3;
				coopMatLoad(matB, wsmWords, wBufOff + uint(tap * 80), 5u, gl_CooperativeMatrixLayoutColumnMajor);

#if LAYER_POOL != 0
				// Row group r = 0 (yl = warp + 0): ping-pong matA/matA1 to overlap LDS loads with WMMA
				{
					int yl = int(warp);
					uint aOff0 = uint((sliceBase + (yl * PY + 0 + dy) * WIN_W + dx) * 4);
					uint aOff1 = uint((sliceBase + (yl * PY + 1 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA,  winWords, aOff0, 4u, gl_CooperativeMatrixLayoutRowMajor);
					coopMatLoad(matA1, winWords, aOff1, 4u, gl_CooperativeMatrixLayoutRowMajor);
					matC0_0 = coopMatMulAdd(matA,  matB, matC0_0);
					matC0_1 = coopMatMulAdd(matA1, matB, matC0_1);
				}

#if LAYER_TILE_H >= 8
				// Row group r = 1 (yl = warp + 4 for 128 threads, warp + 8 for 256 threads)
				{
					int yl = int(warp) + int(gl_WorkGroupSize.x >> 5u);
					uint aOff0 = uint((sliceBase + (yl * PY + 0 + dy) * WIN_W + dx) * 4);
					uint aOff1 = uint((sliceBase + (yl * PY + 1 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA,  winWords, aOff0, 4u, gl_CooperativeMatrixLayoutRowMajor);
					coopMatLoad(matA1, winWords, aOff1, 4u, gl_CooperativeMatrixLayoutRowMajor);
					matC1_0 = coopMatMulAdd(matA,  matB, matC1_0);
					matC1_1 = coopMatMulAdd(matA1, matB, matC1_1);
				}
#endif

#if LAYER_TILE_H >= 16
				// Row group r = 2 and r = 3 (only needed when 4 warps cover 16 rows)
				if (gl_WorkGroupSize.x < 256u)
				{
					int yl2 = int(warp) + 8;
					uint aOff2_0 = uint((sliceBase + (yl2 * PY + 0 + dy) * WIN_W + dx) * 4);
					uint aOff2_1 = uint((sliceBase + (yl2 * PY + 1 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA,  winWords, aOff2_0, 4u, gl_CooperativeMatrixLayoutRowMajor);
					coopMatLoad(matA1, winWords, aOff2_1, 4u, gl_CooperativeMatrixLayoutRowMajor);
					matC2_0 = coopMatMulAdd(matA,  matB, matC2_0);
					matC2_1 = coopMatMulAdd(matA1, matB, matC2_1);

					int yl3 = int(warp) + 12;
					uint aOff3_0 = uint((sliceBase + (yl3 * PY + 0 + dy) * WIN_W + dx) * 4);
					uint aOff3_1 = uint((sliceBase + (yl3 * PY + 1 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA,  winWords, aOff3_0, 4u, gl_CooperativeMatrixLayoutRowMajor);
					coopMatLoad(matA1, winWords, aOff3_1, 4u, gl_CooperativeMatrixLayoutRowMajor);
					matC3_0 = coopMatMulAdd(matA,  matB, matC3_0);
					matC3_1 = coopMatMulAdd(matA1, matB, matC3_1);
				}
#endif
#else
				// Non-pooled layers: pair row groups (r=0,1) and (r=2,3) across matA/matA1
				{
					int yl0 = int(warp);
					uint aOff0 = uint((sliceBase + (yl0 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA, winWords, aOff0, 4u, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_TILE_H >= 8
					int yl1 = int(warp) + int(gl_WorkGroupSize.x >> 5u);
					uint aOff1 = uint((sliceBase + (yl1 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA1, winWords, aOff1, 4u, gl_CooperativeMatrixLayoutRowMajor);
#endif
					matC0_0 = coopMatMulAdd(matA, matB, matC0_0);
#if LAYER_TILE_H >= 8
					matC1_0 = coopMatMulAdd(matA1, matB, matC1_0);
#endif
				}

#if LAYER_TILE_H >= 16
				if (gl_WorkGroupSize.x < 256u)
				{
					int yl2 = int(warp) + 8;
					int yl3 = int(warp) + 12;
					uint aOff2 = uint((sliceBase + (yl2 + dy) * WIN_W + dx) * 4);
					uint aOff3 = uint((sliceBase + (yl3 + dy) * WIN_W + dx) * 4);
					coopMatLoad(matA,  winWords, aOff2, 4u, gl_CooperativeMatrixLayoutRowMajor);
					coopMatLoad(matA1, winWords, aOff3, 4u, gl_CooperativeMatrixLayoutRowMajor);
					matC2_0 = coopMatMulAdd(matA,  matB, matC2_0);
					matC3_0 = coopMatMulAdd(matA1, matB, matC3_0);
				}
#endif
#endif
			}
#if STREAM_SLICE != 0
			barrier();
#else
			if (slice + 1 < LAYER_IN)
				barrier();
#endif
		}

#if RADV_REG_ONLY != 0
		const uint pCh = lane & 15u;
		const uvec4 sv = uScale.data[uint(z * 4) + (pCh >> 2u)];
		const uvec4 bv = uBias.data[uint(z * 4) + (pCh >> 2u)];
		const float sLane  = uintBitsToFloat(uvec4Comp(sv, int(pCh & 3u)));
		const float biLane = uintBitsToFloat(uvec4Comp(bv, int(pCh & 3u)));
#if LAYER_POOL != 0
		emitPoolRowRadv(0, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC0_0, matC0_1);
#if LAYER_TILE_H >= 8
		emitPoolRowRadv(1, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC1_0, matC1_1);
#endif
#if LAYER_TILE_H >= 16
		if (gl_WorkGroupSize.x < 256u)
		{
			emitPoolRowRadv(2, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC2_0, matC2_1);
			emitPoolRowRadv(3, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC3_0, matC3_1);
		}
#endif
#else
		emitPoolRowRadv(0, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC0_0);
#if LAYER_TILE_H >= 8
		emitPoolRowRadv(1, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC1_0);
#endif
#if LAYER_TILE_H >= 16
		if (gl_WorkGroupSize.x < 256u)
		{
			emitPoolRowRadv(2, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC2_0);
			emitPoolRowRadv(3, z, X0, Y0, limitW, limitH, warp, lane, sLane, biLane, lo, matC3_0);
		}
#endif
#endif
#else
		float s[16];
		float bi[16];
		for (int w = 0; w < 4; ++w)
		{
			uvec4 sv = uScale.data[uint(z * 4 + w)];
			uvec4 bv = uBias.data[uint(z * 4 + w)];
			s[w * 4 + 0]  = uintBitsToFloat(sv.x);
			s[w * 4 + 1]  = uintBitsToFloat(sv.y);
			s[w * 4 + 2]  = uintBitsToFloat(sv.z);
			s[w * 4 + 3]  = uintBitsToFloat(sv.w);
			bi[w * 4 + 0] = uintBitsToFloat(bv.x);
			bi[w * 4 + 1] = uintBitsToFloat(bv.y);
			bi[w * 4 + 2] = uintBitsToFloat(bv.z);
			bi[w * 4 + 3] = uintBitsToFloat(bv.w);
		}

		if (gl_WorkGroupSize.x >= 256u)
		{
#if LAYER_TILE_H >= 16
			const uint sAccWarp = warp & 3u;
			if (warp < 4u)
			{
				coopMatStore(matC0_0, sAcc, (sAccWarp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
				coopMatStore(matC0_1, sAcc, (sAccWarp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				emitPoolRow(0, z, X0, Y0, limitW, limitH, warp, sAccWarp, lane, s, bi, lo);
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				coopMatStore(matC1_0, sAcc, (sAccWarp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
				coopMatStore(matC1_1, sAcc, (sAccWarp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				emitPoolRow(1, z, X0, Y0, limitW, limitH, warp, sAccWarp, lane, s, bi, lo);
			}
			barrier();
			if (warp >= 4u)
			{
				coopMatStore(matC0_0, sAcc, (sAccWarp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
				coopMatStore(matC0_1, sAcc, (sAccWarp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				emitPoolRow(0, z, X0, Y0, limitW, limitH, warp, sAccWarp, lane, s, bi, lo);
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				coopMatStore(matC1_0, sAcc, (sAccWarp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
				coopMatStore(matC1_1, sAcc, (sAccWarp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
				subgroupMemoryBarrierShared();
				subgroupBarrier();
				emitPoolRow(1, z, X0, Y0, limitW, limitH, warp, sAccWarp, lane, s, bi, lo);
			}
#endif
		}
		else
		{
			// Store & requantize r = 0 (per-warp sAcc region: subgroup sync avoids stalling all 4 warps)
			coopMatStore(matC0_0, sAcc, (warp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
			coopMatStore(matC0_1, sAcc, (warp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
			subgroupMemoryBarrierShared();
			subgroupBarrier();
			emitPoolRow(0, z, X0, Y0, limitW, limitH, warp, warp, lane, s, bi, lo);
#if LAYER_TILE_H >= 8
			subgroupMemoryBarrierShared();
			subgroupBarrier();

			// Store & requantize r = 1
			coopMatStore(matC1_0, sAcc, (warp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
			coopMatStore(matC1_1, sAcc, (warp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
			subgroupMemoryBarrierShared();
			subgroupBarrier();
			emitPoolRow(1, z, X0, Y0, limitW, limitH, warp, warp, lane, s, bi, lo);
#endif

#if LAYER_TILE_H >= 16
			subgroupMemoryBarrierShared();
			subgroupBarrier();

			// Store & requantize r = 2
			coopMatStore(matC2_0, sAcc, (warp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
			coopMatStore(matC2_1, sAcc, (warp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
			subgroupMemoryBarrierShared();
			subgroupBarrier();
			emitPoolRow(2, z, X0, Y0, limitW, limitH, warp, warp, lane, s, bi, lo);
			subgroupMemoryBarrierShared();
			subgroupBarrier();

			// Store & requantize r = 3
			coopMatStore(matC3_0, sAcc, (warp * uint(PY) + 0u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if LAYER_POOL != 0
			coopMatStore(matC3_1, sAcc, (warp * uint(PY) + 1u) * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
			subgroupMemoryBarrierShared();
			subgroupBarrier();
			emitPoolRow(3, z, X0, Y0, limitW, limitH, warp, warp, lane, s, bi, lo);
#endif
		}
#endif
	}

#else
	// ---- Family 2 (Flow: NIT = LAYER_IN, NOUT = LAYER_OUT, TILE_H = 8, NT = 4) ----
	const int Wd      = int(pc.words[0].z);
	const int Hd      = int(pc.words[0].w);
	const int Wout    = int(pc.words[1].x);
	const int Hout    = int(pc.words[1].y);
	const uint posMul = pc.words[2].y;
	const uint shifts = pc.words[2].z;
	const uint s1     = shifts & 31u;
	const uint s2     = (shifts >> 8u) & 31u;
	const int lim     = 1 << LAYER_ACC_BITS;
	const uvec2 swWg  = swizzleWorkGroup2D(gl_WorkGroupID.xy, gl_NumWorkGroups.xy);
	const int X0      = int(swWg.x) * 16;
	const int Y0      = int(swWg.y) * LAYER_TILE_H;
	const int n0      = int(gl_WorkGroupID.z) * LAYER_NT;
	const int limitW  = min(outSz.x, Wout);
	const int limitH  = min(outSz.y, Hout);

	coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0_0 =
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
	coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC0_1 =
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
	coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC1_0 =
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
	coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC1_1 =
		coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);

	const ivec3 inSz = textureSize(uInput, 0);
	for (int step = 0; step < LAYER_IN; ++step)
	{
		fillFlowWindow(step, X0, Y0, Wd, Hd, inSz, tid);
		stageFlowWeights(step, n0, tid);
		barrier();

		for (int tap = 0; tap < 9; ++tap)
		{
			int dy = tap / 3;
			int dx = tap % 3;

			// Load both row-group A tiles once and reuse each weight half B across r=0 and r=1 (50% fewer B loads)
			uint aOff0 = uint(((int(warp) + 0 + dy) * WIN_W + dx) * 4);
			uint aOff1 = uint(((int(warp) + 4 + dy) * WIN_W + dx) * 4);
			coopMatLoad(matA,  winWords, aOff0, 4u, gl_CooperativeMatrixLayoutRowMajor);
			coopMatLoad(matA1, winWords, aOff1, 4u, gl_CooperativeMatrixLayoutRowMajor);

			coopMatLoad(matB, wsmWords, uint((0 * 9 + tap) * 80), 5u, gl_CooperativeMatrixLayoutColumnMajor);
			matC0_0 = coopMatMulAdd(matA,  matB, matC0_0);
			matC1_0 = coopMatMulAdd(matA1, matB, matC1_0);

			coopMatLoad(matB, wsmWords, uint((1 * 9 + tap) * 80), 5u, gl_CooperativeMatrixLayoutColumnMajor);
			matC0_1 = coopMatMulAdd(matA,  matB, matC0_1);
			matC1_1 = coopMatMulAdd(matA1, matB, matC1_1);
		}
		barrier();
	}

	const uint roundPos = 1u << ((s1 + 31u) & 31u);
	const uint roundNeg = 1u << ((s2 + 31u) & 31u);

#if RADV_REG_ONLY != 0
	const int pCh = int(lane & 15u);
	const int ch0 = n0 * 8 + pCh;
	const int ch1 = n0 * 8 + 16 + pCh;
	const int ib0 = int(uvec4Comp(uScale.data[uint(ch0 >> 2)], ch0 & 3));
	const int ng0 = int(uvec4Comp(uBias.data[uint(ch0 >> 2)],  ch0 & 3));
	const int ib1 = int(uvec4Comp(uScale.data[uint(ch1 >> 2)], ch1 & 3));
	const int ng1 = int(uvec4Comp(uBias.data[uint(ch1 >> 2)],  ch1 & 3));
	emitFlowHalfRadv(0, 0, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, ib0, ng0, matC0_0);
	emitFlowHalfRadv(0, 1, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, ib1, ng1, matC0_1);
	emitFlowHalfRadv(1, 0, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, ib0, ng0, matC1_0);
	emitFlowHalfRadv(1, 1, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, ib1, ng1, matC1_1);
#else
	uvec4 flowScale[8];
	uvec4 flowBias[8];
	for (int h = 0; h < 2; ++h)
	{
		for (int w = 0; w < 4; ++w)
		{
			int ch4 = (n0 * 8 + h * 16) + w * 4;
			flowScale[h * 4 + w] = uScale.data[uint(ch4 >> 2)];
			flowBias[h * 4 + w]  = uBias.data[uint(ch4 >> 2)];
		}
	}


	// Emit r = 0, phased by half h = 0, 1 so sAcc stays 4 KB (per-warp subgroup sync)
	coopMatStore(matC0_0, sAcc, warp * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
	subgroupMemoryBarrierShared();
	subgroupBarrier();
	emitFlowHalf(0, 0, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, flowScale, flowBias);
	subgroupMemoryBarrierShared();
	subgroupBarrier();

	coopMatStore(matC0_1, sAcc, warp * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
	subgroupMemoryBarrierShared();
	subgroupBarrier();
	emitFlowHalf(0, 1, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, flowScale, flowBias);
	subgroupMemoryBarrierShared();
	subgroupBarrier();

	// Emit r = 1, phased by half h = 0, 1
	coopMatStore(matC1_0, sAcc, warp * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
	subgroupMemoryBarrierShared();
	subgroupBarrier();
	emitFlowHalf(1, 0, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, flowScale, flowBias);
	subgroupMemoryBarrierShared();
	subgroupBarrier();

	coopMatStore(matC1_1, sAcc, warp * SACC_TILE, SACC_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
	subgroupMemoryBarrierShared();
	subgroupBarrier();
	emitFlowHalf(1, 1, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, roundPos, roundNeg, warp, lane, flowScale, flowBias);
#endif
#endif
}
