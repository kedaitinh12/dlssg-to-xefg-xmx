@@ -0,0 +1,796 @@
+// SPDX-License-Identifier: MIT
+//
+// Full 9-tap 3x3 INT8 convolution GLSL compute shader template for XeFG's 17 ported INT8 layers
+// using VK_KHR_cooperative_matrix 8x8x32 (SINT8 x SINT8 -> SINT32) with SIMD16 subgroups
+// on Intel Arc (Alchemist Xe-HPG) and Intel Battlemage (Xe2) XMX on Vulkan.
+//
+// Mapping onto 8x8x32 XMX tiles with 128 threads = 8 SIMD16 subgroups:
+//   - Subgroup sg = tid >> 4 (0..7) splits into rowSlot = sg >> 1 (0..3) and xHalf = sg & 1 (0 = px 0..7, 1 = px 8..15).
+//   - Each subgroup computes 8 pixels (M = 8) x 16 output channels (two N = 8 halves: oc 0..7 and oc 8..15).
+//   - K = 32 packs two adjacent 16-channel horizontal taps per step with stride = 4 uint32 (zero winWords repacking):
+//       step 0: taps (0, 1)  [dy=0, dx=0..1]
+//       step 1: tap  (2, 0)  [dy=0, dx=2 + zero-padded upper K=16..31 in B]
+//       step 2: taps (3, 4)  [dy=1, dx=0..1]
+//       step 3: tap  (5, 0)  [dy=1, dx=2 + zero-padded upper K=16..31 in B]
+//       step 4: taps (6, 7)  [dy=2, dx=0..1]
+//       step 5: tap  (8, 0)  [dy=2, dx=2 + zero-padded upper K=16..31 in B]
+//   - 4 trailing padding words on winWords keep dx=2 upper-half K=16..31 loads in-bounds while B zeros them out.
+//
+// Compiled per layer via tools/GenerateXeFgCoopMat.py into <output>/xmx_8x8x32/<kernel>.spv (and <program>.spv).
+#version 460
+#extension GL_KHR_memory_scope_semantics : enable
+#extension GL_KHR_cooperative_matrix : enable
+#extension GL_EXT_shader_explicit_arithmetic_types : enable
+#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : enable
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
+#extension GL_KHR_shader_subgroup_basic : enable
+#extension GL_EXT_samplerless_texture_functions : enable
+
+layout(constant_id = 0) const uint COOP_M = 8;
+layout(constant_id = 1) const uint COOP_N = 8;
+layout(constant_id = 2) const uint COOP_K = 32;
+layout(constant_id = 3) const uint SUBGROUP_SIZE = 16;
+
+#ifndef LAYER_FAMILY
+#define LAYER_FAMILY 0
+#endif
+#ifndef LAYER_IN
+#define LAYER_IN 1
+#endif
+#ifndef LAYER_OUT
+#define LAYER_OUT 1
+#endif
+#ifndef LAYER_BIAS
+#define LAYER_BIAS 0
+#endif
+#ifndef LAYER_POOL
+#define LAYER_POOL 0
+#endif
+#ifndef LAYER_RELU
+#define LAYER_RELU 0
+#endif
+#ifndef LAYER_TILE_H
+#define LAYER_TILE_H 16
+#endif
+#ifndef LAYER_ZSPLIT
+#define LAYER_ZSPLIT 1
+#endif
+#ifndef LAYER_ACC_BITS
+#define LAYER_ACC_BITS 16
+#endif
+#ifndef LAYER_NT
+#define LAYER_NT 4
+#endif
+
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(set = 0, binding = 0) uniform utexture2DArray uInput;
+layout(set = 0, binding = 1, std430) readonly buffer WeightBuf { uvec4 data[]; } uWeights;
+layout(set = 0, binding = 2, std430) readonly buffer ScaleBuf  { uvec4 data[]; } uScale;
+layout(set = 0, binding = 3, std430) readonly buffer BiasBuf   { uvec4 data[]; } uBias;
+#if LAYER_FAMILY == 1
