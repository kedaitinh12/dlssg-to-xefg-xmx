+						upSkipBilinearWord(a.w, b.w, c.w, d.w, s.w));
+				}
+				winWords[r * 4u + 0u] = res.x;
+				winWords[r * 4u + 1u] = res.y;
+				winWords[r * 4u + 2u] = res.z;
+				winWords[r * 4u + 3u] = res.w;
+			}
+#endif
+#endif
+			stagePoolWeights(z * LAYER_IN + slice, tid);
+			barrier();
+
+			int sliceBase = (STREAM_SLICE != 0) ? 0 : (slice * WIN);
+			for (int kStep = 0; kStep < 6; ++kStep)
+			{
+				int dy = kStep >> 1;
+				int dx = (kStep & 1) * 2;
+				coopMatLoad(matB0, wsmWords, uint(kStep * 128 + 0),  8u, gl_CooperativeMatrixLayoutColumnMajor);
+				coopMatLoad(matB1, wsmWords, uint(kStep * 128 + 64), 8u, gl_CooperativeMatrixLayoutColumnMajor);
+
+				// Row group r = 0
+				{
+					int yl = int(rowSlot);
+					uint aOff0 = uint((sliceBase + (yl * PY + 0 + dy) * WIN_W + xOff + dx) * 4);
+					coopMatLoad(matA, winWords, aOff0, 4u, gl_CooperativeMatrixLayoutRowMajor);
+					matC0_0_lo = coopMatMulAdd(matA, matB0, matC0_0_lo);
+					matC0_0_hi = coopMatMulAdd(matA, matB1, matC0_0_hi);
+#if LAYER_POOL != 0
+					uint aOff1 = uint((sliceBase + (yl * PY + 1 + dy) * WIN_W + xOff + dx) * 4);
+					coopMatLoad(matA, winWords, aOff1, 4u, gl_CooperativeMatrixLayoutRowMajor);
+					matC0_1_lo = coopMatMulAdd(matA, matB0, matC0_1_lo);
+					matC0_1_hi = coopMatMulAdd(matA, matB1, matC0_1_hi);
+#endif
+				}
+
+#if LAYER_TILE_H >= 8
+				// Row group r = 1
+				{
+					int yl = int(rowSlot) + 4;
+					uint aOff0 = uint((sliceBase + (yl * PY + 0 + dy) * WIN_W + xOff + dx) * 4);
+					coopMatLoad(matA, winWords, aOff0, 4u, gl_CooperativeMatrixLayoutRowMajor);
+					matC1_0_lo = coopMatMulAdd(matA, matB0, matC1_0_lo);
+					matC1_0_hi = coopMatMulAdd(matA, matB1, matC1_0_hi);
+#if LAYER_POOL != 0
+					uint aOff1 = uint((sliceBase + (yl * PY + 1 + dy) * WIN_W + xOff + dx) * 4);
+					coopMatLoad(matA, winWords, aOff1, 4u, gl_CooperativeMatrixLayoutRowMajor);
+					matC1_1_lo = coopMatMulAdd(matA, matB0, matC1_1_lo);
+					matC1_1_hi = coopMatMulAdd(matA, matB1, matC1_1_hi);
+#endif
+				}
+#endif
+
+#if LAYER_TILE_H >= 16
+				// Row groups r = 2 and r = 3
+				{
+					int yl2 = int(rowSlot) + 8;
+					uint aOff2_0 = uint((sliceBase + (yl2 * PY + 0 + dy) * WIN_W + xOff + dx) * 4);
+					coopMatLoad(matA, winWords, aOff2_0, 4u, gl_CooperativeMatrixLayoutRowMajor);
+					matC2_0_lo = coopMatMulAdd(matA, matB0, matC2_0_lo);
+					matC2_0_hi = coopMatMulAdd(matA, matB1, matC2_0_hi);
+#if LAYER_POOL != 0
+					uint aOff2_1 = uint((sliceBase + (yl2 * PY + 1 + dy) * WIN_W + xOff + dx) * 4);
+					coopMatLoad(matA, winWords, aOff2_1, 4u, gl_CooperativeMatrixLayoutRowMajor);
+					matC2_1_lo = coopMatMulAdd(matA, matB0, matC2_1_lo);
+					matC2_1_hi = coopMatMulAdd(matA, matB1, matC2_1_hi);
+#endif
+					int yl3 = int(rowSlot) + 12;
+					uint aOff3_0 = uint((sliceBase + (yl3 * PY + 0 + dy) * WIN_W + xOff + dx) * 4);
+					coopMatLoad(matA, winWords, aOff3_0, 4u, gl_CooperativeMatrixLayoutRowMajor);
+					matC3_0_lo = coopMatMulAdd(matA, matB0, matC3_0_lo);
+					matC3_0_hi = coopMatMulAdd(matA, matB1, matC3_0_hi);
+#if LAYER_POOL != 0
+					uint aOff3_1 = uint((sliceBase + (yl3 * PY + 1 + dy) * WIN_W + xOff + dx) * 4);
+					coopMatLoad(matA, winWords, aOff3_1, 4u, gl_CooperativeMatrixLayoutRowMajor);
+					matC3_1_lo = coopMatMulAdd(matA, matB0, matC3_1_lo);
+					matC3_1_hi = coopMatMulAdd(matA, matB1, matC3_1_hi);
+#endif
+				}
+#endif
+			}
+			barrier();
+		}
+
+		float s[16];
+		float bi[16];
+		for (int w = 0; w < 4; ++w)
+		{
+			uvec4 sv = uScale.data[uint(z * 4 + w)];
+			uvec4 bv = uBias.data[uint(z * 4 + w)];
+			s[w * 4 + 0]  = uintBitsToFloat(sv.x);
+			s[w * 4 + 1]  = uintBitsToFloat(sv.y);
+			s[w * 4 + 2]  = uintBitsToFloat(sv.z);
+			s[w * 4 + 3]  = uintBitsToFloat(sv.w);
+			bi[w * 4 + 0] = uintBitsToFloat(bv.x);
+			bi[w * 4 + 1] = uintBitsToFloat(bv.y);
+			bi[w * 4 + 2] = uintBitsToFloat(bv.z);
+			bi[w * 4 + 3] = uintBitsToFloat(bv.w);
+		}
+
+		// Store & requantize r = 0 (stride = 16 ints/row, lo at +0, hi at +8)
+		coopMatStore(matC0_0_lo, sAcc, (sg * uint(PY) + 0u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+		coopMatStore(matC0_0_hi, sAcc, (sg * uint(PY) + 0u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+#if LAYER_POOL != 0
+		coopMatStore(matC0_1_lo, sAcc, (sg * uint(PY) + 1u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+		coopMatStore(matC0_1_hi, sAcc, (sg * uint(PY) + 1u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+#endif
+		subgroupMemoryBarrierShared();
+		subgroupBarrier();
+		emitPoolRow(0, z, X0, Y0, limitW, limitH, sg, rowSlot, xHalf, lane, s, bi, lo);
+#if LAYER_TILE_H >= 8
+		subgroupMemoryBarrierShared();
+		subgroupBarrier();
+		coopMatStore(matC1_0_lo, sAcc, (sg * uint(PY) + 0u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+		coopMatStore(matC1_0_hi, sAcc, (sg * uint(PY) + 0u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+#if LAYER_POOL != 0
+		coopMatStore(matC1_1_lo, sAcc, (sg * uint(PY) + 1u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+		coopMatStore(matC1_1_hi, sAcc, (sg * uint(PY) + 1u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+#endif
+		subgroupMemoryBarrierShared();
+		subgroupBarrier();
+		emitPoolRow(1, z, X0, Y0, limitW, limitH, sg, rowSlot, xHalf, lane, s, bi, lo);
+#endif
+#if LAYER_TILE_H >= 16
+		subgroupMemoryBarrierShared();
+		subgroupBarrier();
+		coopMatStore(matC2_0_lo, sAcc, (sg * uint(PY) + 0u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+		coopMatStore(matC2_0_hi, sAcc, (sg * uint(PY) + 0u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+#if LAYER_POOL != 0
+		coopMatStore(matC2_1_lo, sAcc, (sg * uint(PY) + 1u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+		coopMatStore(matC2_1_hi, sAcc, (sg * uint(PY) + 1u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+#endif
+		subgroupMemoryBarrierShared();
+		subgroupBarrier();
+		emitPoolRow(2, z, X0, Y0, limitW, limitH, sg, rowSlot, xHalf, lane, s, bi, lo);
+		subgroupMemoryBarrierShared();
+		subgroupBarrier();
+		coopMatStore(matC3_0_lo, sAcc, (sg * uint(PY) + 0u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+		coopMatStore(matC3_0_hi, sAcc, (sg * uint(PY) + 0u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+#if LAYER_POOL != 0
+		coopMatStore(matC3_1_lo, sAcc, (sg * uint(PY) + 1u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+		coopMatStore(matC3_1_hi, sAcc, (sg * uint(PY) + 1u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+#endif
+		subgroupMemoryBarrierShared();
+		subgroupBarrier();
+		emitPoolRow(3, z, X0, Y0, limitW, limitH, sg, rowSlot, xHalf, lane, s, bi, lo);
+#endif
+	}
+
+#else
+	const int Wd      = int(pc.words[0].z);
+	const int Hd      = int(pc.words[0].w);
+	const int Wout    = int(pc.words[1].x);
+	const int Hout    = int(pc.words[1].y);
+	const uint posMul = pc.words[2].y;
+	const uint shifts = pc.words[2].z;
+	const uint s1     = shifts & 31u;
+	const uint s2     = (shifts >> 8u) & 31u;
+	const int lim     = 1 << LAYER_ACC_BITS;
+	const int X0      = int(gl_WorkGroupID.x) * 16;
+	const int Y0      = int(gl_WorkGroupID.y) * LAYER_TILE_H;
+	const int n0      = int(gl_WorkGroupID.z) * LAYER_NT;
+	const int limitW  = min(outSz.x, Wout);
+	const int limitH  = min(outSz.y, Hout);
+	const ivec3 inSz  = textureSize(uInput, 0);
+
+	coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> matC0_0_lo =
+		coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0);
+	coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> matC0_0_hi =
+		coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0);
+	coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> matC0_1_lo =
+		coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0);
+	coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> matC0_1_hi =
+		coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0);
+	coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> matC1_0_lo =
+		coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0);
+	coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> matC1_0_hi =
+		coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0);
+	coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> matC1_1_lo =
+		coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0);
+	coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator> matC1_1_hi =
+		coopmat<int32_t, gl_ScopeSubgroup, 8, 8, gl_MatrixUseAccumulator>(0);
+
+	coopmat<int8_t, gl_ScopeSubgroup, 8, 32, gl_MatrixUseA> matA1;
+	for (int step = 0; step < LAYER_IN; ++step)
+	{
+		fillFlowWindow(step, X0, Y0, Wd, Hd, inSz, tid);
+		stageFlowWeights(step, n0, tid);
+		barrier();
+
+		for (int kStep = 0; kStep < 6; ++kStep)
+		{
+			int dy = kStep >> 1;
+			int dx = (kStep & 1) * 2;
+			uint aOff0 = uint(((int(rowSlot) + 0 + dy) * WIN_W + xOff + dx) * 4);
+			uint aOff1 = uint(((int(rowSlot) + 4 + dy) * WIN_W + xOff + dx) * 4);
+			coopMatLoad(matA,  winWords, aOff0, 4u, gl_CooperativeMatrixLayoutRowMajor);
+			coopMatLoad(matA1, winWords, aOff1, 4u, gl_CooperativeMatrixLayoutRowMajor);
+
+			// Output half h = 0 (oc 0..15)
+			coopMatLoad(matB0, wsmWords, uint((0 * 6 + kStep) * 128 + 0),  8u, gl_CooperativeMatrixLayoutColumnMajor);
+			coopMatLoad(matB1, wsmWords, uint((0 * 6 + kStep) * 128 + 64), 8u, gl_CooperativeMatrixLayoutColumnMajor);
+			matC0_0_lo = coopMatMulAdd(matA,  matB0, matC0_0_lo);
+			matC1_0_lo = coopMatMulAdd(matA1, matB0, matC1_0_lo);
+			matC0_0_hi = coopMatMulAdd(matA,  matB1, matC0_0_hi);
+			matC1_0_hi = coopMatMulAdd(matA1, matB1, matC1_0_hi);
+
+			// Output half h = 1 (oc 16..31)
+			coopMatLoad(matB0, wsmWords, uint((1 * 6 + kStep) * 128 + 0),  8u, gl_CooperativeMatrixLayoutColumnMajor);
+			coopMatLoad(matB1, wsmWords, uint((1 * 6 + kStep) * 128 + 64), 8u, gl_CooperativeMatrixLayoutColumnMajor);
+			matC0_1_lo = coopMatMulAdd(matA,  matB0, matC0_1_lo);
+			matC1_1_lo = coopMatMulAdd(matA1, matB0, matC1_1_lo);
+			matC0_1_hi = coopMatMulAdd(matA,  matB1, matC0_1_hi);
+			matC1_1_hi = coopMatMulAdd(matA1, matB1, matC1_1_hi);
+		}
+		barrier();
+	}
+
+	uvec4 flowScale[8];
+	uvec4 flowBias[8];
+	for (int h = 0; h < 2; ++h)
+	{
+		for (int w = 0; w < 4; ++w)
+		{
+			int ch4 = (n0 * 8 + h * 16) + w * 4;
+			flowScale[h * 4 + w] = uScale.data[uint(ch4 >> 2)];
+			flowBias[h * 4 + w]  = uBias.data[uint(ch4 >> 2)];
+		}
+	}
+
+	// Emit r = 0
+	coopMatStore(matC0_0_lo, sAcc, (sg * 2u + 0u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+	coopMatStore(matC0_0_hi, sAcc, (sg * 2u + 0u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+	coopMatStore(matC0_1_lo, sAcc, (sg * 2u + 1u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+	coopMatStore(matC0_1_hi, sAcc, (sg * 2u + 1u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+	subgroupMemoryBarrierShared();
+	subgroupBarrier();
+	emitFlowRow(0, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, sg, rowSlot, xHalf, lane, flowScale, flowBias);
+	subgroupMemoryBarrierShared();
+	subgroupBarrier();
+
+	// Emit r = 1
+	coopMatStore(matC1_0_lo, sAcc, (sg * 2u + 0u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+	coopMatStore(matC1_0_hi, sAcc, (sg * 2u + 0u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+	coopMatStore(matC1_1_lo, sAcc, (sg * 2u + 1u) * 128u + 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+	coopMatStore(matC1_1_hi, sAcc, (sg * 2u + 1u) * 128u + 8u, 16u, gl_CooperativeMatrixLayoutRowMajor);
+	subgroupMemoryBarrierShared();
+	subgroupBarrier();
+	emitFlowRow(1, n0, X0, Y0, limitW, limitH, lim, posMul, s1, s2, sg, rowSlot, xHalf, lane, flowScale, flowBias);
+#endif
+}
diff --git a/src/vulkan/shaders/xefg_hud_tier.comp b/src/vulkan/shaders/xefg_hud_tier.comp
new file mode 100644
index 0000000..803c367
--- /dev/null
+++ b/src/vulkan/shaders/xefg_hud_tier.comp
@@ -0,0 +1,124 @@
+#version 450
+// 3-Tier Adaptive HUD Protection compute shaders for native Vulkan (VulkanRuntime.cpp).
+// Uses explicit storage-image format qualifiers (COLOR_FMT = rgba8 or rgb10_a2, r8ui for StaticCount)
+// so it requires only shaderStorageImageExtendedFormats (no StorageImageRead/WriteWithoutFormat needed).
+// Compiled by tools/GenerateXeFgCoopMat.py into coopmat/hud/*.spv.
+//
+// Modes (compile-time -DHUD_MODE=...):
+//   0 = Tier 1 Guard (1/16 sampled |Real - Hudless| > Tolerance counter)
+//   1 = Tier 2 Diff Composite (3x3 dilated |Real - Hudless| > Tolerance -> OutColor + optional 1/16 counter)
+//   2 = Tier 3 Static HUD Update (compare CurrReal vs PrevReal -> update r8ui StaticCount + 1/16 counter)
+//   3 = Tier 3 Static HUD Composite (copy CurrReal where StaticCount >= 4 -> OutColor)
+
+#ifndef HUD_MODE
+#define HUD_MODE 0
+#endif
+
+#ifndef COLOR_FMT
+#define COLOR_FMT rgba8
+#endif
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(push_constant) uniform Params {
+    uint Width;
+    uint Height;
+    float Tolerance;
+    uint Flags;
+};
+
+layout(set = 0, binding = 0, COLOR_FMT) uniform readonly image2D TexA;
+
+#if HUD_MODE == 3
+layout(set = 0, binding = 1, r8ui) uniform readonly uimage2D StaticCountIn;
+#else
+layout(set = 0, binding = 1, COLOR_FMT) uniform readonly image2D TexB;
+#endif
+
+#if HUD_MODE == 2
+layout(set = 0, binding = 2, r8ui) uniform uimage2D StaticCountOut;
+#else
+layout(set = 0, binding = 2, COLOR_FMT) uniform writeonly image2D OutColor;
+#endif
+
+layout(set = 0, binding = 3, std430) buffer CounterBuf {
+    uint Counts[4]; // [0] = diffCount (1/16 sample), [1] = staticCount (1/16 sample)
+};
+
+#if HUD_MODE == 0
+void main() {
+    uvec2 id = gl_GlobalInvocationID.xy;
+    if (id.x >= Width || id.y >= Height) return;
+    if ((id.x & 3u) != 0u || (id.y & 3u) != 0u) return;
+
+    ivec2 p = ivec2(id);
+    vec3 d = abs(imageLoad(TexA, p).rgb - imageLoad(TexB, p).rgb);
+    if (max(d.r, max(d.g, d.b)) > Tolerance) {
+        atomicAdd(Counts[0], 1u);
+    }
+}
+#elif HUD_MODE == 1
+bool isHudDiff(ivec2 p) {
+    vec3 d = abs(imageLoad(TexA, p).rgb - imageLoad(TexB, p).rgb);
+    return max(d.r, max(d.g, d.b)) > Tolerance;
+}
+
+void main() {
+    uvec2 id = gl_GlobalInvocationID.xy;
+    if (id.x >= Width || id.y >= Height) return;
+
+    ivec2 maxCoord = ivec2(int(Width) - 1, int(Height) - 1);
+    bool hud = false;
+    for (int dy = -1; dy <= 1; ++dy) {
+        for (int dx = -1; dx <= 1; ++dx) {
+            ivec2 q = clamp(ivec2(id) + ivec2(dx, dy), ivec2(0), maxCoord);
+            hud = hud || isHudDiff(q);
+        }
+    }
+
+    if ((Flags & 1u) != 0u && hud && (id.x & 3u) == 0u && (id.y & 3u) == 0u) {
+        atomicAdd(Counts[0], 1u);
+    }
+
+    if (hud) {
+        ivec2 p = ivec2(id);
+        if ((Flags & 2u) != 0u)
+            imageStore(OutColor, p, vec4(1.0, 0.0, 1.0, 1.0));
+        else
+            imageStore(OutColor, p, imageLoad(TexA, p));
+    }
+}
+#elif HUD_MODE == 2
+void main() {
+    uvec2 id = gl_GlobalInvocationID.xy;
+    if (id.x >= Width || id.y >= Height) return;
+
+    ivec2 p = ivec2(id);
+    uint count = 0u;
+    if ((Flags & 1u) == 0u) {
+        vec3 d = abs(imageLoad(TexA, p).rgb - imageLoad(TexB, p).rgb);
+        bool unchanged = max(d.r, max(d.g, d.b)) <= Tolerance;
+        uint prev = imageLoad(StaticCountOut, p).r;
+        count = unchanged ? min(prev + 1u, 8u) : 0u;
+    }
+
+    imageStore(StaticCountOut, p, uvec4(count, 0u, 0u, 0u));
+
+    if (count >= 4u && (id.x & 3u) == 0u && (id.y & 3u) == 0u) {
+        atomicAdd(Counts[1], 1u);
+    }
+}
+#elif HUD_MODE == 3
+void main() {
+    uvec2 id = gl_GlobalInvocationID.xy;
+    if (id.x >= Width || id.y >= Height) return;
+
+    ivec2 p = ivec2(id);
+    if (imageLoad(StaticCountIn, p).r >= 4u) {
+        if ((Flags & 2u) != 0u)
+            imageStore(OutColor, p, vec4(1.0, 0.0, 1.0, 1.0));
+        else
+            imageStore(OutColor, p, imageLoad(TexA, p));
+    }
+}
+#endif
diff --git a/src/vulkan/shaders/xefg_hud_tonemap.comp b/src/vulkan/shaders/xefg_hud_tonemap.comp
new file mode 100644
index 0000000..4bcc141
--- /dev/null
+++ b/src/vulkan/shaders/xefg_hud_tonemap.comp
@@ -0,0 +1,199 @@
+#version 450
+// Tier 3 Hybrid HUDless Tone-Map Matcher compute shaders for native Vulkan (VulkanRuntime.cpp).
+// Ported from MFG-Unlocker V1.7.2 hudless_match.cpp to give Vulkan 100% parity with DX12 Tier 3 Hybrid.
+// Uses sampler2D + texelFetch for hudless & backBuffer so ANY input format (RGBA8, BGRA8, A2B10G10R10, RGBA16F)
+// works seamlessly without format-combination explosion; only apply writes explicit COLOR_FMT (rgba8 or rgb10_a2).
+//
+// Passes (compile-time -DTM_PASS=0..4):
+//   0 = clear      (zero 3 * 256 * 1024 histogram)
+//   1 = accumulate (1/16 stride 2D histogram per channel: log2(hudless) x backbuffer code)
+//   2 = median     (256-thread groupshared inclusive scan -> per-bin median code)
+//   3 = fill       (5-bin running-median outlier filter + linear fill + monotonic end extrapolation)
+//   4 = apply      (map full HUDless through LUT into OutColor in Backbuffer's format)
+
+#ifndef TM_PASS
+#define TM_PASS 0
+#endif
+
+#ifndef COLOR_FMT
+#define COLOR_FMT rgba8
+#endif
+
+#define STRIDE 4u
+#define OUTLIER (32.0 / 1023.0)
+
+layout(push_constant) uniform MatchParams {
+    uint width;
+    uint height;
+    float logMin;
+    float binsPerOctave;
+    uint bins;
+    uint codes;
+    uint minimumCount;
+    uint unused;
+};
+
+layout(set = 0, binding = 0) uniform sampler2D hudlessTex;
+layout(set = 0, binding = 1) uniform sampler2D backBufferTex;
+layout(set = 0, binding = 2, COLOR_FMT) uniform writeonly image2D outColor;
+layout(set = 0, binding = 3, std430) buffer HistogramBuf {
+    uint hist[];
+};
+layout(set = 0, binding = 4, std430) buffer LutBuf {
+    float lut[];
+};
+
+uint BinOf(float v) {
+    if (!(v > 0.0)) return 0u;
+    return uint(clamp((log2(v) - logMin) * binsPerOctave, 0.0, float(bins - 1u)));
+}
+
+#if TM_PASS == 0
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+void main() {
+    uint idx = gl_GlobalInvocationID.x;
+    if (idx < 3u * bins * codes) {
+        hist[idx] = 0u;
+    }
+}
+
+#elif TM_PASS == 1
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+void main() {
+    uvec2 p = gl_GlobalInvocationID.xy * STRIDE;
+    if (p.x >= width || p.y >= height) return;
+    vec3 h = texelFetch(hudlessTex, ivec2(p), 0).rgb;
+    vec3 b = texelFetch(backBufferTex, ivec2(p), 0).rgb;
+    for (uint c = 0u; c < 3u; ++c) {
+        uint code = uint(clamp(b[c], 0.0, 1.0) * float(codes - 1u) + 0.5);
+        uint bin = BinOf(h[c]);
+        atomicAdd(hist[(c * bins + bin) * codes + code], 1u);
+    }
+}
+
+#elif TM_PASS == 2
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+shared uint partial[256];
+void main() {
+    uint bin = gl_WorkGroupID.x;
+    uint c = gl_WorkGroupID.y;
+    uint gi = gl_LocalInvocationIndex;
+    uint base = (c * bins + bin) * codes + gi * 4u;
+    uint counts[4];
+    uint sum = 0u;
+    for (uint k = 0u; k < 4u; ++k) {
+        counts[k] = hist[base + k];
+        sum += counts[k];
+    }
+    partial[gi] = sum;
+    barrier();
+    for (uint offset = 1u; offset < 256u; offset <<= 1u) {
+        uint v = partial[gi];
+        if (gi >= offset) v += partial[gi - offset];
+        barrier();
+        partial[gi] = v;
+        barrier();
+    }
+    uint total = partial[255];
+    uint before = (gi > 0u) ? partial[gi - 1u] : 0u;
+    uint slot = c * bins + bin;
+    if (total < minimumCount) {
+        if (gi == 0u) lut[slot] = -1.0;
+        return;
+    }
+    uint middle = (total + 1u) / 2u;
+    if (before < middle && partial[gi] >= middle) {
+        uint seen = before;
+        uint code = gi * 4u + 3u;
+        for (uint j = 0u; j < 4u; ++j) {
+            seen += counts[j];
+            if (seen >= middle) {
+                code = gi * 4u + j;
+                break;
+            }
+        }
+        lut[slot] = float(code) / float(codes - 1u);
+    }
+}
+
+#elif TM_PASS == 3
+layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
+void main() {
+    uint c = gl_WorkGroupID.x;
+    uint base = c * bins;
+    float raw[256];
+    float l[256];
+    for (uint r = 0u; r < 256u; ++r) {
+        raw[r] = lut[base + r];
+        l[r] = raw[r];
+    }
+    for (uint k = 0u; k < 256u; ++k) {
+        if (raw[k] < 0.0) continue;
+        float w[5];
+        uint n = 0u;
+        for (int d = -2; d <= 2; ++d) {
+            int j = int(k) + d;
+            if (j >= 0 && j < 256 && raw[j] >= 0.0) {
+                w[n] = raw[j];
+                ++n;
+            }
+        }
+        for (uint a = 1u; a < n; ++a) {
+            float x = w[a];
+            int p = int(a) - 1;
+            while (p >= 0 && w[p] > x) {
+                w[p + 1] = w[p];
+                --p;
+            }
+            w[p + 1] = x;
+        }
+        if (abs(raw[k] - w[n / 2u]) > OUTLIER) {
+            l[k] = w[n / 2u];
+        }
+    }
+    int first = -1;
+    int last = -1;
+    for (uint i = 0u; i < 256u; ++i) {
+        if (l[i] >= 0.0) {
+            if (first < 0) first = int(i);
+            last = int(i);
+        }
+    }
+    if (first < 0) {
+        for (uint z = 0u; z < 256u; ++z) lut[base + z] = 0.0;
+        return;
+    }
+    int previous = first;
+    for (int b = first + 1; b <= last; ++b) {
+        if (l[b] < 0.0) continue;
+        for (int g = previous + 1; g < b; ++g) {
+            l[g] = mix(l[previous], l[b], float(g - previous) / float(b - previous));
+        }
+        previous = b;
+    }
+    int span = min(4, last - first);
+    float headSlope = (span > 0) ? max((l[first + span] - l[first]) / float(span), 0.0) : 0.0;
+    float tailSlope = (span > 0) ? max((l[last] - l[last - span]) / float(span), 0.0) : 0.0;
+    for (int h = 0; h < first; ++h) l[h] = clamp(l[first] - headSlope * float(first - h), 0.0, 1.0);
+    for (int t = last + 1; t < 256; ++t) l[t] = clamp(l[last] + tailSlope * float(t - last), 0.0, 1.0);
+    for (uint o = 0u; o < 256u; ++o) lut[base + o] = l[o];
+}
+
+#elif TM_PASS == 4
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+void main() {
+    uvec2 id = gl_GlobalInvocationID.xy;
+    if (id.x >= width || id.y >= height) return;
+    vec3 h = texelFetch(hudlessTex, ivec2(id), 0).rgb;
+    vec3 o = vec3(0.0);
+    for (uint c = 0u; c < 3u; ++c) {
+        float v = h[c];
+        float f = (v > 0.0) ? ((log2(v) - logMin) * binsPerOctave - 0.5) : 0.0;
+        f = clamp(f, 0.0, float(bins - 1u));
+        uint i = min(uint(f), bins - 2u);
+        float t = clamp(f - float(i), 0.0, 1.0);
+        o[c] = mix(lut[c * bins + i], lut[c * bins + i + 1u], t);
+    }
+    imageStore(outColor, ivec2(id), vec4(o, 1.0));
+}
+#endif
