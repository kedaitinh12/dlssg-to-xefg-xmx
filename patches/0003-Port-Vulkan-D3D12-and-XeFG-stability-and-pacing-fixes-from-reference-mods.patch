index d36f548..ca80873 100644
--- a/tests/vulkan_runtime/policy_test.cpp
+++ b/tests/vulkan_runtime/policy_test.cpp
@@ -437,6 +437,41 @@ int main()
 		pacer.OnBatchStart(200 * ms, 1);
