@@ -629,6 +663,8 @@ namespace VulkanPolicy
 
 			if (skipBatch || generatedCount == 0 || targetStepNs == 0 || nowNs > activeUntilNs)
 			{
+				if (skipBatch && generatedCount > 0 && nowNs <= activeUntilNs)
+					++presentsInBatch;
 				lastPresentNs = nowNs;
 				return 0;
 			}
