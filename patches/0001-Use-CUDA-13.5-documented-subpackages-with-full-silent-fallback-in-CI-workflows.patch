             $candidates = @(
-              @{ Ver = "13.4.3"; Path = "network_installers/cuda_13.4.3_windows_x86_64_network.exe" },
-              @{ Ver = "13.4.2"; Path = "network_installers/cuda_13.4.2_windows_x86_64_network.exe" },
