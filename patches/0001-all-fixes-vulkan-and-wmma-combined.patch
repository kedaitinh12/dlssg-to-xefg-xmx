+				lastPresentNs = nowNs;
+				return 0;
+			}
+
+			uint64_t waitNs = desiredNs - nowNs;
+			const uint64_t capNs = std::min(targetStepNs, MaxWaitNs);
+			if (waitNs > capNs)
