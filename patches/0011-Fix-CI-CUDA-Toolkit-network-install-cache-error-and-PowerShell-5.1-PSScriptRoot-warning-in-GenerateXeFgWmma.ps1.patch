From c269fbc224237c809f2adf30e200e6c969409231 Mon Sep 17 00:00:00 2001
From: dlssg-to-xefg <dev@local>
Date: Sat, 21 Nov 2026 14:13:25 +0000
Subject: [PATCH] Fix CI CUDA Toolkit network install cache error and
 PowerShell 5.1 PSScriptRoot warning in GenerateXeFgWmma.ps1

---
 .github/workflows/build.yml   | 3 +++
 .github/workflows/release.yml | 3 +++
 tools/GenerateXeFgWmma.ps1    | 6 +++++-
 3 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 3c3e97e..d219b28 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -74,7 +74,10 @@ jobs:
         continue-on-error: true
         with:
           cuda: '12.8.1'
+          method: 'network'
           sub-packages: '["nvcc_12.8", "cudart_12.8"]'
+          use-github-cache: false
+          use-local-cache: false
 
       # Rebuild xefg_cuda_layers.fatbin from the optimized src/MfgPort/Cuda/xefg_cuda_layers.cu AFTER
       # GenerateXeFgPrograms.ps1 so the extracted fatbin does not overwrite the newly built sm_120/PTX fatbin.
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 0bb1126..9533146 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -44,7 +44,10 @@ jobs:
         continue-on-error: true
         with:
           cuda: '12.8.1'
+          method: 'network'
           sub-packages: '["nvcc_12.8", "cudart_12.8"]'
+          use-github-cache: false
+          use-local-cache: false
 
       - name: Rebuild CUDA tensor-core fatbin
         id: cuda_rebuild
diff --git a/tools/GenerateXeFgWmma.ps1 b/tools/GenerateXeFgWmma.ps1
index 05b0ff7..055044e 100644
--- a/tools/GenerateXeFgWmma.ps1
+++ b/tools/GenerateXeFgWmma.ps1
@@ -10,13 +10,17 @@ param(
     [Parameter(Mandatory = $true)]
     [string]$Output,
 
-    [string]$Source = (Join-Path $PSScriptRoot "..\src\MfgPort\Wmma\xefg_wmma_layers.hlsl"),
+    [string]$Source = "",
 
     [string]$DxcPath = ""
 )
 
 $ErrorActionPreference = "Stop"
 
+if (-not $Source) {
+    $Source = Join-Path $PSScriptRoot "..\src\MfgPort\Wmma\xefg_wmma_layers.hlsl"
+}
+
 if (-not (Test-Path $Source)) {
     throw "WMMA HLSL shader source not found: $Source"
 }
-- 
2.39.5

