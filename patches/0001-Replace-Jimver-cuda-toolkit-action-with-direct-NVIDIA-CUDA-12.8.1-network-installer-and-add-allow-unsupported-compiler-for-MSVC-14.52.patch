From 25563edf254fb127b816239c5f6075b753ada964 Mon Sep 17 00:00:00 2001
From: dlssg-to-xefg <dev@local>
Date: Sat, 21 Nov 2026 15:19:43 +0000
Subject: [PATCH] Replace Jimver cuda-toolkit action with direct NVIDIA CUDA
 12.8.1 network installer and add allow-unsupported-compiler for MSVC 14.52

---
 .github/workflows/build.yml   | 27 ++++++++++++++++++++-------
 .github/workflows/release.yml | 27 ++++++++++++++++++++-------
 tools/GenerateXeFgCuda.ps1    |  2 +-
 3 files changed, 41 insertions(+), 15 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index d219b28..de0efa5 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -70,14 +70,27 @@ jobs:
       # from the optimized src/MfgPort/Cuda/xefg_cuda_layers.cu (sm_75/86/89/120 + compute_86 PTX).
       - name: Setup CUDA Toolkit (12.8.1 minimal nvcc)
         id: cuda_setup
-        uses: Jimver/cuda-toolkit@v0.2.28
         continue-on-error: true
-        with:
-          cuda: '12.8.1'
-          method: 'network'
-          sub-packages: '["nvcc_12.8", "cudart_12.8"]'
-          use-github-cache: false
-          use-local-cache: false
+        shell: pwsh
+        run: |
+          $cudaDir = "C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.8"
+          if (-not (Test-Path (Join-Path $cudaDir "bin\nvcc.exe"))) {
+            $installer = Join-Path $env:RUNNER_TEMP "cuda_12.8.1_windows_network.exe"
+            Write-Host "Downloading official NVIDIA CUDA 12.8.1 Windows network installer..."
+            Invoke-WebRequest -Uri "https://developer.download.nvidia.com/compute/cuda/12.8.1/network_installers/cuda_12.8.1_windows_network.exe" -OutFile $installer
+            Write-Host "Installing minimal CUDA 12.8.1 components (nvcc_12.8, cudart_12.8)..."
+            $proc = Start-Process -FilePath $installer -ArgumentList "-s", "nvcc_12.8", "cudart_12.8" -Wait -PassThru
+            if ($proc.ExitCode -ne 0) {
+              Write-Warning "CUDA network installer exited with code $($proc.ExitCode)"
+            }
+          }
+          if (Test-Path (Join-Path $cudaDir "bin\nvcc.exe")) {
+            "CUDA_PATH=$cudaDir" >> $env:GITHUB_OUTPUT
+            "CUDA_PATH=$cudaDir" >> $env:GITHUB_ENV
+            Write-Host "CUDA Toolkit 12.8.1 ready at $cudaDir"
+          } else {
+            Write-Warning "nvcc.exe not found at $cudaDir; build will keep the extracted fatbin."
+          }
 
       # Rebuild xefg_cuda_layers.fatbin from the optimized src/MfgPort/Cuda/xefg_cuda_layers.cu AFTER
       # GenerateXeFgPrograms.ps1 so the extracted fatbin does not overwrite the newly built sm_120/PTX fatbin.
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 9533146..a0c487f 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -40,14 +40,27 @@ jobs:
 
       - name: Setup CUDA Toolkit (12.8.1 minimal nvcc)
         id: cuda_setup
-        uses: Jimver/cuda-toolkit@v0.2.28
         continue-on-error: true
-        with:
-          cuda: '12.8.1'
-          method: 'network'
-          sub-packages: '["nvcc_12.8", "cudart_12.8"]'
-          use-github-cache: false
-          use-local-cache: false
+        shell: pwsh
+        run: |
+          $cudaDir = "C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.8"
+          if (-not (Test-Path (Join-Path $cudaDir "bin\nvcc.exe"))) {
+            $installer = Join-Path $env:RUNNER_TEMP "cuda_12.8.1_windows_network.exe"
+            Write-Host "Downloading official NVIDIA CUDA 12.8.1 Windows network installer..."
+            Invoke-WebRequest -Uri "https://developer.download.nvidia.com/compute/cuda/12.8.1/network_installers/cuda_12.8.1_windows_network.exe" -OutFile $installer
+            Write-Host "Installing minimal CUDA 12.8.1 components (nvcc_12.8, cudart_12.8)..."
+            $proc = Start-Process -FilePath $installer -ArgumentList "-s", "nvcc_12.8", "cudart_12.8" -Wait -PassThru
+            if ($proc.ExitCode -ne 0) {
+              Write-Warning "CUDA network installer exited with code $($proc.ExitCode)"
+            }
+          }
+          if (Test-Path (Join-Path $cudaDir "bin\nvcc.exe")) {
+            "CUDA_PATH=$cudaDir" >> $env:GITHUB_OUTPUT
+            "CUDA_PATH=$cudaDir" >> $env:GITHUB_ENV
+            Write-Host "CUDA Toolkit 12.8.1 ready at $cudaDir"
+          } else {
+            Write-Warning "nvcc.exe not found at $cudaDir; build will keep the extracted fatbin."
+          }
 
       - name: Rebuild CUDA tensor-core fatbin
         id: cuda_rebuild
diff --git a/tools/GenerateXeFgCuda.ps1 b/tools/GenerateXeFgCuda.ps1
index e338765..e10db58 100644
--- a/tools/GenerateXeFgCuda.ps1
+++ b/tools/GenerateXeFgCuda.ps1
@@ -91,7 +91,7 @@ $command = 'call "' + $VcVars + '"'
 if ($VcVarsVersion) {
     $command += ' -vcvars_ver=' + $VcVarsVersion
 }
-$command += ' >nul 2>nul && "' + $nvcc + '" -fatbin -O3'
+$command += ' >nul 2>nul && "' + $nvcc + '" -fatbin -O3 -allow-unsupported-compiler'
 foreach ($gencode in $Gencodes) {
     $command += ' -gencode ' + $gencode
 }
-- 
2.39.5

