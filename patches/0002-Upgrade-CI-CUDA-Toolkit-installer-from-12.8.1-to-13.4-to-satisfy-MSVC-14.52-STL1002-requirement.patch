From 68ca35a6a14fc348731395be020904cbc1050a18 Mon Sep 17 00:00:00 2001
From: dlssg-to-xefg <dev@local>
Date: Sat, 21 Nov 2026 15:37:59 +0000
Subject: [PATCH 2/2] Upgrade CI CUDA Toolkit installer from 12.8.1 to 13.4 to
 satisfy MSVC 14.52 STL1002 requirement

---
 .github/workflows/build.yml   | 32 ++++++++++++++++++++++----------
 .github/workflows/release.yml | 32 ++++++++++++++++++++++----------
 2 files changed, 44 insertions(+), 20 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index de0efa5..0a01002 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -68,26 +68,38 @@ jobs:
 
       # Install minimal CUDA Toolkit 12.8.1 (nvcc + cudart only) so CI always builds xefg_cuda_layers.fatbin
       # from the optimized src/MfgPort/Cuda/xefg_cuda_layers.cu (sm_75/86/89/120 + compute_86 PTX).
-      - name: Setup CUDA Toolkit (12.8.1 minimal nvcc)
+      - name: Setup CUDA Toolkit (13.4 minimal nvcc for MSVC 14.52)
         id: cuda_setup
         continue-on-error: true
         shell: pwsh
         run: |
-          $cudaDir = "C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.8"
+          $cudaDir = "C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.4"
           if (-not (Test-Path (Join-Path $cudaDir "bin\nvcc.exe"))) {
-            $installer = Join-Path $env:RUNNER_TEMP "cuda_12.8.1_windows_network.exe"
-            Write-Host "Downloading official NVIDIA CUDA 12.8.1 Windows network installer..."
-            Invoke-WebRequest -Uri "https://developer.download.nvidia.com/compute/cuda/12.8.1/network_installers/cuda_12.8.1_windows_network.exe" -OutFile $installer
-            Write-Host "Installing minimal CUDA 12.8.1 components (nvcc_12.8, cudart_12.8)..."
-            $proc = Start-Process -FilePath $installer -ArgumentList "-s", "nvcc_12.8", "cudart_12.8" -Wait -PassThru
-            if ($proc.ExitCode -ne 0) {
-              Write-Warning "CUDA network installer exited with code $($proc.ExitCode)"
+            $installer = $null
+            foreach ($ver in @("13.4.3", "13.4.2", "13.4.1")) {
+              $url = "https://developer.download.nvidia.com/compute/cuda/$ver/network_installers/cuda_${ver}_windows_network.exe"
+              $cand = Join-Path $env:RUNNER_TEMP "cuda_${ver}_windows_network.exe"
+              try {
+                Write-Host "Trying official NVIDIA CUDA $ver Windows network installer..."
+                Invoke-WebRequest -Uri $url -OutFile $cand -ErrorAction Stop
+                $installer = $cand
+                break
+              } catch {
+                Write-Warning "CUDA $ver download unavailable: $($_.Exception.Message)"
+              }
+            }
+            if ($installer) {
+              Write-Host "Installing minimal CUDA 13.4 components (nvcc_13.4, cudart_13.4)..."
+              $proc = Start-Process -FilePath $installer -ArgumentList "-s", "nvcc_13.4", "cudart_13.4" -Wait -PassThru
+              if ($proc.ExitCode -ne 0) {
+                Write-Warning "CUDA network installer exited with code $($proc.ExitCode)"
+              }
             }
           }
           if (Test-Path (Join-Path $cudaDir "bin\nvcc.exe")) {
             "CUDA_PATH=$cudaDir" >> $env:GITHUB_OUTPUT
             "CUDA_PATH=$cudaDir" >> $env:GITHUB_ENV
-            Write-Host "CUDA Toolkit 12.8.1 ready at $cudaDir"
+            Write-Host "CUDA Toolkit 13.4 ready at $cudaDir"
           } else {
             Write-Warning "nvcc.exe not found at $cudaDir; build will keep the extracted fatbin."
           }
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index a0c487f..2be8c02 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -38,26 +38,38 @@ jobs:
         shell: pwsh
         run: ./tools/GenerateXeFgPrograms.ps1 -Output bin\Release\xefg_mfg_programs -Cache obj\Release\packages
 
-      - name: Setup CUDA Toolkit (12.8.1 minimal nvcc)
+      - name: Setup CUDA Toolkit (13.4 minimal nvcc for MSVC 14.52)
         id: cuda_setup
         continue-on-error: true
         shell: pwsh
         run: |
-          $cudaDir = "C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.8"
+          $cudaDir = "C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.4"
           if (-not (Test-Path (Join-Path $cudaDir "bin\nvcc.exe"))) {
-            $installer = Join-Path $env:RUNNER_TEMP "cuda_12.8.1_windows_network.exe"
-            Write-Host "Downloading official NVIDIA CUDA 12.8.1 Windows network installer..."
-            Invoke-WebRequest -Uri "https://developer.download.nvidia.com/compute/cuda/12.8.1/network_installers/cuda_12.8.1_windows_network.exe" -OutFile $installer
-            Write-Host "Installing minimal CUDA 12.8.1 components (nvcc_12.8, cudart_12.8)..."
-            $proc = Start-Process -FilePath $installer -ArgumentList "-s", "nvcc_12.8", "cudart_12.8" -Wait -PassThru
-            if ($proc.ExitCode -ne 0) {
-              Write-Warning "CUDA network installer exited with code $($proc.ExitCode)"
+            $installer = $null
+            foreach ($ver in @("13.4.3", "13.4.2", "13.4.1")) {
+              $url = "https://developer.download.nvidia.com/compute/cuda/$ver/network_installers/cuda_${ver}_windows_network.exe"
+              $cand = Join-Path $env:RUNNER_TEMP "cuda_${ver}_windows_network.exe"
+              try {
+                Write-Host "Trying official NVIDIA CUDA $ver Windows network installer..."
+                Invoke-WebRequest -Uri $url -OutFile $cand -ErrorAction Stop
+                $installer = $cand
+                break
+              } catch {
+                Write-Warning "CUDA $ver download unavailable: $($_.Exception.Message)"
+              }
+            }
+            if ($installer) {
+              Write-Host "Installing minimal CUDA 13.4 components (nvcc_13.4, cudart_13.4)..."
+              $proc = Start-Process -FilePath $installer -ArgumentList "-s", "nvcc_13.4", "cudart_13.4" -Wait -PassThru
+              if ($proc.ExitCode -ne 0) {
+                Write-Warning "CUDA network installer exited with code $($proc.ExitCode)"
+              }
             }
           }
           if (Test-Path (Join-Path $cudaDir "bin\nvcc.exe")) {
             "CUDA_PATH=$cudaDir" >> $env:GITHUB_OUTPUT
             "CUDA_PATH=$cudaDir" >> $env:GITHUB_ENV
-            Write-Host "CUDA Toolkit 12.8.1 ready at $cudaDir"
+            Write-Host "CUDA Toolkit 13.4 ready at $cudaDir"
           } else {
             Write-Warning "nvcc.exe not found at $cudaDir; build will keep the extracted fatbin."
           }
-- 
