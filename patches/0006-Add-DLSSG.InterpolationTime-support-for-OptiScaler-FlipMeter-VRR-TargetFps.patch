From 1c759cb011067a3e8916a75f812df744fe7b87ab Mon Sep 17 00:00:00 2001
From: dlssg-to-xefg <dev@local>
Date: Sat, 21 Nov 2026 10:05:31 +0000
Subject: [PATCH 06/10] Add DLSSG.InterpolationTime support for OptiScaler
 FlipMeter VRR TargetFps

1. Pattern-scan libxess_fg.dll for the 22-byte interpolation step calculation inside XeFG::Execute and lazily install an executable trampoline overriding xmm7 when DLSSG.InterpolationTime is in (0, 1).

2. Advertise DLSSG.SupportsInterpolationTime in NVSDK_NGX_D3D12_PopulateParameters_Impl when the site is resolved.

3. Read DLSSG.InterpolationTime in FrameGenerator::Evaluate, allow capture calls with null output when interpolationTime > 0, and route fractional timestamps directly through patched XeFG::Execute.
---
 src/Exports.cpp        |   1 +
 src/FrameGenerator.cpp |  39 ++++++++++-----
 src/FrameGenerator.h   |   2 +-
 src/XeFG.cpp           | 106 +++++++++++++++++++++++++++++++++++++++--
 src/XeFG.h             |  11 ++++-
 5 files changed, 140 insertions(+), 19 deletions(-)

diff --git a/src/Exports.cpp b/src/Exports.cpp
index c205b18..f1a23a1 100644
--- a/src/Exports.cpp
+++ b/src/Exports.cpp
@@ -161,6 +161,7 @@ NGX_EXPORT NGXResult NVSDK_NGX_D3D12_PopulateParameters_Impl(NGXParameter* param
 	params->Set("DLSSG.GetCurrentSettingsCallback", reinterpret_cast<void*>(&GetCurrentSettingsCallback));
 	params->Set("DLSSG.EstimateVRAMCallback", reinterpret_cast<void*>(&EstimateVRAMCallback));
 	params->Set("DLSSG.MultiFrameCountMax", (int)FrameGenerator::MaxFrames);
+	params->Set("DLSSG.SupportsInterpolationTime", XeFG::SupportsInterpolationTime() ? 1 : 0);
 
 	return NGX_SUCCESS;
 }
diff --git a/src/FrameGenerator.cpp b/src/FrameGenerator.cpp
index 93c8d64..6a4f974 100644
--- a/src/FrameGenerator.cpp
+++ b/src/FrameGenerator.cpp
@@ -1267,7 +1267,7 @@ void FrameGenerator::CaptureRealFrame(ID3D12GraphicsCommandList* cmdList, const
 }
 
 FrameGenerator::InterpolateResult FrameGenerator::Interpolate(ID3D12GraphicsCommandList* cmdList, ID3D12Resource* output,
-	D3D12_RESOURCE_DESC outputDesc, uint32_t frameIndex, uint32_t frameCount)
+	D3D12_RESOURCE_DESC outputDesc, uint32_t frameIndex, uint32_t frameCount, float interpolationTime)
 {
 	if (!context || !context->pairValid)
 		return InterpolateResult::Skipped;
@@ -1278,7 +1278,10 @@ FrameGenerator::InterpolateResult FrameGenerator::Interpolate(ID3D12GraphicsComm
 		return InterpolateResult::Skipped;
 	}
 
-	const bool useVulkanWmma = UseWmma(settings.model) && D3D12VulkanWmma::Active();
+	const bool customInterpTime = interpolationTime > 0.0f && interpolationTime < 1.0f;
+	// Fractional FlipMeter TargetFps timestamps (DLSSG.InterpolationTime) evaluate one custom-t frame per call
+	// through the patched XeFG::Execute step rather than the fixed-step multi-frame Vulkan batch path.
+	const bool useVulkanWmma = !customInterpTime && UseWmma(settings.model) && D3D12VulkanWmma::Active();
 
 	// Multi-frame batch reuse (D3D12->Vulkan WMMA bridge only): when ScheduleBatch already generated 1..frameCount
 	// at frameIndex == 1 to keep a single D3D12<->Vulkan fence bounce, subsequent calls copy the pre-generated output.
@@ -1382,7 +1385,7 @@ FrameGenerator::InterpolateResult FrameGenerator::Interpolate(ID3D12GraphicsComm
 	else if (UseWmma(settings.model))
 		xefg_wmma::Adopt(cmdList);
 
-	auto result = XeFG::Execute(context->handle, cmdList, params);
+	auto result = XeFG::Execute(context->handle, cmdList, params, interpolationTime);
 
 	if (result == XEFGD_RESULT_SUCCESS)
 	{
@@ -1414,7 +1417,11 @@ NGXResult FrameGenerator::Evaluate(ID3D12GraphicsCommandList* cmdList, const NGX
 	auto output = params.GetOr<ID3D12Resource*>("DLSSG.OutputInterpolated", nullptr);
 	auto outputReal = params.GetOr<ID3D12Resource*>("DLSSG.OutputReal", nullptr);
 
-	if (!backbuffer || !output)
+	float interpolationTime = params.GetOr<float>("DLSSG.InterpolationTime", 0.0f);
+	if (!(interpolationTime > 0.0f && interpolationTime < 1.0f) || !XeFG::SupportsInterpolationTime())
+		interpolationTime = 0.0f;
+
+	if (!backbuffer || (!output && interpolationTime == 0.0f))
 	{
 		Log::Error("Missing backbuffer or output");
 		return NGX_FAIL_INVALID_PARAMETER;
@@ -1433,7 +1440,8 @@ NGXResult FrameGenerator::Evaluate(ID3D12GraphicsCommandList* cmdList, const NGX
 			context->stallCooldownEvaluations = 0;
 		}
 
-		Copy(cmdList, output, OutputState, backbuffer, BackbufferState);
+		if (output)
+			Copy(cmdList, output, OutputState, backbuffer, BackbufferState);
 		return NGX_SUCCESS;
 	}
 
@@ -1463,9 +1471,11 @@ NGXResult FrameGenerator::Evaluate(ID3D12GraphicsCommandList* cmdList, const NGX
 			CurrentNetwork(settings.model), context == nullptr, settings.format == DXGI_FORMAT_R16G16B16A16_FLOAT });
 	}
 
+	const auto targetDesc = (output ? output : backbuffer)->GetDesc();
+
 	// When VRAM guard clamps 3x-6x down to 2x, skip extra generated frames gracefully by showing the real frame
 	const auto result = (frameIndex <= effectiveCount)
-		? Interpolate(cmdList, output, output->GetDesc(), frameIndex, effectiveCount)
+		? Interpolate(cmdList, output, targetDesc, frameIndex, effectiveCount, interpolationTime)
 		: InterpolateResult::Skipped;
 
 	// A few frames after the path or context changed, say whether the hardware matrix route is actually the one running
@@ -1499,14 +1509,17 @@ NGXResult FrameGenerator::Evaluate(ID3D12GraphicsCommandList* cmdList, const NGX
 	}
 
 	// Without a usable pair (first frame, reset) the real frame is shown again, that's not an error
-	if (result == InterpolateResult::Interpolated)
-	{
-		if (!context->directOutput)
-			Copy(cmdList, output, OutputState, context->outputs[frameIndex - 1].Get(), OutputState);
-	}
-	else
+	if (output)
 	{
-		Copy(cmdList, output, OutputState, backbuffer, BackbufferState);
+		if (result == InterpolateResult::Interpolated)
+		{
+			if (!context->directOutput)
+				Copy(cmdList, output, OutputState, context->outputs[frameIndex - 1].Get(), OutputState);
+		}
+		else
+		{
+			Copy(cmdList, output, OutputState, backbuffer, BackbufferState);
+		}
 	}
 
 	return result == InterpolateResult::Failed ? NGX_FAIL : NGX_SUCCESS;
diff --git a/src/FrameGenerator.h b/src/FrameGenerator.h
index 335d777..dcd2cab 100644
--- a/src/FrameGenerator.h
+++ b/src/FrameGenerator.h
@@ -93,7 +93,7 @@ private:
 	bool PollVramGuard() noexcept;
 	void CaptureRealFrame(ID3D12GraphicsCommandList* cmdList, const NGXParameter& params);
 	InterpolateResult Interpolate(ID3D12GraphicsCommandList* cmdList, ID3D12Resource* output,
-		D3D12_RESOURCE_DESC outputDesc, uint32_t frameIndex, uint32_t frameCount);
+		D3D12_RESOURCE_DESC outputDesc, uint32_t frameIndex, uint32_t frameCount, float interpolationTime = 0.0f);
 
 	ComPtr<ID3D12Device> device;
 	Settings settings;
diff --git a/src/XeFG.cpp b/src/XeFG.cpp
index 7f3c37c..c74fab8 100644
--- a/src/XeFG.cpp
+++ b/src/XeFG.cpp
@@ -5,6 +5,7 @@
 #include <algorithm>
 #include <cstdlib>
 #include <cstring>
+#include <mutex>
 #include <vector>
 
 namespace
@@ -32,8 +33,86 @@ namespace
 		// XefgSettings singleton
 		uint8_t* settings = nullptr;
 		const SettingsLayout* layout = nullptr;
+
+		// 22-byte interpolation step calculation inside XeFG::Execute (for DLSSG.InterpolationTime)
+		uint8_t* interpolationTimeSite = nullptr;
+		bool interpolationTimePatched = false;
 	} api;
 
+	struct InterpolationTimeOverride
+	{
+		const void* outputBasesKey = nullptr; // matches [r14 + 0x238] (xefgd_exec_params_t::pOutputBases)
+		float step = 0.0f;                    // interpolationTime / (firstFrameIndex + 1)
+	};
+	static_assert(offsetof(InterpolationTimeOverride, outputBasesKey) == 0);
+	static_assert(offsetof(InterpolationTimeOverride, step) == 8);
+
+	InterpolationTimeOverride gInterpTimeOverride{};
+	std::mutex gInterpTimePatchMutex;
+
+	bool PatchInterpolationTime()
+	{
+		if (api.interpolationTimePatched)
+			return true;
+
+		std::lock_guard lock(gInterpTimePatchMutex);
+		if (api.interpolationTimePatched)
+			return true;
+		if (!api.interpolationTimeSite)
+			return false;
+
+		constexpr size_t kSiteBytes = 0x16; // 22 bytes
+
+		// Trampoline replays the original 1.0f / (numInterpolatedFrames + 1) computation using an immediate 1.0f
+		// (avoiding RIP-relative displacement), then overrides xmm7 if [r14 + 0x238] matches outputBasesKey.
+		std::vector<uint8_t> tramp = {
+			0xFF, 0xC1,                         // inc ecx
+			0x0F, 0x57, 0xC0,                   // xorps xmm0, xmm0
+			0xF3, 0x48, 0x0F, 0x2A, 0xC1,       // cvtsi2ss xmm0, rcx
+			0xB8, 0x00, 0x00, 0x80, 0x3F,       // mov eax, 0x3f800000 (1.0f)
+			0x66, 0x0F, 0x6E, 0xF8,             // movd xmm7, eax
+			0xF3, 0x0F, 0x5E, 0xF8,             // divss xmm7, xmm0
+			0x48, 0xB8,                         // movabs rax, &gInterpTimeOverride
+		};
+		const auto appendU64 = [](std::vector<uint8_t>& buf, uint64_t val) {
+			const auto* bytes = reinterpret_cast<const uint8_t*>(&val);
+			buf.insert(buf.end(), bytes, bytes + sizeof(val));
+		};
+		appendU64(tramp, reinterpret_cast<uint64_t>(&gInterpTimeOverride));
+		const uint8_t tail[] = {
+			0x49, 0x8B, 0x8E, 0x38, 0x02, 0x00, 0x00, // mov rcx, [r14 + 0x238] (params.pOutputBases)
+			0x48, 0x3B, 0x08,                         // cmp rcx, [rax]
+			0x75, 0x05,                               // jne +5
+			0xF3, 0x0F, 0x10, 0x78, 0x08,             // movss xmm7, [rax + 8]
+			0xFF, 0x25, 0x00, 0x00, 0x00, 0x00,       // jmp qword ptr [rip + 0]
+		};
+		tramp.insert(tramp.end(), std::begin(tail), std::end(tail));
+		appendU64(tramp, reinterpret_cast<uint64_t>(api.interpolationTimeSite + kSiteBytes));
+
+		void* mem = VirtualAlloc(nullptr, tramp.size(), MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+		if (!mem)
+			return false;
+		memcpy(mem, tramp.data(), tramp.size());
+
+		std::vector<uint8_t> detour = { 0xFF, 0x25, 0x00, 0x00, 0x00, 0x00 };
+		appendU64(detour, reinterpret_cast<uint64_t>(mem));
+		detour.resize(kSiteBytes, 0x90);
+
+		DWORD oldProtect = 0;
+		if (!VirtualProtect(api.interpolationTimeSite, kSiteBytes, PAGE_EXECUTE_READWRITE, &oldProtect))
+		{
+			VirtualFree(mem, 0, MEM_RELEASE);
+			return false;
+		}
+		memcpy(api.interpolationTimeSite, detour.data(), detour.size());
+		VirtualProtect(api.interpolationTimeSite, kSiteBytes, oldProtect, &oldProtect);
+		FlushInstructionCache(GetCurrentProcess(), api.interpolationTimeSite, kSiteBytes);
+
+		api.interpolationTimePatched = true;
+		Log::Info("Patched XeFG's interpolation time");
+		return true;
+	}
+
 	// Offsets into the XefgSettings singleton
 	struct SettingsLayout
 	{
@@ -374,12 +453,23 @@ bool XeFG::Resolve(HMODULE module)
 		}
 	}
 
+	// Locate the 22-byte interpolation step calculation inside XeFG::Execute for DLSSG.InterpolationTime
+	// (OptiScaler FlipMeter TargetFps + VRR fractional timestamps).
+	if (auto timeHits = FindPattern(image.text,
+			"41 8B 8E 40 02 00 00 44 8B C1 89 4C 24 ?? 41 8B 86 64 02 00 00 85 C0 74 ?? "
+			"41 8B 96 60 02 00 00 89 54 24 ?? 44 8D 04 10 44 89 44 24 ?? "
+			"FF C1 0F 57 C0 F3 48 0F 2A C1 F3 0F 10 3D ?? ?? ?? ?? F3 0F 5E F8");
+		timeHits.size() == 1)
+	{
+		api.interpolationTimeSite = const_cast<uint8_t*>(timeHits[0] + 0x2d);
+	}
+
 	auto rva = [&image](const void* function)
 		{ return function ? static_cast<uint32_t>(static_cast<const uint8_t*>(function) - image.base) : 0; };
 
-	Log::Info("XeFG API ({}): create {:X}, init {:X}, execute {:X}, destroy {:X}, logging {:X}, settings {:X}",
+	Log::Info("XeFG API ({}): create {:X}, init {:X}, execute {:X}, destroy {:X}, logging {:X}, settings {:X}, time {:X}",
 		known ? "known build" : "scanned", rva(api.createContext), rva(api.init), rva(api.execute),
-		rva(api.destroy), rva(api.setLoggingCallback), rva(api.settingsInstance));
+		rva(api.destroy), rva(api.setLoggingCallback), rva(api.settingsInstance), rva(api.interpolationTimeSite));
 
 	return api.createContext && api.init && api.execute && api.destroy && api.settings;
 }
@@ -441,9 +531,19 @@ xefgd_result_t XeFG::Init(xefgd_handle_t context, const xefgd_init_params_t& par
 	return api.init(context, &params);
 }
 
+bool XeFG::SupportsInterpolationTime() { return api.interpolationTimeSite != nullptr; }
+
 xefgd_result_t XeFG::Execute(xefgd_handle_t context, ID3D12GraphicsCommandList* cmdList,
-	const xefgd_exec_params_t& params)
+	const xefgd_exec_params_t& params, float interpolationTime)
 {
+	if (interpolationTime > 0.0f && interpolationTime < 1.0f && PatchInterpolationTime())
+	{
+		gInterpTimeOverride.outputBasesKey = params.pOutputBases;
+		gInterpTimeOverride.step = interpolationTime / static_cast<float>(params.firstFrameIndex + 1);
+		const auto result = api.execute(context, cmdList, &params);
+		gInterpTimeOverride.outputBasesKey = nullptr;
+		return result;
+	}
 	return api.execute(context, cmdList, &params);
 }
 
diff --git a/src/XeFG.h b/src/XeFG.h
index bc1012c..a835dd6 100644
--- a/src/XeFG.h
+++ b/src/XeFG.h
@@ -128,6 +128,7 @@ static_assert(offsetof(xefgd_frame_t, viewMatrix) == 120);
 static_assert(offsetof(xefgd_frame_t, jitterOffset) == 256);
 static_assert(offsetof(xefgd_frame_t, motionVectorScale) == 264);
 static_assert(offsetof(xefgd_exec_params_t, ppOutputs) == 560);
+static_assert(offsetof(xefgd_exec_params_t, pOutputBases) == 568);
 static_assert(offsetof(xefgd_exec_params_t, numInterpolatedFrames) == 576);
 static_assert(offsetof(xefgd_exec_params_t, networkScales) == 580);
 static_assert(offsetof(xefgd_exec_params_t, pDescriptorHeap) == 584);
@@ -178,8 +179,14 @@ namespace XeFG
 
 	xefgd_result_t CreateContext(ID3D12Device* device, xefgd_handle_t* context);
 	void SetLoggingCallback(xefgd_handle_t context, xefgd_logging_level_t level, xefgd_log_callback_t callback);
+	// True when libxess_fg.dll's fixed interpolation-step calculation was located and can be patched for
+	// arbitrary fractional timestamps (DLSSG.InterpolationTime / OptiScaler FlipMeter TargetFps + VRR)
+	bool SupportsInterpolationTime();
+
 	xefgd_result_t Init(xefgd_handle_t context, const xefgd_init_params_t& params);
-	// Leaves XeFG's descriptor heap bound
-	xefgd_result_t Execute(xefgd_handle_t context, ID3D12GraphicsCommandList* cmdList, const xefgd_exec_params_t& params);
+	// Leaves XeFG's descriptor heap bound. When interpolationTime is in (0, 1), overrides XeFG's fixed step
+	// so the generated frame lands at exactly t = interpolationTime between prev and next.
+	xefgd_result_t Execute(xefgd_handle_t context, ID3D12GraphicsCommandList* cmdList, const xefgd_exec_params_t& params,
+		float interpolationTime = 0.0f);
 	xefgd_result_t Destroy(xefgd_handle_t context);
 } // namespace XeFG
