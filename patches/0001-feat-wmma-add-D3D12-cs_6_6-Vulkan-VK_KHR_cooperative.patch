+bool Install(ID3D12Device* device, HMODULE providerModule, const std::filesystem::path& wmmaDir, std::string& reason) noexcept
+{
+    std::lock_guard lock(gMutex);
+    try
+    {
+        const auto current = gState.load(std::memory_order_acquire);
+        if (current == State::Active)
+            return true;
+        if (current != State::NotAttempted)
+        {
+            reason = gReason;
+            return false;
+        }
+        if (!device || !providerModule)
+        {
+            gReason = "no_device";
+            gState.store(State::Unavailable, std::memory_order_release);
+            reason = gReason;
+            return false;
+        }
+
+        wchar_t env[16]{};
+        const DWORD envLen = GetEnvironmentVariableW(L"XEFG_WMMA", env, 16);
+        if (envLen && envLen < 16 && (env[0] == L'0' || _wcsicmp(env, L"off") == 0 || _wcsicmp(env, L"false") == 0))
+        {
+            gReason = "environment_off";
+            gState.store(State::Disabled, std::memory_order_release);
+            reason = gReason;
+            return false;
+        }
+
+        std::string owner;
+        const char* how{};
+        ComPtr<ID3D12Device> native;
+        if (!ResolveNative(device, native, owner, how))
+        {
+            gReason = "wrapped_device";
+            gState.store(State::Unavailable, std::memory_order_release);
+            reason = gReason;
+            return false;
+        }
+        if (native.Get() != device)
+        {
+            HMODULE wrapper{};
+            if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                    static_cast<LPCWSTR>(*reinterpret_cast<void**>(device)), &wrapper) ||
+                !ProviderRange(wrapper, gWrapperBegin, gWrapperEnd))
+            {
+                gReason = "wrapper_image";
+                gState.store(State::Unavailable, std::memory_order_release);
+                reason = gReason;
+                return false;
+            }
+        }
+        device = native.Get();
+        {
+            HMODULE runtime{};
+            if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                    static_cast<LPCWSTR>(*reinterpret_cast<void**>(device)), &runtime) ||
+                !ProviderRange(runtime, gRuntimeBegin, gRuntimeEnd))
+            {
+                gRuntimeBegin = gRuntimeEnd = 0;
+            }
+        }
+
+        const LUID luid = device->GetAdapterLuid();
+        ComPtr<IDXGIFactory4> factory;
+        ComPtr<IDXGIAdapter1> adapter;
+        DXGI_ADAPTER_DESC1 desc{};
+        if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&factory))) ||
+            FAILED(factory->EnumAdapterByLuid(luid, IID_PPV_ARGS(&adapter))) ||
+            FAILED(adapter->GetDesc1(&desc)))
+        {
+            gReason = "adapter_query";
+            gState.store(State::Unavailable, std::memory_order_release);
+            reason = gReason;
+            return false;
+        }
+
+        if (desc.VendorId != 0x1002)
+        {
+            gReason = "not_amd";
+            gState.store(State::Unavailable, std::memory_order_release);
+            reason = gReason;
+            return false;
+        }
+
+        const Arch arch = DetectAmdArch(desc.VendorId, desc.DeviceId, desc.Description);
+        if (arch == Arch::Unknown)
+        {
+            gReason = "architecture_unsupported";
+            gState.store(State::Unavailable, std::memory_order_release);
+            reason = gReason;
+            return false;
+        }
+
+        if (!ProviderRange(providerModule, gProviderBegin, gProviderEnd))
+        {
+            gReason = "provider_image";
+            gState.store(State::Unavailable, std::memory_order_release);
+            reason = gReason;
+            return false;
+        }
+
+        // Query D3D12_FEATURE_D3D12_OPTIONS9 (27) for WaveMMA support when offered by the runtime
+        struct Options9Stub
+        {
+            BOOL MeshShaderPipelineStatsSupported;
+            BOOL MeshShaderSupportsFullRangeRenderTargetArrayIndex;
+            BOOL AtomicInt64OnTypedResourceSupported;
+            BOOL AtomicInt64OnGroupSharedSupported;
+            BOOL DerivativesInMeshAndAmplificationShadersSupported;
+            uint32_t WaveMMATier;
+        } options9{};
+        if (SUCCEEDED(device->CheckFeatureSupport(static_cast<D3D12_FEATURE>(27), &options9, sizeof(options9))))
+            gWaveMmaTier = options9.WaveMMATier;
+
+        ComPtr<IUnknown> identity;
+        if (FAILED(device->QueryInterface(IID_PPV_ARGS(&identity))))
+        {
+            gReason = "device_identity";
+            gState.store(State::Unavailable, std::memory_order_release);
+            reason = gReason;
+            return false;
+        }
+
+        gDeviceId = desc.DeviceId;
+        gArch.store(arch, std::memory_order_release);
+        gOverrideLayers = LoadWmmaOverrides(wmmaDir);
+        gDeviceIdentity = identity.Detach();
+        gDevice = device;
+        gDevice->AddRef();
+
+        std::string patchFailure;
+        if (!PatchDevice(device, patchFailure))
+        {
+            gReason = patchFailure;
+            gState.store(State::Unavailable, std::memory_order_release);
+            reason = gReason;
+            return false;
+        }
+
+        gReason.clear();
+        gActive.store(true, std::memory_order_release);
+        gState.store(State::Active, std::memory_order_release);
+
+        Log("wmma_route",
+            std::string("\"state\":\"active\",\"arch\":\"") + (arch == Arch::Rdna4 ? "rdna4_gfx12" : "rdna3_gfx11") +
+            "\",\"device_id\":" + std::to_string(gDeviceId) +
+            ",\"wave_mma_tier\":" + std::to_string(gWaveMmaTier) +
+            ",\"layers\":" + std::to_string(std::size(xefg_cuda::kLayers)) +
+            ",\"overrides\":" + std::to_string(gOverrideLayers) +
+            ",\"device_vtables\":" + std::to_string(gDevicePatchCount.load()) +
+            ",\"device\":\"" + how + "\"");
+        reason.clear();
+        return true;
+    }
+    catch (...)
+    {
+        gReason = "exception";
+        gState.store(State::Unavailable, std::memory_order_release);
+        reason = gReason;
+        return false;
+    }
+}
+
+void Disable(const char* reason) noexcept
+{
+    std::lock_guard lock(gMutex);
+    if (gState.load(std::memory_order_acquire) != State::NotAttempted)
+        return;
+    try { gReason = reason ? reason : "disabled"; } catch (...) {}
+    gState.store(State::Disabled, std::memory_order_release);
+}
+
+void SetEnabled(bool enabled) noexcept
+{
+    if (gState.load(std::memory_order_acquire) == State::Active && gActive.load(std::memory_order_relaxed) == enabled)
+        return;
+    std::lock_guard lock(gMutex);
+    if (gState.load(std::memory_order_acquire) == State::Active)
+        gActive.store(enabled, std::memory_order_release);
+}
+
+bool Enabled() noexcept
+{
+    return gState.load(std::memory_order_acquire) == State::Active && gActive.load(std::memory_order_acquire);
+}
+
+bool Supported() noexcept
+{
+    return gState.load(std::memory_order_acquire) == State::Active;
+}
+
+bool IsRdna4() noexcept
+{
+    return gArch.load(std::memory_order_acquire) == Arch::Rdna4;
+}
+
+void Adopt(ID3D12GraphicsCommandList* list) noexcept
+{
+    if (!list || gState.load(std::memory_order_acquire) != State::Active)
+        return;
+
+    void** fastTable = *reinterpret_cast<void***>(list);
+    if (const ListTable* record = FindTable(fastTable); record && record->complete.load(std::memory_order_acquire))
+        return;
+
+    try
+    {
+        std::lock_guard lock(gMutex);
+        void** table = *reinterpret_cast<void***>(list);
+        if (const ListTable* record = FindTable(table); record && record->complete.load(std::memory_order_acquire))
+            return;
+
+        const D3D12_COMMAND_LIST_TYPE type = list->GetType();
+        if (type != D3D12_COMMAND_LIST_TYPE_DIRECT && type != D3D12_COMMAND_LIST_TYPE_COMPUTE)
+            return;
+
+        RetireDropped();
+        if (const char* failure = AdoptList(list, type, nullptr))
+        {
+            if (!gExecuteListLogged.exchange(true))
+            {
+                try
+                {
+                    Log("wmma_list_refused", std::string("\"created\":\"execute\",\"reason\":\"") + failure + "\"");
+                }
+                catch (...)
+                {
+                }
+            }
+            return;
+        }
+        const ListTable* record = FindTable(table);
+        const std::string kind = record && record->runtimeClass ? "runtime_class" : record && record->shared ? "shared" : "own";
+        Log("wmma_list", std::string("\"created\":\"execute\",\"type\":\"") +
+            (type == D3D12_COMMAND_LIST_TYPE_COMPUTE ? "compute" : "direct") + "\",\"table\":\"" + kind + "\"");
+    }
+    catch (...)
+    {
+    }
+}
+
+void ForgetLayers() noexcept
+{
+    std::lock_guard lock(gMutex);
+    gAnyLayer.store(false, std::memory_order_release);
+    for (auto& key : gKeys) key.store(nullptr, std::memory_order_release);
+    for (auto& val : gValues) val.store(0, std::memory_order_relaxed);
+    for (auto& rep : gReplacements) rep.store(nullptr, std::memory_order_relaxed);
+    for (const HeldEntry& entry : gHeld)
+    {
+        if (entry.base)
+            entry.base->Release();
+        if (entry.replacement)
+            entry.replacement->Release();
+    }
+    gHeld.clear();
+    gLayerCount.store(0, std::memory_order_relaxed);
+    for (auto& table : gTables)
+        Retire(table);
+}
+
+Status Snapshot() noexcept
+{
+    Status s;
+    std::lock_guard lock(gMutex);
+    s.state = gState.load(std::memory_order_acquire);
+    s.arch = gArch.load(std::memory_order_acquire);
+    s.deviceId = gDeviceId;
+    s.waveMmaTier = gWaveMmaTier;
+    const uint32_t recognized = gLayerCount.load(std::memory_order_relaxed);
+    s.layers = recognized ? recognized : static_cast<uint32_t>(std::size(xefg_cuda::kLayers));
+    s.launches = gLaunches.load(std::memory_order_relaxed);
+    s.fallbacks = gFallbacks.load(std::memory_order_relaxed);
+    s.binds = gBinds.load(std::memory_order_relaxed);
+    try { s.reason = gReason; } catch (...) {}
+    return s;
+}
+} // namespace xefg_wmma
diff --git a/src/MfgPort/Wmma/wmma_route.h b/src/MfgPort/Wmma/wmma_route.h
new file mode 100644
index 0000000..6f42294
--- /dev/null
+++ b/src/MfgPort/Wmma/wmma_route.h
@@ -0,0 +1,41 @@
+#pragma once
+// AMD WMMA INT8 acceleration route for XeFG's ported XMX MFG model (Model 16), built on top of the
+// XMX DP4a INT8 graph (one optical flow field per generated frame batch) for D3D12 and Vulkan.
+#include <d3d12.h>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+
+namespace xefg_wmma
+{
+enum class State : uint8_t { NotAttempted, Disabled, Unavailable, Active };
+enum class Arch : uint8_t { Unknown, Rdna3, Rdna4 };
+
+struct Status
+{
+    State state{State::NotAttempted};
+    Arch arch{Arch::Unknown};
+    uint32_t deviceId{};
+    uint32_t waveMmaTier{};
+    uint32_t layers{};
+    uint64_t launches{};
+    uint64_t fallbacks{};
+    uint64_t binds{};
+    std::string reason;
+};
+
+using LogFunction = void (*)(const char* stage, const std::string& fields);
+void SetLog(LogFunction log) noexcept;
+
+// Installs the D3D12 WMMA INT8 route on an AMD RDNA 3 / RDNA 4 adapter. Loads optional precompiled
+// WaveMatrix/WMMA DXIL overrides from wmmaDir (<program>.dxbc) and tracks the 17 INT8 layers of Model 16.
+bool Install(ID3D12Device* device, HMODULE providerModule, const std::filesystem::path& wmmaDir, std::string& reason) noexcept;
+void Disable(const char* reason) noexcept;
+void SetEnabled(bool enabled) noexcept;
+bool Enabled() noexcept;
+bool Supported() noexcept;
+bool IsRdna4() noexcept;
+void Adopt(ID3D12GraphicsCommandList* list) noexcept;
+void ForgetLayers() noexcept;
+Status Snapshot() noexcept;
+} // namespace xefg_wmma
diff --git a/src/MfgPort/Wmma/xefg_wmma_layers.hlsl b/src/MfgPort/Wmma/xefg_wmma_layers.hlsl
new file mode 100644
index 0000000..796376a
--- /dev/null
+++ b/src/MfgPort/Wmma/xefg_wmma_layers.hlsl
@@ -0,0 +1,529 @@
+// SPDX-License-Identifier: MIT
+//
+// Full 9-tap 3x3 INT8 convolution D3D12 HLSL (Shader Model 6.6) compute shader template for XeFG's
+// 17 ported INT8 layers on AMD RDNA 4 / RDNA 3 (WMMA / dot4add_i8packed).
+//
+// Direct bit-exact port of PoolConv, UpSkip (Decoder), and Flow from src/MfgPort/Cuda/xefg_cuda_layers.cu:
+//   - Root Parameter 0 (Descriptor Table):
+//       t0 : Texture2DArray<uint4> tInput
+//       t4 : Texture2DArray<uint4> tSkip (Decoder LAYER_FAMILY == 1 only)
+//       u0 : RWTexture2DArray<uint2> uOutput (8-ch Flow) or RWTexture2DArray<uint4> uOutput (all others)
+//   - Root Parameter 1 (Descriptor Table):
+//       t1 : Buffer<uint4> tWeights
+//       t2 : Buffer<uint4> tScale (IEEE-754 float scale for Pool/Decoder, int32 bias for Flow)
+//       t3 : Buffer<uint4> tBias  (IEEE-754 float bias for Pool/Decoder, int32 negMul for Flow)
+//   - Root Parameter 2 (32-bit Root Constants b0):
+//       4 constants (1 uint4) for Pool/Decoder; 12 constants (3 uint4) for Flow.
+//
+// Compiled per layer via tools/GenerateXeFgWmma.ps1 with dxc.exe -T cs_6_6 -O3 into
+// xefg_mfg_programs\wmma\<program>.dxbc.
+
+#ifndef LAYER_FAMILY
+#define LAYER_FAMILY 0 // 0 = PoolConv, 1 = UpSkip (Decoder), 2 = Flow
+#endif
+
+#ifndef LAYER_IN
+#define LAYER_IN 1
+#endif
+
+#ifndef LAYER_OUT
+#define LAYER_OUT 1
+#endif
+
+#ifndef LAYER_BIAS
+#define LAYER_BIAS 0
+#endif
+
+#ifndef LAYER_POOL
+#define LAYER_POOL 0
+#endif
+
+#ifndef LAYER_RELU
+#define LAYER_RELU 0
+#endif
+
+#ifndef LAYER_TILE_H
+#define LAYER_TILE_H 16
+#endif
+
+#ifndef LAYER_ZSPLIT
+#define LAYER_ZSPLIT 1
+#endif
+
+#ifndef LAYER_ACC_BITS
+#define LAYER_ACC_BITS 16
+#endif
+
+#ifndef LAYER_NT
+#define LAYER_NT 4
+#endif
+
+Texture2DArray<uint4> tInput   : register(t0);
+Buffer<uint4>         tWeights : register(t1);
+Buffer<uint4>         tScale   : register(t2);
+Buffer<uint4>         tBias    : register(t3);
+#if LAYER_FAMILY == 1
+Texture2DArray<uint4> tSkip    : register(t4);
+#endif
+#if LAYER_FAMILY == 2 && LAYER_OUT == 8
+RWTexture2DArray<uint2> uOutput : register(u0);
+#else
+RWTexture2DArray<uint4> uOutput : register(u0);
+#endif
+
+cbuffer RootConstants : register(b0)
+{
+#if LAYER_FAMILY == 2
+    uint4 cWords[3];
+#else
+    uint4 cWords[1];
+#endif
+};
+
+static const int WIN_W = 18;
+#if LAYER_FAMILY == 0 && LAYER_POOL != 0
+static const int PY = 2;
+#else
+static const int PY = 1;
+#endif
+static const int CONV_H = LAYER_TILE_H * PY;
+static const int WIN_H  = CONV_H + 2;
+static const int WIN    = WIN_W * WIN_H;
+static const int ROWS   = LAYER_TILE_H / 4;
+
+#if LAYER_FAMILY == 2
+groupshared uint4 win[WIN];
+groupshared uint4 wsm[LAYER_NT * 72];
+groupshared uint4 sFlowJoin[4][2][16];
+#else
+static const int ZPER = LAYER_OUT / LAYER_ZSPLIT;
+groupshared uint4 win[LAYER_IN * WIN];
+groupshared uint4 wsm[144];
+#if LAYER_POOL != 0
+groupshared int   sPool[4][16][16];
+#else
+groupshared uint2 sJoin[4][2][16];
+#endif
+#endif
+
+// Zero-bank-conflict XOR weight swizzle within each 16-uint4 tap block (0..143)
+uint SwizzleWeightIdx(uint u)
+{
+    return u ^ ((u & 8u) >> 2u);
+}
+
+int SByte(uint w, uint k)
+{
+    uint shift = k * 8u;
+    int b = int((w >> shift) & 0xFFu);
+    return (b >= 128) ? (b - 256) : b;
+}
+
+int Div16Signed(int v)
+{
+    return (v >= 0) ? (v >> 4) : -((-v) >> 4);
+}
+
+uint4 FetchInput(int x, int y, int slice)
+{
+    uint w, h, d;
+    tInput.GetDimensions(w, h, d);
+    if (x < 0 || y < 0 || slice < 0 || uint(x) >= w || uint(y) >= h || uint(slice) >= d)
+        return uint4(0u, 0u, 0u, 0u);
+    return tInput.Load(int4(x, y, slice, 0));
+}
+
+#if LAYER_FAMILY == 1
+uint4 FetchSkip(int x, int y, int slice)
+{
+    uint w, h, d;
+    tSkip.GetDimensions(w, h, d);
+    if (x < 0 || y < 0 || slice < 0 || uint(x) >= w || uint(y) >= h || uint(slice) >= d)
+        return uint4(0u, 0u, 0u, 0u);
+    return tSkip.Load(int4(x, y, slice, 0));
+}
+
+// Exact port of UpSkipBilinearWord (9*a + 3*b + 3*c + d, Div16 + skip clamped to 0..127)
+uint UpSkipBilinearWord(uint aw, uint bw, uint cw, uint dw, uint sw)
+{
+    uint packed = 0u;
+    [unroll]
+    for (uint k = 0u; k < 4u; ++k)
+    {
+        int dot = 9 * SByte(aw, k) + 3 * (SByte(bw, k) + SByte(cw, k)) + SByte(dw, k);
+        int v = clamp(SByte(sw, k) + Div16Signed(dot), 0, 127);
+        packed |= (uint(v) & 0xFFu) << (k * 8u);
+    }
+    return packed;
+}
+#endif
+
+#if LAYER_FAMILY != 2
+// Exact port of PoolConv / UpSkip Requant: trunc(fma(float(acc), scale, bias)), clamp(lo..127)
+uint RequantFloat(int acc, float s, float b, int lo)
+{
+    int q = int(mad(float(acc), s, b));
+    return uint(clamp(q, lo, 127)) & 0xFFu;
+}
+#else
+// Exact port of Flow requantization from src/MfgPort/Cuda/xefg_cuda_layers.cu lines 533-538
+uint RequantFlow(int a, int ib, int neg, int lim, uint posMul, uint s1, uint s2)
+{
+    int clamped = clamp(a + ib, -lim, lim - 1);
+    uint roundPos = 1u << ((s1 + 31u) & 31u);
+    uint roundNeg = 1u << ((s2 + 31u) & 31u);
+    int pp = int(uint(max(clamped, 0)) * posMul + roundPos) >> int(s1);
+    int nn = int(uint(min(clamped, 0)) * uint(neg) + roundNeg) >> int(s2);
+    return uint(clamp(pp + nn, -128, 127)) & 0xFFu;
+}
+#endif
+
+[numthreads(128, 1, 1)]
+void main(uint3 groupID : SV_GroupID, uint tid : SV_GroupIndex)
+{
+    const uint warp   = tid >> 5u;
+    const uint lane   = tid & 31u;
+    const uint px     = lane & 15u;
+    const uint halfCh = lane >> 4u; // 0 = first 8 channels, 1 = next 8 channels
+
+    uint outW, outH, outD;
+    uOutput.GetDimensions(outW, outH, outD);
+
+#if LAYER_FAMILY != 2
+    // ---- Family 0 (PoolConv) & Family 1 (UpSkip Decoder) ----
+    const int X0     = int(groupID.x) * ((LAYER_POOL != 0) ? 8 : 16);
+    const int Y0     = int(groupID.y) * LAYER_TILE_H;
+    const int limitW = int(outW);
+    const int limitH = int(outH);
+    const int lo     = (LAYER_FAMILY == 1 || LAYER_RELU != 0) ? 0 : -128;
+
+#if LAYER_FAMILY == 0
+    const int cx0 = (LAYER_POOL != 0) ? (2 * X0) : X0;
+    const int cy0 = (LAYER_POOL != 0) ? (2 * Y0) : Y0;
+    for (uint i = tid; i < uint(LAYER_IN * WIN); i += 128u)
+    {
+        int slice = int(i) / WIN;
+        int r     = int(i) % WIN;
+        uint4 v   = FetchInput(cx0 - 1 + (r % WIN_W), cy0 - 1 + (r / WIN_W), slice);
+#if LAYER_BIAS != 0
+        v += uint4(0x80808080u, 0x80808080u, 0x80808080u, 0x80808080u);
+#endif
+        win[i] = v;
+    }
+#else
+    const int Wd = int(cWords[0].x);
+    const int Hd = int(cWords[0].y);
+    for (uint i = tid; i < uint(LAYER_IN * WIN); i += 128u)
+    {
+        int slice = int(i) / WIN;
+        int r     = int(i) % WIN;
+        int x     = X0 - 1 + (r % WIN_W);
+        int y     = Y0 - 1 + (r / WIN_W);
+        uint4 res = uint4(0u, 0u, 0u, 0u);
+        if (x >= 0 && y >= 0 && x < Wd && y < Hd)
+        {
+            int xn = x >> 1;
+            int yn = y >> 1;
+            int xf = ((x & 1) != 0) ? (xn + 1) : (xn - 1);
+            int yf = ((y & 1) != 0) ? (yn + 1) : (yn - 1);
+            uint4 a = FetchInput(xn, yn, slice);
+            uint4 b = FetchInput(xf, yn, slice);
+            uint4 c = FetchInput(xn, yf, slice);
+            uint4 d = FetchInput(xf, yf, slice);
+            uint4 s = FetchSkip(x, y, slice);
+            res = uint4(
+                UpSkipBilinearWord(a.x, b.x, c.x, d.x, s.x),
+                UpSkipBilinearWord(a.y, b.y, c.y, d.y, s.y),
+                UpSkipBilinearWord(a.z, b.z, c.z, d.z, s.z),
+                UpSkipBilinearWord(a.w, b.w, c.w, d.w, s.w));
+        }
+        win[i] = res;
+    }
+#endif
+    GroupMemoryBarrierWithGroupSync();
+
+    const int zBegin = int(groupID.z) * ZPER;
+    for (int z = zBegin; z < zBegin + ZPER; ++z)
+    {
+        int acc[ROWS][PY][8];
+        [unroll]
+        for (int r = 0; r < ROWS; ++r)
+        {
+            [unroll]
+            for (int py = 0; py < PY; ++py)
+            {
+                [unroll]
+                for (int c = 0; c < 8; ++c)
+                    acc[r][py][c] = 0;
+            }
+        }
+
+        for (int slice = 0; slice < LAYER_IN; ++slice)
+        {
+            int block = z * LAYER_IN + slice;
+            for (uint wIdx = tid; wIdx < 144u; wIdx += 128u)
+                wsm[SwizzleWeightIdx(wIdx)] = tWeights.Load(block * 144 + int(wIdx));
+            GroupMemoryBarrierWithGroupSync();
+
+            int sliceBase = slice * WIN;
+            [unroll]
+            for (int tap = 0; tap < 9; ++tap)
+            {
+                int dy = tap / 3;
+                int dx = tap % 3;
+                [unroll]
+                for (int w = 0; w < 4; ++w)
+                {
+                    uint s0 = halfCh * 2u + 0u;
+                    uint s1 = halfCh * 2u + 1u;
+                    uint4 wv0 = wsm[SwizzleWeightIdx(uint(tap * 16 + w * 4) + s0)];
+                    uint4 wv1 = wsm[SwizzleWeightIdx(uint(tap * 16 + w * 4) + s1)];
+                    uint b[8] = { wv0.x, wv0.y, wv0.z, wv0.w, wv1.x, wv1.y, wv1.z, wv1.w };
+
+                    [unroll]
+                    for (int r = 0; r < ROWS; ++r)
+                    {
+                        int yl = int(warp) + r * 4;
+                        [unroll]
+                        for (int py = 0; py < PY; ++py)
+                        {
+                            int rowY = (PY > 1) ? (2 * yl + py) : yl;
+                            uint4 av = win[sliceBase + (rowY + dy) * WIN_W + int(px) + dx];
+                            uint a = (w == 0) ? av.x : ((w == 1) ? av.y : ((w == 2) ? av.z : av.w));
+                            [unroll]
+                            for (int c = 0; c < 8; ++c)
+                                acc[r][py][c] = dot4add_i8packed(a, b[c], acc[r][py][c]);
+                        }
+                    }
+                }
+            }
+            GroupMemoryBarrierWithGroupSync();
+        }
+
+        float s[16];
+        float bi[16];
+        [unroll]
+        for (int w = 0; w < 4; ++w)
+        {
+            uint4 sv = tScale.Load(z * 4 + w);
+            uint4 bv = tBias.Load(z * 4 + w);
+            s[w * 4 + 0]  = asfloat(sv.x);
+            s[w * 4 + 1]  = asfloat(sv.y);
+            s[w * 4 + 2]  = asfloat(sv.z);
+            s[w * 4 + 3]  = asfloat(sv.w);
+            bi[w * 4 + 0] = asfloat(bv.x);
+            bi[w * 4 + 1] = asfloat(bv.y);
+            bi[w * 4 + 2] = asfloat(bv.z);
+            bi[w * 4 + 3] = asfloat(bv.w);
+        }
+
+        [unroll]
+        for (int r = 0; r < ROWS; ++r)
+        {
+            int Y = Y0 + int(warp) + r * 4;
+#if LAYER_POOL != 0
+            [unroll]
+            for (int c = 0; c < 8; ++c)
+                sPool[warp][px][halfCh * 8u + uint(c)] = max(acc[r][0][c], acc[r][1][c]);
+            GroupMemoryBarrierWithGroupSync();
+
+            if (halfCh == 0u && px < 8u && Y < limitH)
+            {
+                int X = X0 + int(px);
+                if (X < limitW)
+                {
+                    uint words[4];
+                    [unroll]
+                    for (int w = 0; w < 4; ++w)
+                    {
+                        uint packed = 0u;
+                        [unroll]
+                        for (int c = 0; c < 4; ++c)
+                        {
+                            int oc = w * 4 + c;
+                            int m = max(sPool[warp][2u * px][oc], sPool[warp][2u * px + 1u][oc]);
+                            packed |= RequantFloat(m, s[oc], bi[oc], lo) << uint(c * 8);
+                        }
+                        words[w] = packed;
+                    }
+                    uOutput[uint3(uint(X), uint(Y), uint(z))] = uint4(words[0], words[1], words[2], words[3]);
+                }
+            }
+            GroupMemoryBarrierWithGroupSync();
+#else
+            uint2 halfWords = uint2(0u, 0u);
+            [unroll]
+            for (int w = 0; w < 2; ++w)
+            {
+                uint packed = 0u;
+                [unroll]
+                for (int c = 0; c < 4; ++c)
+                {
+                    int localC = w * 4 + c;
+                    int oc = int(halfCh) * 8 + localC;
+                    packed |= RequantFloat(acc[r][0][localC], s[oc], bi[oc], lo) << uint(c * 8);
+                }
+                if (w == 0) halfWords.x = packed;
+                else        halfWords.y = packed;
+            }
+            sJoin[warp][halfCh][px] = halfWords;
+            GroupMemoryBarrierWithGroupSync();
+
+            if (halfCh == 0u && Y < limitH)
+            {
+                int X = X0 + int(px);
+                if (X < limitW)
+                {
+                    uint2 lo2 = sJoin[warp][0][px];
+                    uint2 hi2 = sJoin[warp][1][px];
+                    uOutput[uint3(uint(X), uint(Y), uint(z))] = uint4(lo2.x, lo2.y, hi2.x, hi2.y);
+                }
+            }
+            GroupMemoryBarrierWithGroupSync();
+#endif
+        }
+    }
+
+#else
+    // ---- Family 2 (Flow: NIT = LAYER_IN, NOUT = LAYER_OUT, TILE_H = 8, NT = 4) ----
+    const int  Wd     = int(cWords[0].z);
+    const int  Hd     = int(cWords[0].w);
+    const int  Wout   = int(cWords[1].x);
+    const int  Hout   = int(cWords[1].y);
+    const uint posMul = cWords[2].y;
+    const uint shifts = cWords[2].z;
+    const uint s1     = shifts & 31u;
+    const uint s2     = (shifts >> 8u) & 31u;
+    const int  lim    = 1 << LAYER_ACC_BITS;
+    const int  X0     = int(groupID.x) * 16;
+    const int  Y0     = int(groupID.y) * LAYER_TILE_H;
+    const int  n0     = int(groupID.z) * LAYER_NT;
+    const int  limitW = min(int(outW), Wout);
+    const int  limitH = min(int(outH), Hout);
+
+    // Each thread accumulates 16 output channels: halfCh == 0 covers tiles nt = 0,1; halfCh == 1 covers tiles nt = 2,3
+    int acc[ROWS][16];
+    [unroll]
+    for (int r = 0; r < ROWS; ++r)
+    {
+        [unroll]
+        for (int c = 0; c < 16; ++c)
+            acc[r][c] = 0;
+    }
+
+    for (int step = 0; step < LAYER_IN; ++step)
+    {
+        for (uint e = tid; e < uint(WIN); e += 128u)
+        {
+            int x  = X0 - 1 + (int(e) % WIN_W);
+            int ys = Y0 + (int(e) / WIN_W);
+            uint4 v = uint4(0u, 0u, 0u, 0u);
+            if (x >= 0 && x < Wd && ys >= 1 && ys <= Hd)
+            {
+#if LAYER_OUT == 8
+                uint4 a = FetchInput(x, ys, 2 * step);
+                uint4 b = FetchInput(x, ys, 2 * step + 1);
+                v = uint4(a.x, a.y, b.x, b.y);
+#else
+                v = FetchInput(x, ys, step);
+#endif
+            }
+            win[e] = v;
+        }
+
+        for (uint wIdx = tid; wIdx < uint(LAYER_NT * 72); wIdx += 128u)
+        {
+            int nt    = int(wIdx) / 72;
+            int group = (int(wIdx) % 72) / 36;
+            int k     = int(wIdx) % 36;
+            int ch    = (n0 + nt) * 8;
+            int z     = ch / LAYER_OUT;
+            int c     = ch % LAYER_OUT;
+            int idx   = ((z * LAYER_IN + step) * (LAYER_OUT / 4) + (c / 4) + group) * 36 + k;
+            wsm[wIdx] = tWeights.Load(idx);
+        }
+        GroupMemoryBarrierWithGroupSync();
+
+        [unroll]
+        for (int tap = 0; tap < 9; ++tap)
+        {
+            int dy = tap / 3;
+            int dx = tap % 3;
+            [unroll]
+            for (int w = 0; w < 4; ++w)
+            {
+                int k = tap * 4 + w;
+                uint basent = halfCh * 2u;
+                uint4 wv0 = wsm[(basent + 0u) * 72u + 0u * 36u + uint(k)];
+                uint4 wv1 = wsm[(basent + 0u) * 72u + 1u * 36u + uint(k)];
+                uint4 wv2 = wsm[(basent + 1u) * 72u + 0u * 36u + uint(k)];
+                uint4 wv3 = wsm[(basent + 1u) * 72u + 1u * 36u + uint(k)];
+                uint b[16] = {
+                    wv0.x, wv0.y, wv0.z, wv0.w,
+                    wv1.x, wv1.y, wv1.z, wv1.w,
+                    wv2.x, wv2.y, wv2.z, wv2.w,
+                    wv3.x, wv3.y, wv3.z, wv3.w
+                };
+
+                [unroll]
+                for (int r = 0; r < ROWS; ++r)
+                {
+                    int yl = int(warp) + r * 4;
+                    uint4 av = win[(yl + dy) * WIN_W + int(px) + dx];
+                    uint a = (w == 0) ? av.x : ((w == 1) ? av.y : ((w == 2) ? av.z : av.w));
+                    [unroll]
+                    for (int c = 0; c < 16; ++c)
+                        acc[r][c] = dot4add_i8packed(a, b[c], acc[r][c]);
+                }
+            }
+        }
+        GroupMemoryBarrierWithGroupSync();
+    }
+
+    [unroll]
+    for (int r = 0; r < ROWS; ++r)
+    {
+        uint4 halfWords = uint4(0u, 0u, 0u, 0u);
+        [unroll]
+        for (int w = 0; w < 4; ++w)
+        {
+            int ch4 = (n0 * 8 + int(halfCh) * 16) + w * 4;
+            uint4 bv = tScale.Load(ch4 >> 2);
+            uint4 nv = tBias.Load(ch4 >> 2);
+            int ib[4] = { int(bv.x), int(bv.y), int(bv.z), int(bv.w) };
+            int ng[4] = { int(nv.x), int(nv.y), int(nv.z), int(nv.w) };
+            uint packed = 0u;
+            [unroll]
+            for (int c = 0; c < 4; ++c)
+            {
+                int a = acc[r][w * 4 + c];
+                packed |= RequantFlow(a, ib[c], ng[c], lim, posMul, s1, s2) << uint(c * 8);
+            }
+            if (w == 0)      halfWords.x = packed;
+            else if (w == 1) halfWords.y = packed;
+            else if (w == 2) halfWords.z = packed;
+            else             halfWords.w = packed;
+        }
+        sFlowJoin[warp][halfCh][px] = halfWords;
+        GroupMemoryBarrierWithGroupSync();
+
+        int y = Y0 + int(warp) + r * 4;
+        int x = X0 + int(px);
+        if (halfCh == 0u && x < limitW && y < limitH)
+        {
+            uint4 lo4 = sFlowJoin[warp][0][px];
+            uint4 hi4 = sFlowJoin[warp][1][px];
+#if LAYER_OUT == 8
+            uOutput[uint3(uint(x), uint(y + 1), uint(n0 + 0))] = lo4.xy;
+            uOutput[uint3(uint(x), uint(y + 1), uint(n0 + 1))] = lo4.zw;
+            uOutput[uint3(uint(x), uint(y + 1), uint(n0 + 2))] = hi4.xy;
+            uOutput[uint3(uint(x), uint(y + 1), uint(n0 + 3))] = hi4.zw;
+#else
+            uOutput[uint3(uint(x), uint(y + 1), uint((n0 / 2) + 0))] = lo4;
+            uOutput[uint3(uint(x), uint(y + 1), uint((n0 / 2) + 1))] = hi4;
+#endif
+        }
+        GroupMemoryBarrierWithGroupSync();
+    }
+#endif
+}
