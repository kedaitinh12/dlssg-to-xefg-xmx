+	Microsoft::WRL::ComPtr<ID3D12PipelineState> psoHybridComposite_;
 
 	Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> srvUavHeap_;
 	uint32_t descSize_ = 0;
