 		// Camera Cut & Teleport Detector state (prevents smearing on sudden cuts/teleports)
 		float prevCameraPos[3]{};
diff --git a/src/MfgPort/Wmma/wmma_route.cpp b/src/MfgPort/Wmma/wmma_route.cpp
