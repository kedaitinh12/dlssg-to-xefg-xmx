-        gBinds.fetch_add(1, std::memory_order_relaxed);
     ListOriginal<SetPipelineStateFn>(self, kSetPipelineState)(self, state);
 }
 
@@ -494,8 +506,10 @@ void Fallback(Reason reason, const char* text, const xefg_cuda::Layer& layer) no
 
