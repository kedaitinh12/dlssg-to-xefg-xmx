 		return std::string(reason);
 	}
 
+	// XEFG_VK_SWAPCHAIN_BUFFERS: target minimum swapchain image count for Multi-Frame Generation swapchains
+	// (requested >= 6, e.g. Streamline's 6-buffer Vulkan swapchain). Raising 6 -> 8 allows 4x MFG (4 frames/batch)
+	// to double-buffer cleanly (8 / 4 = 2) instead of hitting wrap-around phase stalls every alternating batch.
+	// Empty or invalid falls back to defaultTarget (8); 0/off/false disables boosting; valid explicit values are 6..12.
+	inline uint32_t ParseSwapchainBufferTarget(std::wstring_view value, uint32_t defaultTarget = 8u) noexcept
+	{
+		while (!value.empty() && (value.front() == L' ' || value.front() == L'\t'))
+			value.remove_prefix(1);
+		while (!value.empty() && (value.back() == L' ' || value.back() == L'\t'))
+			value.remove_suffix(1);
+		if (value.empty())
+			return defaultTarget;
+		if (IsOffWord(value))
+			return 0u;
+		uint32_t parsed = 0;
+		for (const wchar_t c : value)
+		{
+			if (c < L'0' || c > L'9')
+				return defaultTarget;
+			parsed = parsed * 10u + static_cast<uint32_t>(c - L'0');
+			if (parsed > 12u)
+				return defaultTarget;
+		}
+		return (parsed >= 6u && parsed <= 12u) ? parsed : defaultTarget;
+	}
+
+	// Computes the safe boosted swapchain minImageCount within surface capabilities (capMax == 0 means unbounded).
+	// Only boosts MFG-sized swapchains (requested >= 6) so non-FG or 2-3 buffer game swapchains stay untouched.
+	inline uint32_t RecommendSwapchainImageCount(uint32_t requested, uint32_t capMin, uint32_t capMax,
+		uint32_t targetMin = 8u) noexcept
+	{
+		if (targetMin < 6u || requested < 6u || requested >= targetMin)
+			return requested;
+		uint32_t desired = std::clamp<uint32_t>(targetMin, 6u, 12u);
+		if (capMax > 0u && desired > capMax)
+			desired = capMax;
+		if (desired < capMin)
+			desired = capMin;
+		return desired > requested ? desired : requested;
+	}
+
 	// CPU-side Vulkan present pacer for recorded-mode Multi-Frame Generation (e.g. Streamline/OptiScaler on GPUs
 	// without hardware flip metering and with V-Sync FIFO off).
 	// Tracks real-frame batch cadence with a 5-sample median-filtered EMA (rejecting single-frame asset-streaming
diff --git a/tests/vulkan_runtime/policy_test.cpp b/tests/vulkan_runtime/policy_test.cpp
index 14d87c9..459b6c7 100644
--- a/tests/vulkan_runtime/policy_test.cpp
+++ b/tests/vulkan_runtime/policy_test.cpp
@@ -497,6 +497,40 @@ int main()
 		CHECK(!mfg6.skipBatch);
 	}
 
+	// ---- Vulkan MFG swapchain image count policy (6 -> 8 double-buffered 4x MFG)
+	{
+		using VulkanPolicy::ParseSwapchainBufferTarget;
+		using VulkanPolicy::RecommendSwapchainImageCount;
+
+		CHECK(ParseSwapchainBufferTarget(L"") == 8u);
+		CHECK(ParseSwapchainBufferTarget(L"  ") == 8u);
+		CHECK(ParseSwapchainBufferTarget(L"0") == 0u);
+		CHECK(ParseSwapchainBufferTarget(L"off") == 0u);
+		CHECK(ParseSwapchainBufferTarget(L"FALSE") == 0u);
+		CHECK(ParseSwapchainBufferTarget(L"6") == 6u);
+		CHECK(ParseSwapchainBufferTarget(L"8") == 8u);
+		CHECK(ParseSwapchainBufferTarget(L"10") == 10u);
+		CHECK(ParseSwapchainBufferTarget(L"12") == 12u);
+		CHECK(ParseSwapchainBufferTarget(L"5") == 8u);
+		CHECK(ParseSwapchainBufferTarget(L"16") == 8u);
+		CHECK(ParseSwapchainBufferTarget(L"abc") == 8u);
+
+		// Standard Streamline 6-buffer swapchain boosted to 8 when driver allows (capMax == 0 unbounded or >= 8)
+		CHECK(RecommendSwapchainImageCount(6u, 2u, 0u, 8u) == 8u);
+		CHECK(RecommendSwapchainImageCount(6u, 2u, 8u, 8u) == 8u);
+		CHECK(RecommendSwapchainImageCount(6u, 2u, 16u, 8u) == 8u);
+		// Clamped to driver maxImageCount
+		CHECK(RecommendSwapchainImageCount(6u, 2u, 7u, 8u) == 7u);
+		CHECK(RecommendSwapchainImageCount(6u, 2u, 6u, 8u) == 6u);
+		// Non-MFG game swapchains (< 6 buffers) are never touched
+		CHECK(RecommendSwapchainImageCount(3u, 2u, 8u, 8u) == 3u);
+		CHECK(RecommendSwapchainImageCount(4u, 2u, 8u, 8u) == 4u);
+		// Disabled or already >= target
+		CHECK(RecommendSwapchainImageCount(6u, 2u, 8u, 0u) == 6u);
+		CHECK(RecommendSwapchainImageCount(8u, 2u, 16u, 8u) == 8u);
+		CHECK(RecommendSwapchainImageCount(10u, 2u, 16u, 8u) == 10u);
+	}
+
 	std::printf("%d checks, %d failed\n", checks, failures);
 	return failures ? 1 : 0;
 }
